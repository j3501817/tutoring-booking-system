@using System.Security.Claims
@inject PlatoTutoring.Web.Data.AppDbContext DbContext
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var displayName = User.FindFirstValue("DisplayName") ?? User.Identity?.Name ?? "訪客體驗模式";
    var role = User.FindFirstValue(ClaimTypes.Role) ?? "";
    var isProxyAdmin = User.FindFirstValue("IsProxyAdmin") == "true";

    if (isAuthenticated && int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var currentUserId))
    {
        try
        {
            var dbUser = DbContext.Users.Find(currentUserId);
            if (dbUser != null)
            {
                displayName = dbUser.DisplayName;
                role = dbUser.Role.ToString();
                isProxyAdmin = dbUser.IsProxyAdmin;
            }
        }
        catch
        {
            // 若資料庫連線尚未初始化完成則沿用 Cookie Claim
        }
    }

    var roleLabel = role switch
    {
        "Parent" => "家長授權",
        "Teacher" => isProxyAdmin ? "授課老師（代理管理）" : "授課老師",
        "Admin" => "系統管理員",
        _ => "未登入"
    };

    // 依照登入角色權限決定顯示的左側功能項目
    var canAccessOverview = isAuthenticated && role == "Admin";
    var canAccessParent = isAuthenticated && (role == "Parent" || role == "Admin");
    var canAccessTeacher = isAuthenticated && (role == "Teacher" || role == "Admin");
    var canAccessMembers = isAuthenticated && (role == "Teacher" || role == "Admin");
    var canAccessAdmin = isAuthenticated && (role == "Admin" || (role == "Teacher" && isProxyAdmin));
    var canAccessSystemAdmin = isAuthenticated && (role == "Admin" || (role == "Teacher" && isProxyAdmin));

    var roleHomePage = role switch
    {
        "Parent" => "/Parent/Index",
        "Teacher" => "/Teacher/Index",
        "Admin" => "/Index",
        _ => "/Account/Login"
    };

    var currentPath = Context.Request.Path.Value ?? "/";
    bool IsActive(string prefix) =>
        prefix == "/"
            ? string.Equals(currentPath, "/", StringComparison.OrdinalIgnoreCase) || string.Equals(currentPath, "/Index", StringComparison.OrdinalIgnoreCase)
            : currentPath.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 柏拉圖文理補習班 輔導預約系統</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- 行動裝置頂部導覽列 (< 992px 顯示，點擊開啟左側抽屜功能列) -->
    <header class="app-topbar-mobile d-lg-none py-2 px-3 sticky-top">
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-outline-light px-2" type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#mobileSidebarDrawer"
                        aria-controls="mobileSidebarDrawer" aria-label="開啟左側功能選單">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <a class="text-white text-decoration-none fw-bold d-flex align-items-center gap-2" asp-page="@roleHomePage">
                    <span class="sidebar-brand-mark" style="width: 30px; height: 30px;">
                        <img src="~/images/plato-logo.png" alt="柏拉圖校徽" />
                    </span>
                    <span>柏拉圖輔導預約</span>
                </a>
            </div>
            <span class="badge bg-warning text-dark">@roleLabel</span>
        </div>
    </header>

    <div class="app-shell">
        <!-- 桌機固定左側功能列 (>= 992px) -->
        <aside class="app-sidebar d-none d-lg-flex" aria-label="主要功能選單">
            <a class="sidebar-brand" asp-page="@roleHomePage">
                <div class="d-flex align-items-center gap-3">
                    <span class="sidebar-brand-mark">
                        <img src="~/images/plato-logo.png" alt="柏拉圖校徽" />
                    </span>
                    <div>
                        <div class="fw-bold fs-6 lh-sm">柏拉圖文理補習班</div>
                        <div class="small text-white-50" style="font-size: 0.76rem;">輔導預約與堂數管理系統</div>
                    </div>
                </div>
            </a>

            <div class="sidebar-section-label">可用功能選單</div>
            <ul class="sidebar-nav">
                @if (canAccessOverview)
                {
                    <li class="sidebar-nav-item">
                        <a class="sidebar-nav-link @(IsActive("/") ? "active" : "")" asp-page="/Index">
                            <i class="bi bi-grid-1x2-fill"></i>
                            <span>系統總覽儀表板</span>
                        </a>
                    </li>
                }

                @if (canAccessParent)
                {
                    <li class="sidebar-nav-item">
                        <a class="sidebar-nav-link @(IsActive("/Parent") ? "active" : "")" asp-page="/Parent/Index">
                            <i class="bi bi-calendar2-check-fill"></i>
                            <span>家長預約與堂數</span>
                        </a>
                        @if (IsActive("/Parent"))
                        {
                            <ul class="sidebar-subnav">
                                <li><a class="sidebar-subnav-link" href="#tab-parent-book" onclick="activateWorkspaceTab('tab-parent-book')"><i class="bi bi-calendar-week"></i>線上預約時段</a></li>
                                <li><a class="sidebar-subnav-link" href="#tab-parent-records" onclick="activateWorkspaceTab('tab-parent-records')"><i class="bi bi-list-check"></i>我的預約與候補</a></li>
                                <li><a class="sidebar-subnav-link" href="#tab-parent-ledger" onclick="activateWorkspaceTab('tab-parent-ledger')"><i class="bi bi-journal-text"></i>堂數異動流水帳</a></li>
                            </ul>
                        }
                    </li>
                }

                @if (canAccessTeacher)
                {
                    <li class="sidebar-nav-item">
                        <a class="sidebar-nav-link @(IsActive("/Teacher") ? "active" : "")" asp-page="/Teacher/Index">
                            <i class="bi bi-journal-check"></i>
                            <span>老師教務與儲值</span>
                        </a>
                        @if (IsActive("/Teacher"))
                        {
                            <ul class="sidebar-subnav">
                                <li><a class="sidebar-subnav-link" href="#tab-teacher-rollcall" onclick="activateWorkspaceTab('tab-teacher-rollcall')"><i class="bi bi-person-check"></i>今日課堂點名</a></li>
                                <li><a class="sidebar-subnav-link" href="#tab-teacher-topup" onclick="activateWorkspaceTab('tab-teacher-topup')"><i class="bi bi-cash-coin"></i>儲值與堂數調整</a></li>
                                <li><a class="sidebar-subnav-link" href="#tab-teacher-slots" onclick="activateWorkspaceTab('tab-teacher-slots')"><i class="bi bi-calendar-plus"></i>時段排課與代約</a></li>
                                <li><a class="sidebar-subnav-link" href="#tab-teacher-homework" onclick="activateWorkspaceTab('tab-teacher-homework')"><i class="bi bi-bell"></i>作業追蹤與催促</a></li>
                            </ul>
                        }
                    </li>
                }

                @if (canAccessMembers)
                {
                    <li class="sidebar-nav-item">
                        <a class="sidebar-nav-link @(IsActive("/Members") ? "active" : "")" asp-page="/Members/Index">
                            <i class="bi bi-people-fill"></i>
                            <span>學生 / 家長 / 老師管理</span>
                        </a>
                        @if (IsActive("/Members"))
                        {
                            <ul class="sidebar-subnav">
                                <li><a class="sidebar-subnav-link" href="#tab-student-parent" onclick="activateWorkspaceTab('tab-student-parent')"><i class="bi bi-mortarboard"></i>學生與家長管理</a></li>
                                <li><a class="sidebar-subnav-link" href="#tab-teachers" onclick="activateWorkspaceTab('tab-teachers')"><i class="bi bi-easel2"></i>老師管理</a></li>
                            </ul>
                        }
                    </li>
                }

                @if (canAccessAdmin)
                {
                    <li class="sidebar-nav-item">
                        <a class="sidebar-nav-link @(IsActive("/Admin") ? "active" : "")" asp-page="/Admin/Index">
                            <i class="bi bi-bar-chart-line-fill"></i>
                            <span>管理員營運與報表</span>
                        </a>
                        @if (IsActive("/Admin"))
                        {
                            <ul class="sidebar-subnav">
                                <li><a class="sidebar-subnav-link" href="#tab-admin-accounts" onclick="activateWorkspaceTab('tab-admin-accounts')"><i class="bi bi-shield-lock"></i>帳號與學生綁定</a></li>
                                <li><a class="sidebar-subnav-link" href="#tab-admin-semester" onclick="activateWorkspaceTab('tab-admin-semester')"><i class="bi bi-calendar-range"></i>學期與每週進度</a></li>
                                <li><a class="sidebar-subnav-link" href="#tab-admin-students" onclick="activateWorkspaceTab('tab-admin-students')"><i class="bi bi-person-plus"></i>學生與到班目的</a></li>
                                <li><a class="sidebar-subnav-link" href="#tab-admin-dropout" onclick="activateWorkspaceTab('tab-admin-dropout')"><i class="bi bi-calculator"></i>退班批次結算</a></li>
                                <li><a class="sidebar-subnav-link" href="#tab-admin-audit" onclick="activateWorkspaceTab('tab-admin-audit')"><i class="bi bi-journal-code"></i>流水帳與 LINE 稽核</a></li>
                            </ul>
                        }
                    </li>
                }

                @if (canAccessSystemAdmin)
                {
                    <li class="sidebar-nav-item">
                        <a class="sidebar-nav-link @(IsActive("/SystemAdmin") ? "active" : "")" asp-page="/SystemAdmin/Index">
                            <i class="bi bi-sliders2"></i>
                            <span>系統管理</span>
                        </a>
                        <ul class="sidebar-subnav">
                            <li>
                                <a class="sidebar-subnav-link" href="/SystemAdmin?sub=calendar#subtab-calendar">
                                    <i class="bi bi-calendar3"></i>學期行事曆管理
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-subnav-link" href="/SystemAdmin?sub=fields#subtab-fields">
                                    <i class="bi bi-list-columns-reverse"></i>系統欄位管理
                                </a>
                            </li>
                            <li>
                                <a class="sidebar-subnav-link" href="/SystemAdmin?sub=schedules#subtab-schedules">
                                    <i class="bi bi-clock-history"></i>排程管理
                                </a>
                            </li>
                        </ul>
                    </li>
                }

                @if (!isAuthenticated)
                {
                    <li class="sidebar-nav-item">
                        <a class="sidebar-nav-link @(IsActive("/Account") ? "active" : "")" asp-page="/Account/Login">
                            <i class="bi bi-person-badge-fill"></i>
                            <span>帳號登入</span>
                        </a>
                    </li>
                }
            </ul>

            @if (canAccessAdmin)
            {
                <div class="sidebar-section-label">快捷工具與匯出</div>
                <ul class="sidebar-nav">
                    <li class="sidebar-nav-item">
                        <a class="sidebar-nav-link" href="/admin/export/credits.csv">
                            <i class="bi bi-filetype-csv"></i>
                            <span>匯出學生堂數 CSV</span>
                        </a>
                    </li>
                </ul>
            }

            <div class="sidebar-footer">
                <div class="user-pill-card mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small text-white-50">目前登入身分</span>
                        <span class="badge bg-warning text-dark">@roleLabel</span>
                    </div>
                    <div class="fw-bold text-white small text-truncate">@displayName</div>
                    <div class="mt-2 d-flex gap-2">
                        @if (isAuthenticated)
                        {
                            <form method="post" asp-page="/Account/Login" asp-page-handler="Logout" class="w-100">
                                <button type="submit" class="btn btn-sm btn-outline-light w-100 py-1" style="min-height: 32px; font-size: 0.8rem;">
                                    <i class="bi bi-box-arrow-right me-1"></i>登出帳號
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-accent w-100 py-1" style="min-height: 32px; font-size: 0.8rem;" asp-page="/Account/Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>前往登入
                            </a>
                        }
                    </div>
                </div>

                <div class="small text-white-50 fw-semibold mb-2" style="font-size: 0.74rem; letter-spacing: 0.04em;">
                    <i class="bi bi-lightning-charge-fill text-warning me-1"></i>PM 驗收角色一鍵切換
                </div>
                <div class="d-grid gap-1">
                    <form method="post" asp-page="/Account/Login" asp-page-handler="QuickSwitch">
                        <input type="hidden" name="username" value="parent.lin" />
                        <button type="submit" class="role-switch-btn">
                            <span><i class="bi bi-people-fill me-1 text-info"></i>家長（林媽媽）</span>
                            <span class="badge bg-secondary">2子</span>
                        </button>
                    </form>
                    <form method="post" asp-page="/Account/Login" asp-page-handler="QuickSwitch">
                        <input type="hidden" name="username" value="teacher.wang" />
                        <button type="submit" class="role-switch-btn">
                            <span><i class="bi bi-easel2-fill me-1 text-success"></i>老師（王老師）</span>
                            <span class="badge bg-secondary">教務</span>
                        </button>
                    </form>
                    <form method="post" asp-page="/Account/Login" asp-page-handler="QuickSwitch">
                        <input type="hidden" name="username" value="admin" />
                        <button type="submit" class="role-switch-btn">
                            <span><i class="bi bi-shield-check me-1 text-warning"></i>管理員（蘇主任）</span>
                            <span class="badge bg-secondary">報表</span>
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <!-- 手機與平板左側抽屜選單 (Offcanvas Drawer) -->
        <div class="offcanvas offcanvas-start text-bg-dark d-lg-none" tabindex="-1" id="mobileSidebarDrawer"
             aria-labelledby="mobileSidebarLabel" style="width: 280px; background: var(--plato-sidebar-bg) !important;">
            <div class="offcanvas-header border-bottom border-secondary border-opacity-25">
                <div class="d-flex align-items-center gap-2" id="mobileSidebarLabel">
                    <span class="sidebar-brand-mark" style="width: 32px; height: 32px;">
                        <img src="~/images/plato-logo.png" alt="柏拉圖校徽" />
                    </span>
                    <div>
                        <div class="fw-bold">柏拉圖文理補習班</div>
                        <div class="small text-white-50" style="font-size: 0.75rem;">輔導預約與堂數管理</div>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="關閉選單"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column p-0">
                <div class="sidebar-section-label">可用功能選單</div>
                <ul class="sidebar-nav">
                    @if (canAccessOverview)
                    {
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link @(IsActive("/") ? "active" : "")" asp-page="/Index">
                                <i class="bi bi-grid-1x2-fill"></i>
                                <span>系統總覽儀表板</span>
                            </a>
                        </li>
                    }
                    @if (canAccessParent)
                    {
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link @(IsActive("/Parent") ? "active" : "")" asp-page="/Parent/Index">
                                <i class="bi bi-calendar2-check-fill"></i>
                                <span>家長預約與堂數</span>
                            </a>
                        </li>
                    }
                    @if (canAccessTeacher)
                    {
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link @(IsActive("/Teacher") ? "active" : "")" asp-page="/Teacher/Index">
                                <i class="bi bi-journal-check"></i>
                                <span>老師教務與儲值</span>
                            </a>
                        </li>
                    }
                    @if (canAccessMembers)
                    {
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link @(IsActive("/Members") ? "active" : "")" asp-page="/Members/Index">
                                <i class="bi bi-people-fill"></i>
                                <span>學生 / 家長 / 老師管理</span>
                            </a>
                        </li>
                    }
                    @if (canAccessAdmin)
                    {
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link @(IsActive("/Admin") ? "active" : "")" asp-page="/Admin/Index">
                                <i class="bi bi-bar-chart-line-fill"></i>
                                <span>管理員營運與報表</span>
                            </a>
                        </li>
                    }
                    @if (canAccessSystemAdmin)
                    {
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link @(IsActive("/SystemAdmin") ? "active" : "")" asp-page="/SystemAdmin/Index">
                                <i class="bi bi-sliders2"></i>
                                <span>系統管理（欄位管理）</span>
                            </a>
                        </li>
                    }
                    @if (!isAuthenticated)
                    {
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link @(IsActive("/Account") ? "active" : "")" asp-page="/Account/Login">
                                <i class="bi bi-person-badge-fill"></i>
                                <span>帳號登入</span>
                            </a>
                        </li>
                    }
                </ul>

                <div class="sidebar-footer mt-auto">
                    @if (isAuthenticated)
                    {
                        <form method="post" asp-page="/Account/Login" asp-page-handler="Logout" class="mb-3">
                            <button type="submit" class="btn btn-sm btn-outline-light w-100">
                                <i class="bi bi-box-arrow-right me-1"></i>登出 (@displayName)
                            </button>
                        </form>
                    }
                    <div class="small text-white-50 fw-semibold mb-2">PM 驗收角色一鍵切換</div>
                    <div class="d-grid gap-2">
                        <form method="post" asp-page="/Account/Login" asp-page-handler="QuickSwitch">
                            <input type="hidden" name="username" value="parent.lin" />
                            <button type="submit" class="role-switch-btn">家長（林媽媽：2位孩子）</button>
                        </form>
                        <form method="post" asp-page="/Account/Login" asp-page-handler="QuickSwitch">
                            <input type="hidden" name="username" value="teacher.wang" />
                            <button type="submit" class="role-switch-btn">老師（王老師：點名/儲值）</button>
                        </form>
                        <form method="post" asp-page="/Account/Login" asp-page-handler="QuickSwitch">
                            <input type="hidden" name="username" value="admin" />
                            <button type="submit" class="role-switch-btn">管理員（蘇主任：學期/月報）</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- 右側主內容工作區 -->
        <div class="app-main">
            <main role="main" class="flex-grow-1">
                <div class="container-fluid px-3 px-md-4 py-3 py-md-4" style="max-width: 1380px;">
                    @if (TempData["SuccessMessage"] is string successMsg)
                    {
                        <div class="alert alert-success border-0 shadow-sm alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                            <i class="bi bi-check-circle-fill fs-5"></i>
                            <div><strong>操作成功：</strong> @successMsg</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="關閉"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] is string errorMsg)
                    {
                        <div class="alert alert-danger border-0 shadow-sm alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                            <div><strong>操作提醒：</strong> @errorMsg</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="關閉"></button>
                        </div>
                    }

                    @RenderBody()
                </div>
            </main>

            <footer class="border-top py-3 px-4 bg-white text-muted small mt-auto">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2" style="max-width: 1380px; margin: 0 auto;">
                    <div>
                        <strong>柏拉圖文理短期補習班</strong> － 網頁輔導預約與堂數管理系統
                    </div>
                    <div class="d-flex flex-wrap gap-3">
                        <span><i class="bi bi-clock me-1"></i>時區：Asia/Taipei (UTC+8)</span>
                        <span><i class="bi bi-chat-dots me-1"></i>LINE 僅供通知</span>
                        <span><i class="bi bi-journal-code me-1"></i>Append-Only 堂數流水帳</span>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- 全域送出/等待遮罩 (旗艦綜合款：數理符號 3D 翻滾動畫) -->
    <style>
        .math-perspective {
            perspective: 900px;
        }
        /* 標題後綴 3D 數理翻滾魔方 */
        .math-cube-spinner {
            width: 28px;
            height: 28px;
            position: relative;
            transform-style: preserve-3d;
            animation: mathRotateCube 6s infinite cubic-bezier(0.4, 0, 0.2, 1);
        }
        .math-cube-face {
            position: absolute;
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            font-family: serif;
            font-weight: bold;
            border-radius: 6px;
            background: rgba(30, 58, 138, 0.45);
            border: 1.5px solid rgba(147, 197, 253, 0.7);
            color: #93c5fd;
            text-shadow: 0 0 8px rgba(147, 197, 253, 0.85);
            box-shadow: inset 0 0 8px rgba(59, 130, 246, 0.35);
        }
        .math-cube-face-front  { transform: translateZ(14px); }
        .math-cube-face-back   { transform: rotateY(180deg) translateZ(14px); }
        .math-cube-face-right  { transform: rotateY(90deg) translateZ(14px); }
        .math-cube-face-left   { transform: rotateY(-90deg) translateZ(14px); }
        .math-cube-face-top    { transform: rotateX(90deg) translateZ(14px); }
        .math-cube-face-bottom { transform: rotateX(-90deg) translateZ(14px); }

        @@keyframes mathRotateCube {
            0%   { transform: rotateX(0deg) rotateY(0deg); }
            16%  { transform: rotateX(90deg) rotateY(0deg); }
            33%  { transform: rotateX(90deg) rotateY(90deg); }
            50%  { transform: rotateX(180deg) rotateY(90deg); }
            66%  { transform: rotateX(180deg) rotateY(180deg); }
            83%  { transform: rotateX(270deg) rotateY(180deg); }
            100% { transform: rotateX(360deg) rotateY(360deg); }
        }

        /* 背景漂浮 3D 翻轉數理符號 */
        @@keyframes mathFloatTumble1 {
            0% {
                transform: translateY(15px) rotateX(0deg) rotateY(0deg) rotateZ(0deg) scale(0.9);
                opacity: 0.12;
            }
            50% {
                transform: translateY(-25px) rotateX(180deg) rotateY(120deg) rotateZ(45deg) scale(1.1);
                opacity: 0.5;
            }
            100% {
                transform: translateY(15px) rotateX(360deg) rotateY(240deg) rotateZ(0deg) scale(0.9);
                opacity: 0.12;
            }
        }
        @@keyframes mathFloatTumble2 {
            0% {
                transform: translateY(-12px) rotateX(45deg) rotateY(0deg) rotateZ(20deg) scale(1);
                opacity: 0.15;
            }
            50% {
                transform: translateY(28px) rotateX(225deg) rotateY(180deg) rotateZ(180deg) scale(1.2);
                opacity: 0.55;
            }
            100% {
                transform: translateY(-12px) rotateX(405deg) rotateY(360deg) rotateZ(380deg) scale(1);
                opacity: 0.15;
            }
        }

        .math-tumble-1 { animation: mathFloatTumble1 7s infinite ease-in-out; }
        .math-tumble-2 { animation: mathFloatTumble2 9s infinite ease-in-out; }
        .math-tumble-3 { animation: mathFloatTumble1 11s infinite ease-in-out reverse; }
        .math-tumble-4 { animation: mathFloatTumble2 8.5s infinite ease-in-out reverse; }

        /* 中央微光環繞軌道 */
        @@keyframes mathOrbitSpin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        @@keyframes mathCounterSpin {
            0% { transform: rotate(0deg) rotateX(0deg) rotateY(0deg); }
            100% { transform: rotate(-360deg) rotateX(360deg) rotateY(360deg); }
        }
        .math-orbit-ring {
            width: 140px;
            height: 140px;
            position: absolute;
            animation: mathOrbitSpin 12s infinite linear;
            pointer-events: none;
        }
        .math-orbit-node {
            position: absolute;
            width: 26px;
            height: 26px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: bold;
            font-family: serif;
            animation: mathCounterSpin 12s infinite linear;
            backdrop-filter: blur(4px);
        }
    </style>

    <div id="globalLoadingOverlay" style="position: fixed; inset: 0; background: rgba(15, 23, 42, 0.78); backdrop-filter: blur(6px); z-index: 100000; display: none; flex-direction: column; align-items: center; justify-content: center; color: #ffffff; pointer-events: all; user-select: none; overflow: hidden;">
        
        <!-- 背景層：全景數理星空漂浮 3D 翻滾符號 -->
        <div class="math-perspective" style="position: absolute; inset: 0; pointer-events: none; overflow: hidden;">
            <span class="math-tumble-1" style="position: absolute; top: 10%; left: 12%; font-size: 2.5rem; color: #60a5fa; font-family: serif; font-weight: bold;">π</span>
            <span class="math-tumble-2" style="position: absolute; top: 22%; right: 14%; font-size: 3rem; color: #67e8f9; font-family: serif; font-weight: bold;">∑</span>
            <span class="math-tumble-3" style="position: absolute; bottom: 25%; left: 15%; font-size: 2.2rem; color: #818cf8; font-family: serif; font-weight: bold;">∫</span>
            <span class="math-tumble-4" style="position: absolute; bottom: 18%; right: 20%; font-size: 2.2rem; color: #38bdf8; font-family: serif; font-weight: bold;">√x</span>
            <span class="math-tumble-1" style="position: absolute; top: 15%; left: 35%; font-size: 2rem; color: #fde047; font-family: serif; font-weight: bold;">∞</span>
            <span class="math-tumble-2" style="position: absolute; top: 38%; left: 8%; font-size: 2rem; color: #2dd4bf; font-family: serif; font-weight: bold;">Δ</span>
            <span class="math-tumble-3" style="position: absolute; top: 45%; right: 9%; font-size: 2.4rem; color: #c084fc; font-family: serif; font-weight: bold;">θ</span>
            <span class="math-tumble-4" style="position: absolute; bottom: 35%; right: 12%; font-size: 2rem; color: #93c5fd; font-family: serif; font-weight: bold;">λ</span>
            <span class="math-tumble-1" style="position: absolute; top: 62%; left: 24%; font-size: 1.6rem; color: #6ee7b7; font-family: serif; font-weight: bold;">f(x)</span>
            <span class="math-tumble-2" style="position: absolute; bottom: 10%; left: 45%; font-size: 2rem; color: #a5b4fc; font-family: serif; font-weight: bold;">Ω</span>
            <span class="math-tumble-3" style="position: absolute; top: 12%; right: 38%; font-size: 1.6rem; color: #bae6fd; font-family: serif; font-weight: bold;">e<sup>iπ</sup></span>
            <span class="math-tumble-4" style="position: absolute; bottom: 10%; right: 38%; font-size: 2rem; color: #7dd3fc; font-family: serif; font-weight: bold;">≈</span>
        </div>

        <!-- 中央主要進度圖示 (微光 Spinner + 軌道衛星 + π 核心) -->
        <div style="position: relative; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: center; z-index: 10;">
            <!-- 微光環繞軌道 -->
            <div class="math-orbit-ring">
                <div class="math-orbit-node" style="top: -13px; left: 57px; background: rgba(59, 130, 246, 0.35); border: 1px solid rgba(147, 197, 253, 0.7); color: #bfdbfe; box-shadow: 0 0 10px rgba(59, 130, 246, 0.6);">π</div>
                <div class="math-orbit-node" style="bottom: -13px; left: 57px; background: rgba(6, 182, 212, 0.35); border: 1px solid rgba(103, 232, 249, 0.7); color: #cffafe; box-shadow: 0 0 10px rgba(6, 182, 212, 0.6);">∑</div>
                <div class="math-orbit-node" style="top: 57px; left: -13px; background: rgba(99, 102, 241, 0.35); border: 1px solid rgba(165, 180, 252, 0.7); color: #e0e7ff; box-shadow: 0 0 10px rgba(99, 102, 241, 0.6);">∫</div>
                <div class="math-orbit-node" style="top: 57px; right: -13px; background: rgba(14, 165, 233, 0.35); border: 1px solid rgba(125, 211, 252, 0.7); color: #e0f2fe; box-shadow: 0 0 10px rgba(14, 165, 233, 0.6);">√</div>
            </div>

            <!-- 標準環形 Spinner (加強外層微光) -->
            <div class="spinner-border text-info" style="width: 4.2rem; height: 4.2rem; border-width: 0.32em; filter: drop-shadow(0 0 12px rgba(56, 189, 248, 0.5));" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>

            <!-- 中心微光數理核心 -->
            <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none;">
                <span style="font-family: serif; font-weight: 900; font-size: 1.4rem; color: #93c5fd; text-shadow: 0 0 12px rgba(147, 197, 253, 0.9);">
                    π
                </span>
            </div>
        </div>

        <!-- 標題列：處理中，請稍候... + 3D 數理翻滾魔方 -->
        <div style="display: flex; align-items: center; justify-content: center; gap: 0.65rem; margin-bottom: 0.5rem; z-index: 10;">
            <h4 class="fw-bold mb-0" id="globalLoadingTitle" style="letter-spacing: 0.05em; text-shadow: 0 2px 8px rgba(0,0,0,0.5);">處理中，請稍候...</h4>
            <!-- 3D 數理翻滾方塊 -->
            <div class="math-perspective" style="display: inline-flex; align-items: center; justify-content: center;">
                <div class="math-cube-spinner">
                    <div class="math-cube-face math-cube-face-front">π</div>
                    <div class="math-cube-face math-cube-face-back">∑</div>
                    <div class="math-cube-face math-cube-face-right">∫</div>
                    <div class="math-cube-face math-cube-face-left">√</div>
                    <div class="math-cube-face math-cube-face-top">∞</div>
                    <div class="math-cube-face math-cube-face-bottom">Δ</div>
                </div>
            </div>
        </div>

        <!-- 提示說明字串 -->
        <p class="text-white-50 small mb-0" id="globalLoadingDesc" style="z-index: 10; letter-spacing: 0.02em;">系統正在儲存並同步資料，請勿關閉視窗或點擊其他功能</p>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        window.showGlobalLoading = function(title, desc) {
            const overlay = document.getElementById('globalLoadingOverlay');
            if (overlay) {
                if (title) document.getElementById('globalLoadingTitle').textContent = title;
                if (desc) document.getElementById('globalLoadingDesc').textContent = desc;
                overlay.style.display = 'flex';
                document.body.style.pointerEvents = 'none';
                overlay.style.pointerEvents = 'all';
            }
        };

        window.hideGlobalLoading = function() {
            const overlay = document.getElementById('globalLoadingOverlay');
            if (overlay) {
                overlay.style.display = 'none';
                document.body.style.pointerEvents = 'auto';
            }
        };

        // 攔截所有表單送出（POST 或非新視窗操作）
        document.addEventListener('submit', function(e) {
            const form = e.target;
            if (!form || form.target === '_blank') return;
            if (form.getAttribute('data-no-loading') === 'true') return;
            
            if (typeof form.checkValidity === 'function' && !form.checkValidity()) {
                return;
            }

            window.showGlobalLoading('處理中，請稍候...', '系統正在儲存並同步資料，請勿關閉視窗或點擊其他功能');

            // 20 秒逾時防呆
            setTimeout(function() {
                window.hideGlobalLoading();
            }, 20000);
        });

        function activateWorkspaceTab(tabPaneId) {
            const triggerEl = document.querySelector(`[data-bs-target="#${tabPaneId}"]`);
            if (triggerEl && window.bootstrap) {
                const tab = new bootstrap.Tab(triggerEl);
                tab.show();
                history.replaceState(null, '', `#${tabPaneId}`);
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            const hash = window.location.hash ? window.location.hash.substring(1) : '';
            if (hash) {
                activateWorkspaceTab(hash);
            }

            document.querySelectorAll('.workspace-tabs-shell [data-bs-toggle="pill"]').forEach(function (btn) {
                btn.addEventListener('shown.bs.tab', function (e) {
                    const target = e.target.getAttribute('data-bs-target');
                    if (target) {
                        history.replaceState(null, '', target);
                    }
                });
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
