@page
@model PlatoTutoring.Web.Pages.Teacher.IndexModel
@{
    ViewData["Title"] = "老師教務、點名與儲值中心";
    var todayTaipeiDate = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(8));
    var todayStartUtc = DateTime.SpecifyKind(todayTaipeiDate.ToDateTime(TimeOnly.MinValue).AddHours(-8), DateTimeKind.Utc);
    var unresolvedHwCount = Model.HomeworkItems.Count(h => !h.IsResolvedByBooking);
    var openSlotsCount = Model.Slots.Count(s => s.RemainingSeats > 0 && s.StartsAtUtc >= todayStartUtc);
}

<!-- 頂部老師工作台標題與快捷統計 -->
<div class="card-plato p-3 p-md-4 mb-4">
    <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3">
        <div>
            <div class="eyebrow-tag">
                <i class="bi bi-journal-check"></i>
                <span>授課老師工作台 · Teacher Workspace</span>
            </div>
            <h1 class="h3 fw-bold mb-1">教務點名、儲值入帳與輔導排課中心</h1>
            <p class="text-secondary small mb-0">
                授課老師：<strong>@Model.CurrentUser.DisplayName</strong> ｜ 手機單欄表單最佳化 ｜ 支援手機拍照或相簿上傳匯款憑證
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <form method="post" asp-page-handler="Trigger48hReminder">
                <button type="submit" class="btn btn-accent btn-sm">
                    <i class="bi bi-bell-fill me-1"></i>執行 48 小時未預約二次催促掃描
                </button>
            </form>
        </div>
    </div>
</div>

<!-- 老師工作台即時概況指標列 -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="metric-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-1">
                <span class="small text-secondary fw-semibold">待點名與有效預約</span>
                <span class="metric-icon-box"><i class="bi bi-person-check-fill"></i></span>
            </div>
            <div class="fs-3 fw-bold">@Model.AllConfirmedBookings.Count <span class="fs-6 fw-normal text-muted">筆</span></div>
            <div class="small text-muted">支援課後定案鎖定紀錄</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="metric-card metric-ocean h-100">
            <div class="d-flex justify-content-between align-items-start mb-1">
                <span class="small text-secondary fw-semibold">近期儲值登錄批次</span>
                <span class="metric-icon-box ocean"><i class="bi bi-cash-coin"></i></span>
            </div>
            <div class="fs-3 fw-bold">@Model.RecentTopUps.Count <span class="fs-6 fw-normal text-muted">批</span></div>
            <div class="small text-muted">私有保存匯款憑證 90 天</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="metric-card metric-sage h-100">
            <div class="d-flex justify-content-between align-items-start mb-1">
                <span class="small text-secondary fw-semibold">尚有名額輔導時段</span>
                <span class="metric-icon-box sage"><i class="bi bi-calendar-plus-fill"></i></span>
            </div>
            <div class="fs-3 fw-bold">@openSlotsCount <span class="fs-6 fw-normal text-muted">場</span></div>
            <div class="small text-muted">可隨時加開考前加強時段</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="metric-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-1">
                <span class="small text-secondary fw-semibold">待家長預約作業追蹤</span>
                <span class="metric-icon-box"><i class="bi bi-exclamation-octagon-fill"></i></span>
            </div>
            <div class="fs-3 fw-bold">@unresolvedHwCount <span class="fs-6 fw-normal text-muted">位</span></div>
            <div class="small text-muted">逾 48 小時自動二次催促</div>
        </div>
    </div>
</div>

<!-- 膠囊式分段工作區頁籤 (Segmented Workspace Tabs) -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <ul class="nav nav-pills workspace-tabs-shell" id="teacherWorkspaceTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="btn-teacher-rollcall" data-bs-toggle="pill"
                    data-bs-target="#tab-teacher-rollcall" type="button" role="tab">
                <i class="bi bi-person-check-fill"></i>
                <span>今日課堂點名</span>
                <span class="workspace-tab-count">@Model.AllConfirmedBookings.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="btn-teacher-topup" data-bs-toggle="pill"
                    data-bs-target="#tab-teacher-topup" type="button" role="tab">
                <i class="bi bi-cash-coin"></i>
                <span>儲值與堂數調整</span>
                <span class="workspace-tab-count">@Model.RecentTopUps.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="btn-teacher-slots" data-bs-toggle="pill"
                    data-bs-target="#tab-teacher-slots" type="button" role="tab">
                <i class="bi bi-calendar-plus-fill"></i>
                <span>時段排課與代約</span>
                <span class="workspace-tab-count">@Model.Slots.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="btn-teacher-homework" data-bs-toggle="pill"
                    data-bs-target="#tab-teacher-homework" type="button" role="tab">
                <i class="bi bi-bell-fill"></i>
                <span>作業追蹤與催促</span>
                <span class="workspace-tab-count">@unresolvedHwCount</span>
            </button>
        </li>
    </ul>

    <span class="small text-secondary">
        <i class="bi bi-compass me-1"></i>點選上方頁籤或左側子選單可快速切換作業工作區
    </span>
</div>

<div class="tab-content" id="teacherWorkspaceTabContent">
    <!-- 分頁一：今日課堂點名與課後定案 -->
    <div class="tab-pane fade show active" id="tab-teacher-rollcall" role="tabpanel">
        <div class="card-plato p-3 p-md-4 mb-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
                <div class="section-header-title mb-0">
                    <span class="metric-icon-box"><i class="bi bi-person-check-fill"></i></span>
                    <div>
                        <h2 class="h5 fw-bold mb-0">課堂點名與定案</h2>
                        <div class="small text-muted">優先顯示當日課堂時段，點擊時段切換上課學生名單；支援單筆儲存與全班批次一次儲存</div>
                    </div>
                </div>

                <!-- 選擇上課日期 -->
                <form method="get" class="d-flex align-items-center gap-2">
                    <span class="small fw-semibold text-secondary text-nowrap"><i class="bi bi-calendar3 me-1"></i>上課日期：</span>
                    <input type="date" name="RollcallDate" class="form-control form-control-sm"
                           value="@Model.RollcallDate" onchange="this.form.submit()" style="max-width: 160px;" />
                    <a href="/Teacher?RollcallDate=@DateTime.UtcNow.AddHours(8).ToString("yyyy-MM-dd")#tab-teacher-rollcall"
                       class="btn btn-sm btn-outline-secondary text-nowrap">今日</a>
                </form>
            </div>

            <!-- 當日課程時段清單（優先顯示當日課程） -->
            <div class="mb-4">
                <div class="small fw-bold text-secondary mb-2">
                    <i class="bi bi-clock-history me-1"></i>@(Model.RollcallDate) 輔導時段（共 @Model.TodaySlots.Count 場）：
                </div>
                @if (!Model.TodaySlots.Any())
                {
                    <div class="alert alert-light border text-muted small py-3 mb-0">
                        <i class="bi bi-info-circle me-1"></i>本日無排定輔導時段。您可切換上方日期，或至「時段排課與代約」新增時段。
                    </div>
                }
                else
                {
                    <div class="row g-2">
                        @foreach (var ts in Model.TodaySlots)
                        {
                            var sTpe = BookingService.ToTaipeiTime(ts.StartsAtUtc);
                            var eTpe = BookingService.ToTaipeiTime(ts.EndsAtUtc);
                            var dayZh = "日一二三四五六"[(int)sTpe.DayOfWeek];
                            var isSelectedSlot = Model.ActiveRollcallSlot?.Id == ts.Id;
                            var bookedCount = Model.TodayBookings.Count(b => b.TutoringSlotId == ts.Id);

                            <div class="col-12 col-md-6 col-xl-4">
                                <a href="/Teacher?RollcallDate=@Model.RollcallDate&SelectedSlotId=@ts.Id#tab-teacher-rollcall"
                                   class="card-plato p-3 slot-card-selectable d-block text-decoration-none text-dark h-100 @(isSelectedSlot ? "active" : "")">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div class="fw-bold">
                                            <i class="bi bi-clock me-1 text-secondary"></i>@sTpe.ToString("HH:mm") – @eTpe.ToString("HH:mm")
                                            <span class="small text-muted ms-1">(@dayZh)</span>
                                        </div>
                                        <span class="badge @(ts.SlotType == SlotType.SmallGroup ? "badge-slot-small" : "badge-slot-group")">
                                            @(ts.SlotType == SlotType.SmallGroup ? "小組指導" : "團體輔導")
                                        </span>
                                    </div>
                                    <div class="small text-secondary mb-2">
                                        <div><strong>@ts.CourseProgress?.Code</strong> @ts.CourseProgress?.Title</div>
                                        <div class="text-muted">適用班別：@ts.GradeClass ｜ 授課：@ts.TeacherUser?.DisplayName</div>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top small">
                                        <span class="fw-semibold @(bookedCount > 0 ? "text-success" : "text-muted")">
                                            <i class="bi bi-people-fill me-1"></i>已約 @bookedCount / @ts.MaxCapacity 名
                                        </span>
                                        @if (ts.IsAttendanceFinalized)
                                        {
                                            <span class="badge bg-dark">已課後定案</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">點名待定案</span>
                                        }
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- 選中時段的上課學生點名名冊 -->
            @if (Model.ActiveRollcallSlot != null)
            {
                var curSlot = Model.ActiveRollcallSlot;
                var curStartTpe = BookingService.ToTaipeiTime(curSlot.StartsAtUtc);
                var curEndTpe = BookingService.ToTaipeiTime(curSlot.EndsAtUtc);
                var curDayZh = "日一二三四五六"[(int)curStartTpe.DayOfWeek];
                var slotBookings = Model.TodayBookings.Where(b => b.TutoringSlotId == curSlot.Id).ToList();

                <div class="border rounded-3 p-3 p-md-4 bg-light">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3 pb-2 border-bottom">
                        <div>
                            <h3 class="h6 fw-bold mb-1 text-dark">
                                <i class="bi bi-card-checklist me-1 text-primary"></i>
                                本課堂學生名冊：@curStartTpe.ToString("yyyy/MM/dd") (@curDayZh) @curStartTpe.ToString("HH:mm") – @curEndTpe.ToString("HH:mm")
                            </h3>
                            <div class="small text-secondary">
                                進度：<strong>@curSlot.CourseProgress?.Code @curSlot.CourseProgress?.Title</strong> ｜ 班別：@curSlot.GradeClass ｜
                                類型：@(curSlot.SlotType == SlotType.SmallGroup ? "小組指導（扣 1 堂）" : "團體輔導（免費 0 堂）")
                            </div>
                        </div>
                        <span class="badge @(curSlot.IsAttendanceFinalized ? "bg-dark" : "bg-warning text-dark") px-3 py-2">
                            @(curSlot.IsAttendanceFinalized ? "✓ 本時段已課後定案" : "點名未定案")
                        </span>
                    </div>

                    @if (!slotBookings.Any())
                    {
                        <div class="text-muted small py-4 text-center bg-white rounded-3 border">
                            <i class="bi bi-person-x fs-4 d-block mb-1 text-secondary"></i>
                            此時段目前尚無學生預約。
                        </div>
                    }
                    else
                    {
                        <!-- 全部選擇後一次儲存表單 -->
                        <form method="post" asp-page-handler="BatchRecordAttendance" id="formBatchRollcall" onsubmit="showSavingOverlay()">
                            <input type="hidden" name="slotId" value="@curSlot.Id" />

                            <div class="table-responsive bg-white rounded-3 border shadow-sm mb-3">
                                <table class="table table-hover align-middle table-plato table-responsive-cards mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>學生姓名</th>
                                            <th>學校 / 年級班級</th>
                                            <th>到班目的</th>
                                            <th>扣堂紀錄</th>
                                            <th style="min-width: 170px;">點名狀態（可批次切換）</th>
                                            <th class="text-end">單筆操作</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < slotBookings.Count; i++)
                                        {
                                            var b = slotBookings[i];
                                            <input type="hidden" name="bookingIds" value="@b.Id" />
                                            <tr>
                                                <td data-label="學生姓名">
                                                    <span class="fw-bold fs-6">@b.Student?.FullName</span>
                                                </td>
                                                <td data-label="學校班別" class="small text-secondary">
                                                    @b.Student?.DisplaySchoolGradeClass
                                                </td>
                                                <td data-label="到班目的">
                                                    <span class="badge bg-light text-dark border">@b.PurposeName</span>
                                                </td>
                                                <td data-label="扣堂紀錄" class="small">
                                                    @if (b.CreditsDeducted == 0)
                                                    {
                                                        <span class="text-muted">免費 0 堂</span>
                                                    }
                                                    else
                                                    {
                                                        <span>贈送 @b.BonusCreditsUsed + 付費 @b.PaidCreditsUsed 堂</span>
                                                    }
                                                </td>
                                                <td data-label="點名狀態">
                                                    <select name="statuses" class="form-select form-select-sm fw-semibold" id="status_select_@b.Id">
                                                        <option value="Present" selected="@(b.AttendanceStatus == AttendanceStatus.Present)">出席 (Present)</option>
                                                        <option value="Absent" selected="@(b.AttendanceStatus == AttendanceStatus.Absent)">請假 (Absent)</option>
                                                        <option value="NoShow" selected="@(b.AttendanceStatus == AttendanceStatus.NoShow)">曠課爽約 (NoShow)</option>
                                                        <option value="Pending" selected="@(b.AttendanceStatus == AttendanceStatus.Pending)">待點名 (Pending)</option>
                                                    </select>

                                                </td>
                                                <td data-label="單筆操作" class="text-end">
                                                    <button type="button" class="btn btn-sm btn-outline-dark"
                                                            onclick="saveSingleAttendance(@b.Id, @(curSlot.IsAttendanceFinalized ? "true" : "false"))">
                                                        <i class="bi bi-save me-1"></i>單筆儲存
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- 批次儲存操作列 -->
                            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 bg-white p-3 rounded-3 border shadow-sm">
                                <div class="form-check mb-0">
                                    <input class="form-check-input" type="checkbox" name="finalizeSlot" value="true" id="batchFinalizeSlot"
                                           checked="@curSlot.IsAttendanceFinalized" />
                                    <label class="form-check-label fw-semibold small" for="batchFinalizeSlot">
                                        同時標記本時段為「課後定案」
                                    </label>
                                </div>
                                <button type="submit" class="btn btn-accent fw-bold px-4">
                                    <i class="bi bi-check2-all me-1"></i>全部選擇後一次儲存
                                </button>
                            </div>
                        </form>

                        <!-- 單筆儲存專用 hidden form -->
                        <form method="post" asp-page-handler="RecordAttendance" id="singleRollcallForm" class="d-none" onsubmit="showSavingOverlay()">
                            <input type="hidden" name="bookingId" id="singleBookingId" />
                            <input type="hidden" name="attendanceStatus" id="singleAttendanceStatus" />
                            <input type="hidden" name="finalizeSlot" id="singleFinalizeSlot" value="false" />
                        </form>
                    }
                </div>
            }
        </div>
    </div>


    <!-- 分頁二：儲值登錄、匯款憑證上傳與堂數沖正調整 -->
    <div class="tab-pane fade" id="tab-teacher-topup" role="tabpanel">
        <!-- 頂部功能按鈕工具列 -->
        <div class="card-plato p-3 p-md-4 mb-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <h2 class="h5 fw-bold mb-1"><i class="bi bi-wallet2 me-2 text-primary"></i>學生儲值與堂數管理</h2>
                    <div class="small text-muted">所有更正均以新交易沖正調整，不修改原始流水帳；憑證僅授課老師與管理員具備權限檢視</div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-primary fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalTopUp" onclick="openTopUpModal()">
                        <i class="bi bi-cash-coin me-1"></i>+ 學生儲值登錄與憑證上傳
                    </button>
                    <button type="button" class="btn btn-outline-dark fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAdjustCredits" onclick="openAdjustCreditsModal()">
                        <i class="bi bi-arrow-left-right me-1 text-primary"></i>+ 發放贈送堂數／沖正更正堂數
                    </button>
                </div>
            </div>
        </div>

        <!-- 主要畫面：近期儲值批次與匯款憑證紀錄（含學生學校、年別、班別與匯款日篩選） -->
        <div class="card-plato p-3 p-md-4">
            <div class="section-header-clean mb-3">
                <div class="section-header-title">
                    <span class="metric-icon-box ocean"><i class="bi bi-receipt-cutoff"></i></span>
                    <div>
                        <h2 class="h5 fw-bold mb-0">近期儲值批次與匯款憑證紀錄</h2>
                        <div class="small text-muted">支援學生多維度條件與匯款日精確篩選</div>
                    </div>
                </div>
            </div>

            <!-- 篩選表單 -->
            <form method="get" action="/Teacher#tab-teacher-topup" class="p-3 mb-4 bg-light rounded-3 border">
                <div class="row g-2 align-items-end">
                    <div class="col-6 col-md-3">
                        <label class="form-label small fw-semibold text-secondary mb-1">學校篩選</label>
                        <select name="FilterSchool" class="form-select form-select-sm">
                            <option value="">全部學校</option>
                            @foreach (var s in Model.SchoolOptions)
                            {
                                <option value="@s.Value" selected="@(Model.FilterSchool == s.Value)">@s.Value</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-semibold text-secondary mb-1">年別篩選</label>
                        <select name="FilterGrade" class="form-select form-select-sm">
                            <option value="">全部年別</option>
                            @foreach (var g in Model.GradeOptions)
                            {
                                <option value="@g.Value" selected="@(Model.FilterGrade == g.Value)">@g.Value</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-semibold text-secondary mb-1">班別篩選</label>
                        <select name="FilterClass" class="form-select form-select-sm">
                            <option value="">全部班別</option>
                            @foreach (var c in Model.ClassOptions)
                            {
                                <option value="@c.Value" selected="@(Model.FilterClass == c.Value)">@c.Value</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small fw-semibold text-secondary mb-1">匯款日篩選</label>
                        <input type="date" name="FilterRemittanceDate" class="form-control form-control-sm" value="@Model.FilterRemittanceDate" />
                    </div>
                    <div class="col-12 col-md-2 d-flex gap-1">
                        <button type="submit" class="btn btn-sm btn-primary flex-fill">
                            <i class="bi bi-funnel me-1"></i>篩選
                        </button>
                        <a href="/Teacher#tab-teacher-topup" class="btn btn-sm btn-outline-secondary">清除</a>
                    </div>
                </div>
            </form>
            <div class="table-responsive">
                <table class="table table-hover align-middle table-plato table-responsive-cards mb-0">
                    <thead>
                        <tr>
                            <th>批次編號</th>
                            <th>學生</th>
                            <th>金額 / 堂數 / 單價</th>
                            <th>匯款日 / 末五碼</th>
                            <th>剩餘可退堂數</th>
                            <th>匯款憑證附件</th>
                            <th>登錄老師</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.RecentTopUps)
                        {
                            <tr>
                                <td data-label="批次編號">#@t.Id</td>
                                <td data-label="學生"><strong>@t.Student?.FullName</strong></td>
                                <td data-label="金額 / 堂數">NT$@t.AmountNtd.ToString("N0") / +@t.CreditsAdded 堂 (單價 $@t.UnitPriceNtd.ToString("N0"))</td>
                                <td data-label="匯款日 / 末五碼">@t.RemittanceDate.ToString("yyyy-MM-dd") / <code>@t.AccountLastFiveDigits</code></td>
                                <td data-label="剩餘可退堂數">@t.RemainingPaidCredits 堂</td>
                                <td data-label="匯款憑證">
                                    @if (t.AttachmentId.HasValue && t.Attachment != null && !t.Attachment.IsDeleted)
                                    {
                                        <a href="/attachments/@t.AttachmentId" target="_blank" class="btn btn-sm btn-outline-secondary py-1">
                                            <i class="bi bi-file-earmark-image me-1"></i>檢視憑證 (@t.Attachment.OriginalFileName)
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">無附件</span>
                                    }
                                </td>
                                <td data-label="登錄老師" class="small">@t.RecordedByTeacher?.DisplayName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 分頁三：時段排課與老師代學生預約（按鈕彈窗 + 篩選列表 + 10筆分頁 + 修改刪除） -->
    <div class="tab-pane fade" id="tab-teacher-slots" role="tabpanel">
        <div class="card-plato p-3 p-md-4 mb-4">
            <!-- 頂部功能列：按鈕彈窗開啟與標題 -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
                <div>
                    <h2 class="h5 fw-bold mb-1"><i class="bi bi-calendar-week me-2 text-primary"></i>時段排課與名額管理</h2>
                    <div class="small text-muted">點選按鈕以彈跳視窗建立時段或代約；下方列表支援日期區間與輔導類型篩選</div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-primary fw-semibold" data-bs-toggle="modal" data-bs-target="#modalCreateSlot">
                        <i class="bi bi-calendar-plus me-1"></i>建立輔導時段
                    </button>
                    <button type="button" class="btn btn-accent fw-semibold" data-bs-toggle="modal" data-bs-target="#modalProxyBook">
                        <i class="bi bi-person-plus-fill me-1"></i>老師代學生預約
                    </button>
                </div>
            </div>

            <!-- 篩選條件表單：上課日期區間與輔導類型 -->
            <form method="get" class="card-plato p-3 bg-light border mb-4">
                <input type="hidden" name="SlotsPage" value="1" />
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-sm-6 col-md-3">
                        <label class="form-label small fw-bold text-secondary mb-1">上課開始日期</label>
                        <input type="date" name="DateFrom" class="form-control form-control-sm" value="@Model.DateFrom" />
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <label class="form-label small fw-bold text-secondary mb-1">上課結束日期</label>
                        <input type="date" name="DateTo" class="form-control form-control-sm" value="@Model.DateTo" />
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <label class="form-label small fw-bold text-secondary mb-1">輔導類型</label>
                        <select name="SlotTypeFilter" class="form-select form-select-sm">
                            <option value="">全部類型</option>
                            <option value="SmallGroup" selected="@(Model.SlotTypeFilter == SlotType.SmallGroup)">小組指導（扣 1 堂）</option>
                            <option value="GroupCounseling" selected="@(Model.SlotTypeFilter == SlotType.GroupCounseling)">團體輔導（免費 0 堂）</option>
                        </select>
                    </div>
                    <div class="col-12 col-sm-6 col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-dark btn-sm fw-semibold w-100">
                            <i class="bi bi-search me-1"></i>篩選時段
                        </button>
                        <a href="/Teacher#tab-teacher-slots" class="btn btn-outline-secondary btn-sm text-nowrap">
                            清除重設
                        </a>
                    </div>
                </div>
            </form>

            <!-- 輔導時段列表（10筆為一頁） -->
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small fw-bold text-secondary">
                    <i class="bi bi-list-ul me-1"></i>時段列表（共 @Model.SlotsTotalCount 場，第 @Model.SlotsPage / @Model.SlotsTotalPages 頁）
                </span>
            </div>

            @if (!Model.PagedSlots.Any())
            {
                <div class="text-muted small py-5 text-center bg-light rounded-3 border">
                    <i class="bi bi-calendar-x fs-3 d-block mb-2 text-secondary"></i>
                    尚無符合條件的輔導時段。您可點選上方「建立輔導時段」新增排課。
                </div>
            }
            else
            {
                <div class="table-responsive bg-white rounded-3 border shadow-sm mb-3">
                    <table class="table table-hover align-middle table-plato table-responsive-cards mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>上課時間 (台北時間)</th>
                                <th>課程進度</th>
                                <th>適用班別</th>
                                <th>輔導類型</th>
                                <th>預約名額</th>
                                <th>考前加開 / 備註</th>
                                <th class="text-end">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.PagedSlots)
                            {
                                var stTpe = BookingService.ToTaipeiTime(s.StartsAtUtc);
                                var edTpe = BookingService.ToTaipeiTime(s.EndsAtUtc);
                                var dayZh = "日一二三四五六"[(int)stTpe.DayOfWeek];
                                var durationMin = (int)(s.EndsAtUtc - s.StartsAtUtc).TotalMinutes;

                                <tr>
                                    <td data-label="上課時間">
                                        <div class="fw-bold">@stTpe.ToString("yyyy/MM/dd") (@dayZh)</div>
                                        <div class="small text-muted">@stTpe.ToString("HH:mm") – @edTpe.ToString("HH:mm") (@(durationMin)分鐘)</div>
                                    </td>
                                    <td data-label="課程進度">
                                        <strong>@s.CourseProgress?.Code</strong>
                                        <div class="small text-muted text-truncate" style="max-width: 180px;">@s.CourseProgress?.Title</div>
                                    </td>
                                    <td data-label="適用班別">
                                        <span class="badge bg-light text-dark border">@s.GradeClass</span>
                                    </td>
                                    <td data-label="輔導類型">
                                        <span class="badge @(s.SlotType == SlotType.SmallGroup ? "badge-slot-small" : "badge-slot-group")">
                                            @(s.SlotType == SlotType.SmallGroup ? "小組指導" : "團體輔導")
                                        </span>
                                    </td>
                                    <td data-label="預約名額">
                                        <span class="fw-bold @(s.RemainingSeats > 0 ? "text-success" : "text-danger")">
                                            @s.CurrentBookedCount / @s.MaxCapacity
                                        </span>
                                        <span class="small text-muted">（餘 @s.RemainingSeats 名）</span>
                                    </td>
                                    <td data-label="備註">
                                        @if (s.IsExtraSlot)
                                        {
                                            <span class="badge bg-warning text-dark me-1">考前加開</span>
                                        }
                                        <span class="small text-secondary">@(!string.IsNullOrWhiteSpace(s.Notes) ? s.Notes : "無備註")</span>
                                    </td>
                                    <td data-label="操作" class="text-end text-nowrap">
                                        <!-- 修改按鈕（打開 Modal） -->
                                        <button type="button" class="btn btn-sm btn-outline-primary py-1 px-2"
                                                onclick="openEditSlotModal(@s.Id, @s.CourseProgressId, '@s.GradeClass', '@s.SlotType', '@stTpe.ToString("yyyy-MM-dd")', '@stTpe.ToString("HH:mm")', @durationMin, @s.MaxCapacity, @(s.IsExtraSlot ? "true" : "false"), '@(s.Notes?.Replace("'", "\\'"))')">
                                            <i class="bi bi-pencil-square me-1"></i>修改
                                        </button>

                                        <!-- 刪除按鈕 -->
                                        <form method="post" asp-page-handler="DeleteSlot" class="d-inline"
                                              onsubmit="return confirm('確定要刪除時段 #@s.Id (@stTpe.ToString("MM/dd HH:mm")) 嗎？若已有學生預約將會被防護阻擋。');">
                                            <input type="hidden" name="slotId" value="@s.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2 ms-1">
                                                <i class="bi bi-trash me-1"></i>刪除
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- 分頁按鈕列（10筆為一頁） -->
                @if (Model.SlotsTotalPages > 1)
                {
                    <nav aria-label="時段列表分頁" class="d-flex justify-content-center">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.SlotsPage <= 1 ? "disabled" : "")">
                                <a class="page-link" href="/Teacher?DateFrom=@Model.DateFrom&DateTo=@Model.DateTo&SlotTypeFilter=@Model.SlotTypeFilter&SlotsPage=@(Model.SlotsPage - 1)#tab-teacher-slots">上一頁</a>
                            </li>
                            @for (int p = 1; p <= Model.SlotsTotalPages; p++)
                            {
                                <li class="page-item @(Model.SlotsPage == p ? "active" : "")">
                                    <a class="page-link" href="/Teacher?DateFrom=@Model.DateFrom&DateTo=@Model.DateTo&SlotTypeFilter=@Model.SlotTypeFilter&SlotsPage=@p#tab-teacher-slots">@p</a>
                                </li>
                            }
                            <li class="page-item @(Model.SlotsPage >= Model.SlotsTotalPages ? "disabled" : "")">
                                <a class="page-link" href="/Teacher?DateFrom=@Model.DateFrom&DateTo=@Model.DateTo&SlotTypeFilter=@Model.SlotTypeFilter&SlotsPage=@(Model.SlotsPage + 1)#tab-teacher-slots">下一頁</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>

    <!-- 分頁四：作業追蹤與 LINE 催促通知 -->
    <div class="tab-pane fade" id="tab-teacher-homework" role="tabpanel">
        <div class="row g-4">
            <div class="col-12 col-xl-5">
                <div class="card-plato p-3 p-md-4 h-100">
                    <div class="section-header-clean">
                        <div class="section-header-title">
                            <span class="metric-icon-box"><i class="bi bi-exclamation-octagon-fill"></i></span>
                            <div>
                                <h2 class="h5 fw-bold mb-0">勾選作業不佳學生</h2>
                                <div class="small text-muted">勾選後立即發送 LINE 通知家長預約；48 小時未預約自動二次催促</div>
                            </div>
                        </div>
                    </div>
                    <form method="post" asp-page-handler="FlagHomework">
                        <!-- 學生條件篩選：學校、年別、班級 -->
                        <div class="p-3 bg-light rounded-3 border mb-3">
                            <div class="small fw-bold text-dark mb-2">
                                <i class="bi bi-funnel-fill text-primary me-1"></i>依條件篩選學生名單
                            </div>
                            <div class="row g-2">
                                <div class="col-12 col-sm-4">
                                    <label class="form-label small text-secondary mb-1">學校</label>
                                    <select id="filterHwSchool" class="form-select form-select-sm" onchange="onHwSchoolChange()">
                                        <option value="">全部學校</option>
                                        @foreach (var sch in Model.SchoolOptions)
                                        {
                                            <option value="@sch.Value">@sch.Value</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12 col-sm-4">
                                    <label class="form-label small text-secondary mb-1">年別</label>
                                    <select id="filterHwGrade" class="form-select form-select-sm" onchange="filterHwStudents()">
                                        <option value="">全部年別</option>
                                        @foreach (var grd in Model.GradeOptions)
                                        {
                                            <option value="@grd.Value">@grd.Value</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12 col-sm-4">
                                    <label class="form-label small text-secondary mb-1">班級</label>
                                    <select id="filterHwClass" class="form-select form-select-sm" onchange="filterHwStudents()">
                                        <option value="">全部班級</option>
                                        @foreach (var cls in Model.ClassOptions)
                                        {
                                            <option value="@cls.Value" data-parent="@(cls.ParentValue ?? "")">@cls.Value</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label fw-semibold mb-0" for="hwStudent">選擇學生</label>
                                <span class="small text-muted" id="hwStudentCountBadge">共 @Model.ActiveStudents.Count 位</span>
                            </div>
                            <select id="hwStudent" name="studentId" class="form-select" required>
                                @foreach (var s in Model.ActiveStudents)
                                {
                                    <option value="@s.Id"
                                            data-school="@(s.School ?? "")"
                                            data-grade="@(s.Grade ?? "")"
                                            data-classname="@(s.ClassName ?? "")"
                                            data-gradeclass="@s.GradeClass">
                                        @s.FullName (@s.DisplaySchoolGradeClass)
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="hwProgress">課程進度</label>
                            <select id="hwProgress" name="courseProgressId" class="form-select" required>
                                @foreach (var p in Model.ProgressList)
                                {
                                    <option value="@p.Id">@p.Code @p.Title</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold" for="subjectNote">作業狀況說明</label>
                            <input type="text" id="subjectNote" name="subjectNote" class="form-control"
                                   placeholder="例如：第7週隨堂考與講義訂正未完成，請預約輔導" required />
                        </div>
                        <button type="submit" class="btn btn-accent w-100">
                            <i class="bi bi-send-fill me-1"></i>發送作業不佳 LINE 通知
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-12 col-xl-7">
                <div class="card-plato p-3 p-md-4 h-100">
                    <div class="section-header-clean">
                        <div class="section-header-title">
                            <span class="metric-icon-box sage"><i class="bi bi-list-stars"></i></span>
                            <div>
                                <h2 class="h5 fw-bold mb-0">近期作業追蹤與預約解決狀態</h2>
                                <div class="small text-muted">家長完成同進度輔導預約後，系統會自動標記為已預約解決</div>
                            </div>
                        </div>
                    </div>
                    <div class="d-grid gap-2">
                        @foreach (var hw in Model.HomeworkItems)
                        {
                            <div class="p-3 border rounded-3 bg-light d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <div class="fw-bold">
                                        @hw.Student?.FullName
                                        <span class="badge bg-secondary ms-1">@hw.CourseProgress?.Code</span>
                                    </div>
                                    <div class="small text-secondary mt-1">@hw.SubjectNote</div>
                                </div>
                                <span class="badge @(hw.IsResolvedByBooking ? "bg-success" : hw.IsSecondReminderFlagged ? "bg-danger" : "bg-warning text-dark") px-3 py-2">
                                    @(hw.IsResolvedByBooking ? "已預約解決" : hw.IsSecondReminderFlagged ? "48h二次催促" : "待家長預約")
                                </span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal 1: 建立輔導時段 -->
<div class="modal fade" id="modalCreateSlot" tabindex="-1" aria-labelledby="modalCreateSlotLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="modalCreateSlotLabel">
                    <i class="bi bi-calendar-plus me-1 text-primary"></i>建立輔導時段
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="CreateSlot" id="formCreateSlot" onsubmit="return validateCreateSlotForm(event);">
                <div class="modal-body p-4">
                    <div id="createSlotErrorAlert" class="alert alert-danger py-2 px-3 small d-none mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i><span id="createSlotErrorText">請至少勾選一個「所屬課程進度」。</span>
                    </div>

                    <!-- 所屬課程進度多選（過濾結束日期未到之課程進度） -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-collection me-1 text-primary"></i>所屬課程進度（可多選批次建立時段，結束日期未到之課程）
                        </label>
                        <div class="border rounded-3 p-3 bg-light" style="max-height: 180px; overflow-y: auto;">
                            @if (Model.ProgressList.Count == 0)
                            {
                                <div class="text-muted small">目前無有效之課程進度。</div>
                            }
                            else
                            {
                                @foreach (var p in Model.ProgressList)
                                {
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" name="courseProgressIds" value="@p.Id" id="createProg_@p.Id" />
                                        <label class="form-check-label d-flex align-items-center justify-content-between" for="createProg_@p.Id">
                                            <span>
                                                <strong class="text-dark">@p.Code</strong> @p.Title
                                                @if (p.IsCurrentProgress)
                                                {
                                                    <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle ms-1">目前進度</span>
                                                }
                                            </span>
                                            <span class="text-muted small">
                                                @(p.WeekStartDate.ToString("MM/dd")) ～ @(p.WeekEndDate.ToString("MM/dd"))
                                            </span>
                                        </label>
                                    </div>
                                }
                            }
                        </div>
                        <div class="form-text">可同時勾選多個課程進度，系統將自動為每個選定進度各建立一筆該時段之輔導課堂。</div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-6">
                            <label class="form-label fw-semibold" for="createSlotType">輔導類型</label>
                            <select id="createSlotType" name="slotType" class="form-select" onchange="updateCreateSlotCapacityDisplay(this.value)">
                                <option value="SmallGroup">小組指導（扣 1 堂）</option>
                                <option value="GroupCounseling">團體輔導（免費 0 堂）</option>
                            </select>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="form-label fw-semibold" for="createSlotGrade">適用年別</label>
                            <select id="createSlotGrade" name="grade" class="form-select" required>
                                @foreach (var g in Model.GradeOptions)
                                {
                                    <option value="@g.Value">@g.Value</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-6">
                            <label class="form-label fw-semibold" for="createSlotDate">上課日期</label>
                            <input type="date" id="createSlotDate" name="slotDate" class="form-control"
                                   value="@DateTime.UtcNow.AddDays(3).ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="form-label fw-semibold" for="createStartTime">開始時間 (台北時間)</label>
                            <input type="time" id="createStartTime" name="startTime" class="form-control" value="18:30" required />
                        </div>
                    </div>

                    <!-- 時長與容納名額純文字唯讀顯示（固定 2 小時，名額依類型調整） -->
                    <div class="row g-3 mb-3 p-3 bg-light rounded-3">
                        <div class="col-12 col-sm-6">
                            <div class="text-muted small fw-semibold">輔導時長（固定）</div>
                            <div class="fs-6 fw-bold text-dark pt-1">
                                <i class="bi bi-clock me-1 text-primary"></i>2 小時 (120 分鐘)
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <div class="text-muted small fw-semibold">容納名額（依類型自動設定）</div>
                            <div class="fs-6 fw-bold text-dark pt-1" id="createCapacityDisplay">
                                <i class="bi bi-people me-1 text-success"></i>4 人 (小組指導)
                            </div>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-semibold" for="createSlotNotes">時段備註 (選填)</label>
                        <input type="text" id="createSlotNotes" name="notes" class="form-control" placeholder="例如：二次函數重點加強" />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary fw-semibold">
                        <i class="bi bi-plus-circle me-1"></i>確認建立時段
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 2: 老師代學生預約 -->
<div class="modal fade" id="modalProxyBook" tabindex="-1" aria-labelledby="modalProxyBookLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="modalProxyBookLabel">
                    <i class="bi bi-person-plus-fill me-1 text-accent"></i>老師代學生預約
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="ProxyBook">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="modalProxyStudent">選擇學生</label>
                        <select id="modalProxyStudent" name="studentId" class="form-select" required>
                            @foreach (var s in Model.ActiveStudents)
                            {
                                <option value="@s.Id">@s.FullName (@s.GradeClass) － 可用:@s.TotalCredits 堂 (付費:@s.PaidCredits / 贈送:@s.BonusCredits)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="modalProxySlot">可預約時段</label>
                        <select id="modalProxySlot" name="slotId" class="form-select" required>
                            @foreach (var sl in Model.Slots.Where(x => x.RemainingSeats > 0))
                            {
                                var tpe = BookingService.ToTaipeiTime(sl.StartsAtUtc);
                                var dayZh = "日一二三四五六"[(int)tpe.DayOfWeek];
                                <option value="@sl.Id">
                                    @tpe.ToString("yyyy/MM/dd") (@dayZh) @tpe.ToString("HH:mm") @sl.CourseProgress?.Code (@(sl.SlotType == SlotType.SmallGroup ? "小組扣1堂" : "團體免費")) 剩餘 @sl.RemainingSeats 名
                                </option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="modalProxyPurpose">到班目的</label>
                        <select id="modalProxyPurpose" name="purposeName" class="form-select" required>
                            @foreach (var p in Model.PurposeOptions)
                            {
                                <option value="@p.Name">@p.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2 p-3 bg-light rounded-3 border">
                        <input type="hidden" id="waiveCreditDeductionInput" name="waiveCreditDeduction" value="false" />
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" id="proxyWaiveSwitch" onchange="document.getElementById('waiveCreditDeductionInput').value = this.checked ? 'true' : 'false';">
