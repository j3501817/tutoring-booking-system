<!-- 全螢幕儲存等待中畫面（鎖定禁止任何操作） -->
<div id="savingOverlay" class="saving-overlay d-none">
    <div class="saving-overlay-content">
        <div class="spinner-border text-light mb-3" style="width: 3.2rem; height: 3.2rem;" role="status">
            <span class="visually-hidden">儲存中...</span>
        </div>
        <h4 class="text-white fw-bold mb-1">資料儲存處理中，請稍候...</h4>
        <p class="text-white-50 small mb-0">系統正在寫入點名、計算扣堂與不可覆寫流水帳，請勿關閉視窗</p>
    </div>
</div>

@section Scripts {
    <script>
        function previewRemittanceImage(input) {
            const box = document.getElementById('attachmentPreviewBox');
            const img = document.getElementById('attachmentPreviewImg');
            if (input.files && input.files[0] && input.files[0].type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    img.src = e.target.result;
                    box.classList.remove('d-none');
                };
                reader.readAsDataURL(input.files[0]);
            } else {
                box.classList.add('d-none');
            }
        }

        // 顯示全螢幕儲存等待畫面
        function showSavingOverlay() {
            const overlay = document.getElementById('savingOverlay');
            if (overlay) {
                overlay.classList.remove('d-none');
            }
        }

        // 單筆點名儲存
        function saveSingleAttendance(bookingId, defaultFinalize) {
            const selectEl = document.getElementById('status_select_' + bookingId);
            const status = selectEl ? selectEl.value : 'Present';
            const finBatchCheckbox = document.getElementById('batchFinalizeSlot');
            const isFin = finBatchCheckbox ? finBatchCheckbox.checked : defaultFinalize;

            document.getElementById('singleBookingId').value = bookingId;
            document.getElementById('singleAttendanceStatus').value = status;
            document.getElementById('singleFinalizeSlot').value = isFin ? 'true' : 'false';

            showSavingOverlay();
            document.getElementById('singleRollcallForm').submit();
        }

        // 開啟學生儲值登錄彈跳視窗
        function openTopUpModal() {
            filterTopUpModalStudents();
            const modalEl = document.getElementById('modalTopUp');
            if (modalEl) {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        }

        // 儲值彈窗學生依學校、年別、班別獨立篩選
        function filterTopUpModalStudents() {
            const school = (document.getElementById('filterTopUpSchool')?.value || '').trim();
            const grade = (document.getElementById('filterTopUpGrade')?.value || '').trim();
            const cls = (document.getElementById('filterTopUpClass')?.value || '').trim();
            const studentSelect = document.getElementById('topupStudent');
            const emptyHint = document.getElementById('topupStudentEmptyHint');
            if (!studentSelect) return;

            let visibleCount = 0;
            let firstVisibleOpt = null;
            let currentSelectedStillVisible = false;

            for (let i = 0; i < studentSelect.options.length; i++) {
                const opt = studentSelect.options[i];
                const optSchool = (opt.getAttribute('data-school') || '').trim();
                const optGrade = (opt.getAttribute('data-grade') || '').trim();
                const optClass = (opt.getAttribute('data-class') || '').trim();

                const matchSchool = !school || optSchool === school;
                const matchGrade = !grade || optGrade === grade;
                const matchClass = !cls || optClass === cls;

                if (matchSchool && matchGrade && matchClass) {
                    opt.hidden = false;
                    opt.disabled = false;
                    visibleCount++;
                    if (!firstVisibleOpt) firstVisibleOpt = opt;
                    if (opt.value === studentSelect.value) currentSelectedStillVisible = true;
                } else {
                    opt.hidden = true;
                    opt.disabled = true;
                }
            }

            if (!currentSelectedStillVisible && firstVisibleOpt) {
                studentSelect.value = firstVisibleOpt.value;
            }

            if (emptyHint) {
                if (visibleCount === 0) {
                    emptyHint.classList.remove('d-none');
                    studentSelect.classList.add('is-invalid');
                } else {
                    emptyHint.classList.add('d-none');
                    studentSelect.classList.remove('is-invalid');
                }
            }
        }

        // 開啟堂數調整彈跳視窗
        function openAdjustCreditsModal() {
            filterAdjustModalStudents();
            const modalEl = document.getElementById('modalAdjustCredits');
            if (modalEl) {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        }

        // 堂數調整彈窗學生依學校、年別、班別獨立篩選
        function filterAdjustModalStudents() {
            const school = (document.getElementById('filterAdjSchool')?.value || '').trim();
            const grade = (document.getElementById('filterAdjGrade')?.value || '').trim();
            const cls = (document.getElementById('filterAdjClass')?.value || '').trim();
            const studentSelect = document.getElementById('modalAdjStudent');
            const emptyHint = document.getElementById('modalAdjStudentEmptyHint');
            if (!studentSelect) return;

            let visibleCount = 0;
            let firstVisibleOpt = null;
            let currentSelectedStillVisible = false;

            for (let i = 0; i < studentSelect.options.length; i++) {
                const opt = studentSelect.options[i];
                const optSchool = (opt.getAttribute('data-school') || '').trim();
                const optGrade = (opt.getAttribute('data-grade') || '').trim();
                const optClass = (opt.getAttribute('data-class') || '').trim();

                const matchSchool = !school || optSchool === school;
                const matchGrade = !grade || optGrade === grade;
                const matchClass = !cls || optClass === cls;

                if (matchSchool && matchGrade && matchClass) {
                    opt.hidden = false;
                    opt.disabled = false;
                    visibleCount++;
                    if (!firstVisibleOpt) firstVisibleOpt = opt;
                    if (opt.selected) currentSelectedStillVisible = true;
                } else {
                    opt.hidden = true;
                    opt.disabled = true;
                    if (opt.selected) opt.selected = false;
                }
            }

            if (!currentSelectedStillVisible && firstVisibleOpt) {
                firstVisibleOpt.selected = true;
            }

            if (emptyHint) {
                if (visibleCount === 0) {
                    emptyHint.classList.remove('d-none');
                } else {
                    emptyHint.classList.add('d-none');
                }
            }
        }

        // 建立時段名額即時顯示切換
        function updateCreateSlotCapacityDisplay(slotType) {
            const display = document.getElementById('createCapacityDisplay');
            if (!display) return;
            if (slotType === 'GroupCounseling') {
                display.innerHTML = '<i class="bi bi-people me-1 text-primary"></i>20 人 (團體輔導)';
            } else {
                display.innerHTML = '<i class="bi bi-people me-1 text-success"></i>4 人 (小組指導)';
            }
        }

        // 開啟修改時段 Modal 並填入資料
        function openEditSlotModal(id, progressId, gradeClass, slotType, dateStr, timeStr, duration, capacity, isExtra, notes) {
            document.getElementById('editSlotId').value = id;
            document.getElementById('editSlotProgress').value = progressId;
            document.getElementById('editSlotGradeClass').value = gradeClass;
            document.getElementById('editSlotType').value = slotType;
            document.getElementById('editSlotDate').value = dateStr;
            document.getElementById('editStartTime').value = timeStr;
            document.getElementById('editDurationMinutes').value = duration;
            document.getElementById('editMaxCapacity').value = capacity;
            document.getElementById('editIsExtraSlot').checked = isExtra;
            document.getElementById('editSlotNotes').value = notes || '';

            const modal = new bootstrap.Modal(document.getElementById('modalEditSlot'));
            modal.show();
        }

        // 學校連動班級下拉選單
        function onHwSchoolChange() {
            const school = (document.getElementById('filterHwSchool') ? document.getElementById('filterHwSchool').value : '').trim();
            const classSelect = document.getElementById('filterHwClass');
            if (classSelect) {
                const options = classSelect.querySelectorAll('option');
                let currentValStillValid = false;
                options.forEach(opt => {
                    if (!opt.value) {
                        opt.hidden = false;
                        return;
                    }
                    const parent = (opt.getAttribute('data-parent') || '').trim();
                    if (!school || !parent || parent === school) {
                        opt.hidden = false;
                        if (opt.value === classSelect.value) {
                            currentValStillValid = true;
                        }
                    } else {
                        opt.hidden = true;
                    }
                });
                if (!currentValStillValid && classSelect.value !== '') {
                    classSelect.value = '';
                }
            }
            filterHwStudents();
        }

        // 作業不佳學生清單篩選
        function filterHwStudents() {
            const school = (document.getElementById('filterHwSchool') ? document.getElementById('filterHwSchool').value : '').trim();
            const grade = (document.getElementById('filterHwGrade') ? document.getElementById('filterHwGrade').value : '').trim();
            const cls = (document.getElementById('filterHwClass') ? document.getElementById('filterHwClass').value : '').trim();
            const studentSelect = document.getElementById('hwStudent');
            const badge = document.getElementById('hwStudentCountBadge');

            if (!studentSelect) return;

            let visibleCount = 0;
            let firstVisibleOpt = null;
            let selectedOptIsVisible = false;

            for (let i = 0; i < studentSelect.options.length; i++) {
                const opt = studentSelect.options[i];
                if (!opt.value) continue;

                const optSchool = (opt.getAttribute('data-school') || '').trim();
                const optGrade = (opt.getAttribute('data-grade') || '').trim();
                const optClass = (opt.getAttribute('data-classname') || '').trim();
                const optGradeClass = (opt.getAttribute('data-gradeclass') || '').trim();

                const matchSchool = !school || optSchool === school || optGradeClass.includes(school);
                const matchGrade = !grade || optGrade === grade || optGradeClass.includes(grade);
                const matchClass = !cls || optClass === cls || optGradeClass.includes(cls);

                if (matchSchool && matchGrade && matchClass) {
                    opt.hidden = false;
                    opt.disabled = false;
                    visibleCount++;
                    if (!firstVisibleOpt) firstVisibleOpt = opt;
                    if (opt.selected) selectedOptIsVisible = true;
                } else {
                    opt.hidden = true;
                    opt.disabled = true;
                    if (opt.selected) opt.selected = false;
                }
            }

            if (!selectedOptIsVisible && firstVisibleOpt) {
                firstVisibleOpt.selected = true;
            }

            if (badge) {
                badge.textContent = `符合條件：${visibleCount} 位`;
            }
        }

        // 建立時段表單防呆驗證：未勾選課程進度時在彈跳視窗內提示，不關閉視窗
        function validateCreateSlotForm(e) {
            const checkedCount = document.querySelectorAll('#modalCreateSlot input[name="courseProgressIds"]:checked').length;
            const alertBox = document.getElementById('createSlotErrorAlert');
            const alertText = document.getElementById('createSlotErrorText');

            if (checkedCount === 0) {
                if (alertBox) {
                    if (alertText) alertText.textContent = '請至少勾選一個「所屬課程進度」。';
                    alertBox.classList.remove('d-none');
                    alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }
                if (e) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                return false;
            }

            if (alertBox) {
                alertBox.classList.add('d-none');
            }
            return true;
        }

        // 頁籤狀態保存
        document.addEventListener('DOMContentLoaded', function () {
            onHwSchoolChange();

            // 監聽課程進度勾選變更，勾選後自動隱藏錯誤提示
            const progressCheckboxes = document.querySelectorAll('#modalCreateSlot input[name="courseProgressIds"]');
            progressCheckboxes.forEach(cb => {
                cb.addEventListener('change', function () {
                    const checkedCount = document.querySelectorAll('#modalCreateSlot input[name="courseProgressIds"]:checked').length;
                    const alertBox = document.getElementById('createSlotErrorAlert');
                    if (alertBox && checkedCount > 0) {
                        alertBox.classList.add('d-none');
                    }
                });
            });

            // modal 打開時重設錯誤提示
            const modalEl = document.getElementById('modalCreateSlot');
            if (modalEl) {
                modalEl.addEventListener('show.bs.modal', function () {
                    const alertBox = document.getElementById('createSlotErrorAlert');
                    if (alertBox) alertBox.classList.add('d-none');
                });
            }

            const hash = window.location.hash;
            if (hash) {
                const targetBtn = document.querySelector(`#teacherWorkspaceTabs button[data-bs-target="${hash}"]`);
                if (targetBtn) {
                    const tab = new bootstrap.Tab(targetBtn);
                    tab.show();
                }
            }

            const tabButtons = document.querySelectorAll('#teacherWorkspaceTabs button[data-bs-toggle="pill"]');
            tabButtons.forEach(btn => {
                btn.addEventListener('shown.bs.tab', function (e) {
                    const target = e.target.getAttribute('data-bs-target');
                    if (target) {
                        history.replaceState(null, null, target);
                    }
                });
            });
        });
    </script>
}

