                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-muted mb-1">年別篩選</label>
                                <select id="filterTopUpGrade" class="form-select form-select-sm" onchange="filterTopUpModalStudents()">
                                    <option value="">全部年別</option>
                                    @foreach (var g in Model.GradeOptions)
                                    {
