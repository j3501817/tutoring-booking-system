@page
@model PlatoTutoring.Web.Pages.Parent.IndexModel
@{
    ViewData["Title"] = "家長預約與堂數中心";
    var student = Model.SelectedStudent;
    var isEnrollmentBlocked = student != null && (student.IsDroppedOut || student.EnrollmentStatus != StudentEnrollmentStatus.Enrolled);
    var enrollmentStatusDesc = student == null ? "" : (student.EnrollmentStatus == StudentEnrollmentStatus.Unrenewed ? "本學期尚未完成續報" : (student.IsDroppedOut || student.EnrollmentStatus == StudentEnrollmentStatus.DroppedOut) ? "已辦理退班" : "非本學期在學");
}

<!-- 頂部一體化控制條：整合孩子切換、可用堂數、LINE 綁定與教務模式 -->
<div class="card-plato p-3 mb-3 shadow-sm" style="background: linear-gradient(135deg, #ffffff 0%, #fcfbf9 100%); border-left: 4px solid var(--plato-terracotta);">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2 gap-lg-3">
        <!-- 學生資訊與切換（在手機上維持同行緊湊對齊） -->
        <div class="d-flex align-items-center justify-content-between justify-content-lg-start gap-2 flex-wrap">
            <div class="d-flex align-items-center gap-2 flex-grow-1 flex-lg-grow-0">
                <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm"
                     style="width: 38px; height: 38px; background: var(--plato-terracotta); font-size: 1rem; flex-shrink: 0;">
                    @(student?.FullName.Substring(0, 1) ?? "生")
                </div>
                @if (Model.AuthorizedStudents.Count > 1)
                {
                    <div class="input-group input-group-sm" style="max-width: 280px;">
                        <span class="input-group-text bg-white fw-semibold text-secondary px-2">
                            <i class="bi bi-people-fill me-1"></i>孩子
                        </span>
                        <select class="form-select form-select-sm fw-bold text-dark border-secondary-subtle"
                                onchange="if(this.value) window.location.href='/Parent/Index?studentId=' + this.value + (window.location.hash || '#tab-parent-book');">
                            @foreach (var s in Model.AuthorizedStudents)
                            {
                                <option value="@s.Id" selected="@(student?.Id == s.Id)">@s.FullName (@s.DisplaySchoolGradeClass)</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="fs-5 fw-bold text-dark">@student?.FullName</span>
                        <span class="badge bg-secondary-subtle text-secondary border">@student?.DisplaySchoolGradeClass</span>
                    </div>
                }
            </div>

            <div class="d-flex align-items-center gap-1">
                @if (student != null)
                {
                    @if (student.EnrollmentStatus == StudentEnrollmentStatus.Enrolled)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle py-1 px-2">在學</span>
                    }
                    else if (student.EnrollmentStatus == StudentEnrollmentStatus.Unrenewed)
                    {
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle py-1 px-2">⚠️ 未續報</span>
                    }
                    else if (student.EnrollmentStatus == StudentEnrollmentStatus.DroppedOut || student.IsDroppedOut)
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle py-1 px-2">❌ 已退班</span>
                    }
                }

                @if (Model.CurrentUser.Role != UserRole.Parent)
                {
                    <span class="badge bg-secondary py-1 px-2">教務模式</span>
                }
            </div>
        </div>

        <!-- 堂數與 LINE 通知緊湊膠囊列 -->
        <div class="d-flex align-items-center justify-content-between justify-content-lg-end gap-2 flex-wrap pt-1 pt-lg-0 border-top border-lg-0">
            @if (student != null)
            {
                <div class="d-flex align-items-center gap-1 gap-sm-2 bg-light py-1 px-2 px-sm-3 rounded-pill border">
                    <i class="bi bi-wallet2 text-primary"></i>
                    <span class="small text-muted">可用堂數：</span>
                    <strong class="fs-5" style="color: var(--plato-terracotta-dark); line-height: 1;">@student.TotalCredits</strong>
                    <span class="small text-muted">堂</span>
                    <span class="badge bg-white text-secondary border py-1 px-2 fw-normal" style="font-size: 0.72rem;">
                        儲值 @student.PaidCredits｜贈送 @student.BonusCredits
                    </span>
                </div>
            }

            @if (string.IsNullOrWhiteSpace(Model.CurrentUser.LineUserId))
            {
                <a href="/LineAuth/Login?returnUrl=@Url.Page("/Parent", null, new { studentId = student?.Id })"
                   class="btn btn-sm text-white fw-semibold rounded-pill px-3 shadow-sm d-inline-flex align-items-center"
                   style="background-color: #06c755; border-color: #06c755;" title="綁定 LINE 官方帳號接收即時通知">
                    <i class="bi bi-line me-1"></i>綁定 LINE
                </a>
            }
            else
            {
                <div class="d-inline-flex align-items-center gap-1 bg-white py-1 px-2 rounded-pill border small text-success fw-semibold">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>LINE 已綁定</span>
                </div>
            }
        </div>
    </div>
</div>

@if (student != null)
{
    <!-- 作業不佳催促提醒橫幅（僅在有作業提醒時精巧呈現） -->
    @if (Model.OpenHomeworkItems.Any())
    {
        <div class="alert alert-warning border-0 shadow-sm mb-3 p-3" role="alert">
            <div class="d-flex align-items-start gap-2">
                <i class="bi bi-bell-fill fs-5 text-warning-emphasis"></i>
                <div class="w-100">
                    <div class="fw-bold mb-1">老師作業加強提醒（請儘速為 @student.FullName 預約輔導時段）：</div>
                    <ul class="mb-0 ps-3 small">
                        @foreach (var hw in Model.OpenHomeworkItems)
                        {
                            <li class="mb-1">
                                <strong>@hw.CourseProgress?.Title：</strong>@hw.SubjectNote
                                <span class="text-muted">（通知時間：@BookingService.FormatTaipeiShortDateZh(hw.FirstNotifiedAtUtc)）</span>
                                @if (hw.IsSecondReminderFlagged)
                                {
                                    <span class="badge bg-danger ms-1">已逾 48 小時二次催促</span>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }


    <!-- 三等分工作區導覽頁籤 (手機與桌機皆維持整齊單排三等分) -->
    <div class="mb-3">
        <ul class="nav nav-pills parent-tabs-shell" id="parentWorkspaceTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="btn-parent-book" data-bs-toggle="pill"
                        data-bs-target="#tab-parent-book" type="button" role="tab">
                    <span class="parent-tab-top-row">
                        <i class="bi bi-calendar-week"></i>
                    </span>
                    <span class="parent-tab-label">線上預約</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="btn-parent-records" data-bs-toggle="pill"
                        data-bs-target="#tab-parent-records" type="button" role="tab">
                    <span class="parent-tab-top-row">
                        <i class="bi bi-list-check"></i>
                        <span class="workspace-tab-count">@(Model.StudentBookings.Count(b => b.Status == BookingStatus.Confirmed) + Model.StudentWaitlistEntries.Count(w => w.Status == WaitlistStatus.Waiting || w.Status == WaitlistStatus.NotifiedHold))</span>
                    </span>
                    <span class="parent-tab-label">預約與候補</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="btn-parent-ledger" data-bs-toggle="pill"
                        data-bs-target="#tab-parent-ledger" type="button" role="tab">
                    <span class="parent-tab-top-row">
                        <i class="bi bi-journal-text"></i>
                        <span class="workspace-tab-count">@Model.StudentLedgerEntries.Count</span>
                    </span>
                    <span class="parent-tab-label">堂數異動</span>
                </button>
            </li>
        </ul>
    </div>

    <div class="tab-content" id="parentWorkspaceTabContent">
        <!-- 分頁一：線上預約時段（先顯示 7 日曆，點日期之後展開當天課堂列表） -->
        <div class="tab-pane fade show active" id="tab-parent-book" role="tabpanel">
            
            <!-- 7 日預約日曆卡片 (專為手機與桌機優化，支援往後七天與往前七天導覽，往前只到今天為止) -->
            <div class="booking-month-calendar card-plato p-3 p-md-4 mb-4 shadow-sm">
                <!-- 第一層：標題與週期預約按鈕 -->
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                    <h2 class="h5 fw-bold mb-0 text-dark d-flex align-items-center">
                        <i class="bi bi-calendar-week text-primary me-2"></i>課堂預約行事曆
                    </h2>
                    <div>
                        @if (isEnrollmentBlocked)
                        {
                            <button type="button"
                                    class="btn btn-sm btn-primary fw-bold rounded-pill px-3"
                                    onclick="showEnrollmentBlockedModal('@student?.FullName', '該學生@(enrollmentStatusDesc)，暫無法預約課堂；請洽班主任辦理學期續報。')">
                                <i class="bi bi-arrow-repeat me-1"></i>週期預約
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-sm btn-primary fw-bold rounded-pill px-3"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalRecurringBooking"
                                    onclick="openRecurringBookingModal()">
                                <i class="bi bi-arrow-repeat me-1"></i>週期預約
                            </button>
                        }
                    </div>
                </div>

                <!-- 第二層：滿版三段式週次切換控制條 -->
                <div class="calendar-week-switcher mb-2">
                    @if (Model.CanGoPrevWeek)
                    {
                        <a asp-page="/Parent/Index"
                           asp-route-studentId="@student?.Id"
                           asp-route-startDate="@Model.PrevWeekStartDate?.ToString("yyyy-MM-dd")"
                           asp-fragment="tab-parent-book"
                           class="btn btn-sm btn-white bg-white border shadow-sm d-inline-flex align-items-center fw-semibold px-2 px-sm-3 py-1"
                           title="往前七天（最多至今天）">
                            <i class="bi bi-chevron-left me-1"></i>往前七天
                        </a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm bg-white border d-inline-flex align-items-center px-2 px-sm-3 py-1 disabled opacity-50" disabled title="往前只到今天為止">
                            <i class="bi bi-chevron-left me-1"></i>往前七天
                        </button>
                    }

                    <div class="calendar-week-range-badge">
                        <span>@($"{Model.CurrentStartDate:M/d}") ～ @($"{Model.CurrentEndDate:M/d}")</span>
                        @if (!Model.IsCurrentWeek)
                        {
                            <a asp-page="/Parent/Index"
                               asp-route-studentId="@student?.Id"
                               asp-fragment="tab-parent-book"
                               class="badge bg-dark text-white text-decoration-none px-2 py-1"
                               title="返回今天起算之一週">
                                回本週
                            </a>
                        }
                    </div>

                    <a asp-page="/Parent/Index"
                       asp-route-studentId="@student?.Id"
                       asp-route-startDate="@Model.NextWeekStartDate.ToString("yyyy-MM-dd")"
                       asp-fragment="tab-parent-book"
                       class="btn btn-sm btn-white bg-white border shadow-sm d-inline-flex align-items-center fw-semibold px-2 px-sm-3 py-1"
                       title="往後七天">
                        往後七天<i class="bi bi-chevron-right ms-1"></i>
                    </a>
                </div>

                <!-- 第三層：圖例說明 -->
                <div class="d-flex align-items-center gap-2 flex-wrap small mb-3 pb-2 border-bottom">
                    <span class="text-secondary">標示說明：</span>
                    <span class="badge badge-slot-small"><i class="bi bi-people-fill me-1"></i>小組指導</span>
                    <span class="badge badge-slot-group"><i class="bi bi-collection-fill me-1"></i>團體輔導</span>
                    <span class="badge bg-secondary"><i class="bi bi-moon-stars-fill me-1"></i>休假日</span>
                </div>

                <!-- 第四層：7 天一體化日曆卡片網格（手機版 2x4 滿版矩陣，桌機版 1x7 單排） -->
                <div class="parent-seven-day-grid" id="parentCalendarGrid">
                    @foreach (var cellDate in Model.SevenDays)
                    {
                        var cellDateStr = cellDate.ToString("yyyy-MM-dd");
                        var cellDateDisplayZh = $"{cellDate:yyyy/MM/dd}（週{"日一二三四五六"[(int)cellDate.DayOfWeek]}）";
                        var isWeekend = cellDate.DayOfWeek == DayOfWeek.Saturday || cellDate.DayOfWeek == DayOfWeek.Sunday;
                        var isHoliday = Model.HolidayDates.Contains(cellDate);
                        var holidayName = isHoliday && Model.HolidayNames.TryGetValue(cellDate, out var hn) ? hn : null;
                        CalendarDaySummary? summary = null;
                        var hasSlots = !isHoliday && Model.CalendarDaysSummary.TryGetValue(cellDate, out summary) && summary.TotalSlots > 0;
                        var isSelected = Model.SelectedDate.HasValue && Model.SelectedDate.Value == cellDate;
                        var isToday = cellDate == Model.TodayDate;

                        <div class="calendar-month-cell @(isHoliday ? "is-holiday" : hasSlots ? "has-slots" : "no-slots") @(isSelected ? "selected-day" : "") @(isToday ? "today-cell" : "")"
                             data-date="@cellDateStr"
                             data-date-zh="@cellDateDisplayZh"
                             data-holiday="@(isHoliday ? "true" : "false")"
                             role="button"
                             tabindex="0"
                             aria-label="@(isHoliday ? $"{cellDateDisplayZh} 為機構休假日（{holidayName}）點擊查看詳情" : hasSlots ? $"{cellDateDisplayZh} 有課堂可預約，點擊展開時段列表" : cellDateDisplayZh)"
                             @(isHoliday ? $"onclick=\"showHolidayNoticeModal('{cellDateDisplayZh}', '{Html.Raw(holidayName ?? "機構休假日")}')\"" : hasSlots ? "onclick=\"selectCalendarDate(this.dataset.date, this.dataset.dateZh)\"" : "")>
                            
                            <div>
                                <!-- 卡片頂部：星期幾 + 今天/休假標籤 -->
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="calendar-cell-weekday @(isToday ? "text-primary" : isWeekend ? "weekend" : "")">
                                        週@("日一二三四五六"[(int)cellDate.DayOfWeek])
                                    </span>
                                    @if (isToday)
                                    {
                                        <span class="badge bg-primary text-white p-0 px-1" style="font-size: 0.65rem;">今天</span>
                                    }
                                    else if (isHoliday)
                                    {
                                        <span class="badge bg-danger text-white p-0 px-1" style="font-size: 0.65rem;">休假</span>
                                    }
                                </div>

                                <!-- 卡片中段：醒目月/日數字 -->
                                <div class="calendar-cell-date-main @(isHoliday ? "text-danger" : isToday ? "text-primary" : "")">
                                    @($"{cellDate:M/d}")
                                </div>
                            </div>

                            <!-- 卡片底部：課堂類型徽章或休假/無課堂提示 -->
                            @if (isHoliday)
                            {
                                <div class="calendar-cell-badges d-flex flex-column gap-1">
                                    <span class="badge bg-secondary text-white text-truncate p-1" style="font-size: 0.68rem;" title="節日/休假原因：@holidayName">
                                        🏖️ @(holidayName ?? "休假日")
                                    </span>
                                    <span class="small text-danger fw-semibold text-center" style="font-size: 0.65rem;">
                                        停課不開放
                                    </span>
                                </div>
                            }
                            else if (hasSlots && summary != null)
                            {
                                <div class="calendar-cell-badges d-flex flex-column gap-1">
                                    @foreach (var daySlot in summary.Slots)
                                    {
                                        var slotStartTpe = BookingService.ToTaipeiTime(daySlot.StartsAtUtc);
                                        var slotEndTpe = BookingService.ToTaipeiTime(daySlot.EndsAtUtc);
                                        var slotTimeText = $"{slotStartTpe:HH:mm}-{slotEndTpe:HH:mm}";
                                        var isSmallSlot = daySlot.SlotType == SlotType.SmallGroup;
                                        <span class="badge @(isSmallSlot ? "badge-slot-small" : "badge-slot-group") calendar-slot-time-badge text-truncate"
                                              title="@(isSmallSlot ? "小組指導" : "團體輔導") @slotTimeText（點擊查看課堂）">
                                            @slotTimeText
                                        </span>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="calendar-no-slot-hint">無課堂</div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- 未選擇日期或該週無課堂時的溫馨提示 -->
            <div id="noDateSelectedPrompt" class="@(Model.SelectedDate.HasValue ? "d-none" : "") card-plato p-3 p-md-4 mb-4 text-center bg-white border shadow-sm">
                <i class="bi bi-hand-index-thumb fs-3 text-primary mb-1 d-block"></i>
                <div class="fw-bold text-dark mb-1">請點選上方日曆標示有「課堂時段」的日期</div>
                <div class="small text-secondary">點選日期卡片後，下方將立即展開當日可預約的課堂時段清單；亦可點擊「往後七天」查看後續週次。</div>
            </div>

            <!-- 點日期之後展開：當天課堂列表容器 -->
            <div id="daySlotsContainer" class="@(Model.SelectedDate.HasValue ? "" : "d-none") mb-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 p-3 bg-white rounded-3 border shadow-sm">
                    <div class="d-flex align-items-center gap-2">
                        <span class="metric-icon-box ocean flex-shrink-0"><i class="bi bi-calendar-event"></i></span>
                        <div>
                            <h3 class="h6 fw-bold mb-0 text-dark" id="selectedDateTitle">
                                @(Model.SelectedDate.HasValue ? $"{Model.SelectedDate.Value:yyyy/MM/dd}（週{"日一二三四五六"[(int)Model.SelectedDate.Value.DayOfWeek]}）課堂列表" : "")
                            </h3>
                            <span class="small text-muted" id="selectedDateSubtitle">
                                @(Model.SelectedDate.HasValue ? $"當天共開放 {Model.AvailableSlots.Count} 堂輔導課" : "")
                            </span>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="clearSelectedDate()">
                        <i class="bi bi-x-circle me-1"></i>收合列表
                    </button>
                </div>

                <!-- 當天時段卡片清單（極簡高雅 Row Card） -->
                <div class="d-grid gap-2" id="slotCardsList">
                    @foreach (var slot in Model.AllCurrentSlots)
                    {
                        var startTpe = BookingService.ToTaipeiTime(slot.StartsAtUtc);
                        var endTpe = BookingService.ToTaipeiTime(slot.EndsAtUtc);
                        var slotDateStr = DateOnly.FromDateTime(startTpe).ToString("yyyy-MM-dd");
                        var isFull = slot.RemainingSeats <= 0;
                        var isGroup = slot.SlotType == SlotType.GroupCounseling;

                        // 判斷當前學生是否已預約此時段或同進度其他時段
                        var myBooking = Model.StudentBookings.FirstOrDefault(b => b.TutoringSlotId == slot.Id && b.Status == BookingStatus.Confirmed);
                        var isMyBooked = myBooking != null;
                        var sameProgressOtherBooked = slot.SlotType == SlotType.SmallGroup && Model.StudentBookings.Any(b => b.Status == BookingStatus.Confirmed && b.TutoringSlot?.CourseProgressId == slot.CourseProgressId && b.TutoringSlotId != slot.Id);

                        // 判斷當前學生是否已在候補名單中
                        var myWaitlist = Model.StudentWaitlistEntries.FirstOrDefault(w => w.TutoringSlotId == slot.Id && (w.Status == WaitlistStatus.Waiting || w.Status == WaitlistStatus.NotifiedHold));
                        var isMyWaitlisted = myWaitlist != null;

                        var isVisibleForSelectedDate = Model.SelectedDate.HasValue && Model.SelectedDate.Value.ToString("yyyy-MM-dd") == slotDateStr;

                        <div class="card-plato p-3 slot-card slot-card-item @(isVisibleForSelectedDate ? "" : "d-none") @(isMyBooked ? "border-success shadow-sm" : isMyWaitlisted ? "border-warning shadow-sm" : isFull ? "slot-full" : "") @(isGroup ? "slot-group" : "")"
                             data-slot-date="@slotDateStr"
                             style="@(isMyBooked ? "border: 2px solid var(--plato-sage) !important; background: #f8fbf9;" : isMyWaitlisted ? "border: 2px solid #f59e0b !important; background: #fffdf5;" : "")">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                                <!-- 左側：時間、老師、類型與進度 -->
                                <div class="d-flex flex-column gap-1">
                                    <div class="d-flex flex-wrap align-items-center gap-2">
                                        <span class="fw-bold fs-5 text-dark">
                                            <i class="bi bi-clock me-1 text-primary"></i>@startTpe.ToString("HH:mm") – @endTpe.ToString("HH:mm")
                                        </span>
                                        @if (slot.SlotType == SlotType.SmallGroup)
                                        {
                                            <span class="badge badge-slot-small px-2 py-1">小組指導 · 扣 1 堂</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-slot-group px-2 py-1">團體輔導 · 免費</span>
                                        }
                                        @if (slot.IsExtraSlot)
                                        {
                                            <span class="badge bg-warning text-dark">加開</span>
                                        }
                                    </div>
                                    <div class="small text-secondary d-flex flex-wrap align-items-center gap-3">
                                        <span><i class="bi bi-person-workspace me-1"></i>老師：<strong>@slot.TeacherUser?.DisplayName</strong></span>
                                        <span><i class="bi bi-journal-bookmark me-1"></i>進度：@slot.CourseProgress?.Title</span>
                                        @if (!string.IsNullOrWhiteSpace(slot.Notes))
                                        {
                                            <span class="text-muted"><i class="bi bi-chat-left-text me-1"></i>@slot.Notes</span>
                                        }
                                    </div>
                                </div>

                                <!-- 右側：名額與立即預約按鈕 -->
                                <div class="d-flex align-items-center justify-content-between justify-content-md-end gap-3 flex-wrap">
                                    <div class="text-md-end">
                                        @if (isMyBooked)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fs-6">
                                                <i class="bi bi-check-circle-fill me-1"></i>您已預約
                                            </span>
                                        }
                                        else if (isMyWaitlisted)
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1 fs-6">
                                                <i class="bi bi-clock-history me-1"></i>候補第 #@myWaitlist!.Position 位
                                            </span>
                                        }
                                        else if (isFull)
                                        {
                                            <div class="small fw-semibold text-danger">已額滿 (@slot.CurrentBookedCount/@slot.MaxCapacity)</div>
                                            <div class="small text-muted" style="font-size: 0.72rem;">開放登記候補</div>
                                        }
                                        else
                                        {
                                            <div class="small fw-semibold text-success">剩餘 @slot.RemainingSeats 席空位</div>
                                            <div class="small text-muted" style="font-size: 0.72rem;">已約 @slot.CurrentBookedCount / @slot.MaxCapacity</div>
                                        }
                                    </div>

                                    <div>
                                        @if (isMyBooked)
                                        {
                                            <button class="btn btn-sm btn-outline-success disabled fw-semibold py-1 px-3">
                                                已在預約清單
                                            </button>
                                        }
                                        else if (isMyWaitlisted)
                                        {
                                            <button class="btn btn-sm btn-outline-warning disabled fw-semibold py-1 px-3">
                                                排隊候補中
                                            </button>
                                        }
                                        else if (sameProgressOtherBooked)
                                        {
                                            <span class="badge bg-light text-secondary border p-2" title="小組指導每進度限預約 1 堂">
                                                同進度已約其他時段
                                            </span>
                                        }
                                        else if (!isFull)
                                        {
                                            var isCutoff = slot.StartsAtUtc <= DateTime.UtcNow.AddMinutes(30);
                                            if (isCutoff)
                                            {
                                                <button class="btn btn-sm btn-secondary disabled py-1 px-3">已截止</button>
                                            }
                                            else if (isEnrollmentBlocked)
                                            {
                                                <button type="button" class="btn btn-accent btn-sm px-3"
                                                        onclick="showEnrollmentBlockedModal('@student?.FullName', '該學生@(enrollmentStatusDesc)，暫無法登記或候補課堂；請洽班主任辦理學期續報。');">
                                                    立即預約
                                                </button>
                                            }
                                            else
                                            {
                                                <form method="post" asp-page-handler="BookSlot" class="d-inline">
                                                    <input type="hidden" name="studentId" value="@student?.Id" />
                                                    <input type="hidden" name="slotId" value="@slot.Id" />
                                                    <input type="hidden" name="purposeName" value="@(Model.PurposeOptions.FirstOrDefault()?.Name ?? "課後輔導")" />
                                                    <button type="submit" class="btn btn-accent btn-sm px-3 fw-semibold shadow-sm"
                                                            onclick="return confirm('確認要為 @student?.FullName 預約 @startTpe.ToString("HH:mm") 此時段嗎？');">
                                                        <i class="bi bi-calendar-check me-1"></i>立即預約
                                                    </button>
                                                </form>
                                            }
                                        }
                                        else
                                        {
                                            var isCutoff = slot.StartsAtUtc <= DateTime.UtcNow.AddMinutes(30);
                                            if (isCutoff)
                                            {
                                                <button class="btn btn-sm btn-secondary disabled py-1 px-3">已截止</button>
                                            }
                                            else if (isEnrollmentBlocked)
                                            {
                                                <button type="button" class="btn btn-outline-warning text-dark btn-sm px-3 fw-semibold"
                                                        onclick="showEnrollmentBlockedModal('@student?.FullName', '該學生@(enrollmentStatusDesc)，暫無法登記或候補課堂；請洽班主任辦理學期續報。');">
                                                    加入候補
                                                </button>
                                            }
                                            else
                                            {
                                                <form method="post" asp-page-handler="JoinWaitlist" class="d-inline">
                                                    <input type="hidden" name="studentId" value="@student?.Id" />
                                                    <input type="hidden" name="slotId" value="@slot.Id" />
                                                    <input type="hidden" name="purposeName" value="@(Model.PurposeOptions.FirstOrDefault()?.Name ?? "課後輔導")" />
                                                    <button type="submit" class="btn btn-outline-warning text-dark btn-sm px-3 fw-semibold shadow-sm">
                                                        <i class="bi bi-clock-history me-1"></i>加入候補
                                                    </button>
                                                </form>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <div id="noMatchSlotNotice" class="card-plato p-4 text-center text-muted d-none">
                        <i class="bi bi-calendar-x fs-2 text-secondary mb-2 d-block"></i>
                        <h4 class="h6 fw-bold mb-1">所選日期目前暫無開放預約的時段</h4>
                        <p class="small text-secondary mb-0">請點選月曆其他標示有小組或團體的日期進行預約。</p>
                    </div>
                </div>
            </div>

            <!-- 預約與改期規則說明卡片 -->
            <div class="card-plato p-3 p-md-4 bg-light border-0">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-info-circle-fill text-primary"></i>
                    <strong class="text-dark">預約與改期規則提醒</strong>
                </div>
                <div class="row g-2 small text-secondary">
                    <div class="col-12 col-md-4">
                        <i class="bi bi-dot text-primary"></i>小組指導每進度限 <strong>1 堂</strong>（扣 1 堂）；團體輔導免費不限堂數。
                    </div>
                    <div class="col-12 col-md-4">
                        <i class="bi bi-dot text-primary"></i>開課前 <strong>24 小時（含）以上</strong>取消自動退還扣抵堂數；未滿 24 小時取消不退堂。
                    </div>
                    <div class="col-12 col-md-4">
                        <i class="bi bi-dot text-primary"></i>名額額滿可登記候補，釋出空位時系統將依順位直接自動補上轉正、扣堂並發送 LINE 推播通知。
                    </div>
                </div>
            </div>
        </div>


        <!-- 分頁二：我的預約與候補紀錄 -->
        <div class="tab-pane fade" id="tab-parent-records" role="tabpanel">
            <div class="row g-4">
                <div class="col-12 col-xl-8">
                    <div class="card-plato p-3 p-md-4 h-100">
                        <div class="section-header-clean">
                            <div>
                                <h2 class="h5 fw-bold mb-0">@(student?.FullName) 的預約與候補清單</h2>
                                <div class="small text-muted">包含已確認預約與候補排隊，統一依開課時間排序；支援改期、取消預約或取消候補</div>
                            </div>
                        </div>

                        @{
                            var activeBookingList = Model.StudentBookings
                                .Where(b => b.Status == BookingStatus.Confirmed)
                                .Select(b => new {
                                    IsWaitlist = false,
                                    StartsAtUtc = b.TutoringSlot!.StartsAtUtc,
                                    Slot = b.TutoringSlot,
                                    Booking = (Booking?)b,
                                    Waitlist = (WaitlistEntry?)null
                                });

                            var activeWaitlistList = Model.StudentWaitlistEntries
                                .Where(w => w.Status == WaitlistStatus.Waiting || w.Status == WaitlistStatus.NotifiedHold)
                                .Select(w => new {
                                    IsWaitlist = true,
                                    StartsAtUtc = w.TutoringSlot!.StartsAtUtc,
                                    Slot = w.TutoringSlot,
                                    Booking = (Booking?)null,
                                    Waitlist = (WaitlistEntry?)w
                                });

                            var combinedScheduleList = activeBookingList.Concat(activeWaitlistList)
                                .OrderBy(x => x.StartsAtUtc)
                                .ToList();
                        }

                        @if (!combinedScheduleList.Any())
                        {
                            <div class="text-muted small py-4 text-center">目前尚無預約或候補紀錄。</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle table-plato table-responsive-cards mb-0">
                                    <thead>
                                        <tr>
                                            <th>時段與進度</th>
                                            <th>類型 / 到班目的</th>
                                            <th>扣堂明細</th>
                                            <th>狀態 / 順位</th>
                                            <th>操作</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in combinedScheduleList)
                                        {
                                            var slot = item.Slot!;
                                            var sTpe = BookingService.ToTaipeiTime(slot.StartsAtUtc);
                                            var dayZh = "日一二三四五六"[(int)sTpe.DayOfWeek];

                                            if (!item.IsWaitlist)
                                            {
                                                var b = item.Booking!;
                                                var hoursLeft = (slot.StartsAtUtc - DateTime.UtcNow).TotalHours;
                                                var sameProgressTargets = Model.AllCurrentSlots
                                                    .Where(s => s.CourseProgressId == slot.CourseProgressId
                                                                && s.Id != slot.Id
                                                                && s.RemainingSeats > 0
                                                                && s.SlotType == slot.SlotType
                                                                && s.StartsAtUtc > DateTime.UtcNow.AddMinutes(30))
                                                    .OrderBy(s => s.StartsAtUtc)
                                                    .ToList();
                                                var attendanceZh = b.AttendanceStatus switch {
                                                    AttendanceStatus.Pending => "待點名",
                                                    AttendanceStatus.Present => "出席",
                                                    AttendanceStatus.Absent => "請假",
                                                    AttendanceStatus.NoShow => "曠課",
                                                    _ => b.AttendanceStatus.ToString()
                                                };

                                                <tr>
                                                    <td data-label="時段與進度">
                                                        <div>
                                                            <div class="fw-bold text-dark">@sTpe.ToString("MM/dd") (@dayZh) @sTpe.ToString("HH:mm")</div>
                                                            <div class="small text-muted">@slot.CourseProgress?.Title · @slot.GradeClass</div>
                                                        </div>
                                                    </td>
                                                    <td data-label="類型 / 目的">
                                                        <div>
                                                            <span class="badge @(slot.SlotType == SlotType.SmallGroup ? "badge-slot-small" : "badge-slot-group")">
                                                                @(slot.SlotType == SlotType.SmallGroup ? "小組指導" : "團體輔導")
                                                            </span>
                                                            <div class="small fw-semibold mt-1">@b.PurposeName</div>
                                                        </div>
                                                    </td>
                                                    <td data-label="扣堂明細">
                                                        @if (b.CreditsDeducted == 0)
                                                        {
                                                            <span class="text-muted small">免費 (0 堂)</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="small">
                                                                贈送 @b.BonusCreditsUsed 堂 + 付費 @b.PaidCreditsUsed 堂
                                                            </span>
                                                        }
                                                    </td>
                                                    <td data-label="狀態 / 順位">
                                                        <div>
                                                            <span class="badge bg-success">
                                                                已預約
                                                            </span>
                                                            <span class="badge bg-light text-dark border ms-1">點名：@attendanceZh</span>
                                                        </div>
                                                    </td>
                                                    <td data-label="操作">
                                                        <div class="d-flex flex-column gap-2">
                                                            <!-- 改期區塊 -->
                                                            <div class="p-2 rounded bg-light border">
                                                                <div class="small fw-semibold text-dark mb-1">
                                                                    <i class="bi bi-arrow-left-right me-1 text-primary"></i>改期至同進度其他時段：
                                                                </div>
                                                                @if (hoursLeft < 24)
                                                                {
                                                                    <div class="small text-muted" style="font-size: 0.74rem;">
                                                                        開課前 24 小時內不可改期
                                                                    </div>
                                                                }
                                                                else if (!sameProgressTargets.Any())
                                                                {
                                                                    <div class="small text-muted" style="font-size: 0.74rem;">
                                                                        此進度目前無其他可改期空位時段
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <form method="post" asp-page-handler="Reschedule" class="d-flex gap-1">
                                                                        <input type="hidden" name="studentId" value="@student.Id" />
                                                                        <input type="hidden" name="existingBookingId" value="@b.Id" />
                                                                        <select name="targetSlotId" class="form-select form-select-sm" aria-label="選擇改期目標時段" required>
                                                                            @foreach (var tgt in sameProgressTargets)
                                                                            {
                                                                                var tStart = BookingService.ToTaipeiTime(tgt.StartsAtUtc);
                                                                                var tDayZh = "日一二三四五六"[(int)tStart.DayOfWeek];
                                                                                <option value="@tgt.Id">@tStart.ToString("MM/dd") (@tDayZh) @tStart.ToString("HH:mm") (餘 @tgt.RemainingSeats 名)</option>
                                                                            }
                                                                        </select>
                                                                        <button type="submit" class="btn btn-outline-primary btn-sm text-nowrap fw-bold"
                                                                                onclick="return confirm('確定要更換至所選的新時段嗎？');">改期</button>
                                                                    </form>
                                                                }
                                                            </div>

                                                            <!-- 取消預約按鈕 -->
                                                            <form method="post" asp-page-handler="CancelBooking">
                                                                <input type="hidden" name="studentId" value="@student.Id" />
                                                                <input type="hidden" name="bookingId" value="@b.Id" />
                                                                <button type="submit" class="btn btn-outline-danger btn-sm w-100"
                                                                        onclick="return confirm('@(hoursLeft >= 24 ? "目前距離開課滿 24 小時，取消將全額退還原扣抵堂數。確定取消？" : "注意：距離開課已不足 24 小時，取消將不退還堂數！確定取消？")');">
                                                                    <i class="bi bi-x-circle me-1"></i>取消預約 @(hoursLeft >= 24 ? "(退還堂數)" : "(逾時不退)")
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                var w = item.Waitlist!;

                                                <tr>
                                                    <td data-label="時段與進度">
                                                        <div>
                                                            <div class="fw-bold text-dark">@sTpe.ToString("MM/dd") (@dayZh) @sTpe.ToString("HH:mm")</div>
                                                            <div class="small text-muted">@slot.CourseProgress?.Title · @slot.GradeClass</div>
                                                        </div>
                                                    </td>
                                                    <td data-label="類型 / 目的">
                                                        <div>
                                                            <span class="badge @(slot.SlotType == SlotType.SmallGroup ? "badge-slot-small" : "badge-slot-group")">
                                                                @(slot.SlotType == SlotType.SmallGroup ? "小組指導" : "團體輔導")
                                                            </span>
                                                            <div class="small fw-semibold mt-1">@w.PurposeName</div>
                                                        </div>
                                                    </td>
                                                    <td data-label="扣堂明細">
                                                        <span class="small text-muted">
                                                            <i class="bi bi-info-circle me-1"></i>候補免先扣堂（釋出空位直接自動補上扣 1 堂）
                                                        </span>
                                                    </td>
                                                    <td data-label="狀態 / 順位">
                                                        <div>
                                                            <span class="badge bg-warning text-dark">
                                                                <i class="bi bi-hourglass-split me-1"></i>排隊候補中
                                                            </span>
                                                            <div class="small text-primary fw-bold mt-1">
                                                                順位：第 @w.Position 位
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td data-label="操作">
                                                        <form method="post" asp-page-handler="CancelWaitlist">
                                                            <input type="hidden" name="studentId" value="@student.Id" />
                                                            <input type="hidden" name="waitlistEntryId" value="@w.Id" />
                                                            <button type="submit" class="btn btn-outline-danger btn-sm w-100" onclick="return confirm('確定要取消候補此時段嗎？取消後將釋出順位並重新調整其他候補學生。');">
                                                                <i class="bi bi-x-circle me-1"></i>取消候補
                                                            </button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-12 col-xl-4">
                    <div class="card-plato p-3 p-md-4 h-100">
                        <div class="section-header-clean">
                            <div>
                                <h2 class="h5 fw-bold mb-0">LINE 官方帳號通知</h2>
                                <div class="small text-muted">7 大即時推播與異動歷程</div>
                            </div>
                        </div>

                        <!-- LINE 官方帳號通知綁定狀態與操作 -->
                        <div class="p-3 mb-3 bg-light rounded-3 border">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold small text-dark"><i class="bi bi-line text-success me-1"></i>LINE 官方帳號通知綁定</span>
                                @if (!string.IsNullOrWhiteSpace(Model.CurrentUser.LineUserId))
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-check-circle-fill me-1"></i>已完成綁定
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                        <i class="bi bi-exclamation-circle me-1"></i>尚未綁定
                                    </span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model.CurrentUser.LineUserId))
                            {
                                <div class="small text-muted mb-2">目前接收通知 ID：<code>@Model.CurrentUser.LineUserId</code>（支援 7 大條件即時推播）</div>
                                <form method="post" asp-page-handler="UnbindLine" class="d-inline" data-no-loading="true" onsubmit="return confirm('確定要解除 LINE 官方帳號通知綁定嗎？');">
                                    <input type="hidden" name="studentId" value="@student.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">解除綁定</button>
                                </form>
                            }
                            else
                            {
                                <div class="small text-secondary mb-2">綁定後即可接收堂數異動、預約成功、開課前48小時提醒與候補釋出等 7 大即時通知。</div>
                                <form method="post" asp-page-handler="BindLine" class="d-flex gap-2">
                                    <input type="hidden" name="studentId" value="@student.Id" />
                                    <input type="text" name="lineUserId" class="form-control form-control-sm" placeholder="輸入 LINE User ID" required />
                                    <button type="submit" class="btn btn-sm btn-success text-nowrap fw-bold">立即綁定</button>
                                </form>
                            }
                        </div>

                        <div class="small fw-semibold text-secondary mb-2">最近收到的 LINE 通知：</div>
                        @if (!Model.RecentLineLogs.Any())
                        {
                            <div class="text-muted small">尚無通知紀錄。</div>
                        }
                        else
                        {
                            <div class="d-grid gap-2">
                                @foreach (var log in Model.RecentLineLogs)
                                {
                                    var logDayZh = "日一二三四五六"[(int)BookingService.ToTaipeiTime(log.SentAtUtc).DayOfWeek];
                                    <div class="p-2 bg-light border rounded-3 small">
                                        <div class="d-flex justify-content-between text-muted mb-1">
                                            <span class="fw-semibold text-dark">@log.NotificationType</span>
                                            <span>@BookingService.ToTaipeiTime(log.SentAtUtc).ToString("MM/dd") (@logDayZh) @BookingService.ToTaipeiTime(log.SentAtUtc).ToString("HH:mm")</span>
                                        </div>
                                        <div>@log.MessageText</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- 分頁三：堂數異動流水帳 -->
        <div class="tab-pane fade" id="tab-parent-ledger" role="tabpanel">
            <div class="card-plato p-3 p-md-4">
                <div class="section-header-clean">
                    <div>
                        <h2 class="h5 fw-bold mb-0">@student.FullName 的堂數異動流水帳</h2>
                        <div class="small text-muted">每筆儲值、贈送、扣抵、取消退還與沖正皆為不可覆寫之 Append-Only 紀錄</div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle table-plato table-responsive-cards mb-0">
                        <thead>
                            <tr>
                                <th>時間 (台北時間)</th>
                                <th>狀態</th>
                                <th>贈送異動</th>
                                <th>付費異動</th>
                                <th>異動後餘額 (贈送 / 付費)</th>
                                <th>摘要與操作人</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in Model.StudentLedgerEntries)
                            {
                                var lgtTpe = BookingService.ToTaipeiTime(e.CreatedAtUtc);
                                var lgDayZh = "日一二三四五六"[(int)lgtTpe.DayOfWeek];
                                var txZh = e.TransactionType switch {
                                    LedgerTransactionType.TopUpPaid => "儲值入帳",
                                    LedgerTransactionType.SemesterBonusGrant => "學期贈送",
                                    LedgerTransactionType.ManualBonusGrant => "手動贈送",
                                    LedgerTransactionType.BookingDeduct => "預約扣堂",
                                    LedgerTransactionType.CancelRefund => "取消退堂",
                                    LedgerTransactionType.AdjustmentReversal => "沖正調整",
                                    LedgerTransactionType.SemesterBonusExpiry => "學期到期歸零",
                                    LedgerTransactionType.DropoutSettlementDeduct => "退班結算扣除",
                                    _ => e.TransactionType.ToString()
                                };
                                <tr>
                                    <td data-label="時間">@lgtTpe.ToString("yyyy-MM-dd") (@lgDayZh) @lgtTpe.ToString("HH:mm")</td>
                                    <td data-label="狀態"><span class="badge bg-secondary">@txZh</span></td>
                                    <td data-label="贈送異動" class="fw-bold @(e.BonusDelta > 0 ? "text-success" : e.BonusDelta < 0 ? "text-danger" : "text-muted")">
                                        @(e.BonusDelta > 0 ? $"+{e.BonusDelta}" : e.BonusDelta.ToString())
                                    </td>
                                    <td data-label="付費異動" class="fw-bold @(e.PaidDelta > 0 ? "text-primary" : e.PaidDelta < 0 ? "text-danger" : "text-muted")">
                                        @(e.PaidDelta > 0 ? $"+{e.PaidDelta}" : e.PaidDelta.ToString())
                                    </td>
                                    <td data-label="異動後餘額">
                                        贈送 <strong>@e.BonusBalanceAfter</strong> 堂 / 付費 <strong>@e.PaidBalanceAfter</strong> 堂
                                    </td>
                                    <td data-label="摘要與操作人" class="small">
                                        @e.ReferenceNote <span class="text-muted">(@e.OperatorName)</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

<!-- 週期預約 Modal -->
<div class="modal fade" id="modalRecurringBooking" tabindex="-1" aria-labelledby="modalRecurringBookingLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title h6 fw-bold" id="modalRecurringBookingLabel">
                    <i class="bi bi-arrow-repeat me-1"></i>週期預約（批次預約所選時段）
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @if (Model.SelectedStudent != null)
            {
                <form method="post" asp-page-handler="RecurringBook">
                    <div class="modal-body">
                        <input type="hidden" name="studentId" value="@Model.SelectedStudent.Id" />
                        
                        <!-- 篩選條件：週一～週日 & 年別 -->
                        <div class="p-3 bg-light rounded-3 mb-3 border">
                            <div class="row g-3 align-items-center">
                                <div class="col-12 col-md-7">
                                    <label class="form-label small fw-bold text-dark mb-1">星期篩選（週一至週日）：</label>
                                    <div class="d-flex flex-wrap gap-1" id="recurringDayFilters">
                                        <button type="button" class="btn btn-sm btn-outline-primary active day-filter-btn" data-day="1">週一</button>
                                        <button type="button" class="btn btn-sm btn-outline-primary active day-filter-btn" data-day="2">週二</button>
                                        <button type="button" class="btn btn-sm btn-outline-primary active day-filter-btn" data-day="3">週三</button>
                                        <button type="button" class="btn btn-sm btn-outline-primary active day-filter-btn" data-day="4">週四</button>
                                        <button type="button" class="btn btn-sm btn-outline-primary active day-filter-btn" data-day="5">週五</button>
                                        <button type="button" class="btn btn-sm btn-outline-primary active day-filter-btn" data-day="6">週六</button>
                                        <button type="button" class="btn btn-sm btn-outline-primary active day-filter-btn" data-day="0">週日</button>
                                        <button type="button" class="btn btn-sm btn-link text-decoration-none py-0 px-2" onclick="toggleAllDays(true)">全選</button>
                                        <button type="button" class="btn btn-sm btn-link text-decoration-none py-0 px-1 text-secondary" onclick="toggleAllDays(false)">清空</button>
                                    </div>
                                </div>
                                <div class="col-12 col-md-5">
                                    <label class="form-label small fw-bold text-dark mb-1">年別篩選：</label>
                                    <select class="form-select form-select-sm" id="recurringGradeFilter" onchange="filterRecurringSlots()">
                                        <option value="">全部年別</option>
                                        @foreach (var g in Model.GradeOptions)
                                        {
                                            <option value="@g.Value">@g.Value</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- 到班目的設定 -->
                        <div class="row g-2 mb-3 align-items-center">
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-bold text-dark mb-1">統一到班目的：</label>
                                <select name="purposeName" class="form-select form-select-sm" required>
                                    @foreach (var p in Model.PurposeOptions)
                                    {
                                        <option value="@p.Name">目的：@p.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-md-6 d-flex align-items-end justify-content-md-end gap-2 pt-2 pt-md-0">
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAllVisibleSlots(true)">勾選所有符合時段</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAllVisibleSlots(false)">全取消</button>
                            </div>
                        </div>

                        <!-- 可預約時段清單 -->
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-bold text-dark">可預約時段清單：</span>
                            <span class="small text-muted d-md-none" style="font-size: 0.75rem;"><i class="bi bi-arrows-expand me-1"></i>可左右滑動查看</span>
                        </div>
                        <div class="table-responsive border rounded-3 mb-2" style="max-height: 380px;">
                            <table class="table table-hover table-sm align-middle mb-0" id="recurringSlotsTable">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width: 52px;" class="text-center text-nowrap">選取</th>
                                        <th style="width: 145px;" class="text-nowrap">日期時間</th>
                                        <th style="width: 85px;" class="text-center text-nowrap">類型</th>
                                        <th class="text-nowrap" style="min-width: 140px;">進度與年別</th>
                                        <th style="width: 95px;" class="text-center text-nowrap">剩餘名額</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!Model.AllCurrentSlots.Any())
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-4">目前沒有開放預約的未來時段。</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var slot in Model.AllCurrentSlots.OrderBy(s => s.StartsAtUtc))
                                        {
                                            var slotTpe = BookingService.ToTaipeiTime(slot.StartsAtUtc);
                                            var dayOfWeekInt = (int)slotTpe.DayOfWeek;
                                            var dayOfWeekZh = "日一二三四五六"[dayOfWeekInt];
                                            var isMyBooked = Model.StudentBookings.Any(b => b.TutoringSlotId == slot.Id);
                                            var isCutoff = slot.StartsAtUtc <= DateTime.UtcNow.AddMinutes(30);
                                            var isFull = slot.RemainingSeats <= 0;
                                            var isDisabled = isMyBooked || isCutoff || isFull;

                                            <tr class="recurring-slot-row"
                                                data-day-of-week="@dayOfWeekInt"
                                                data-grade="@slot.GradeClass">
                                                <td class="text-center">
                                                    @if (isDisabled)
                                                    {
                                                        <input type="checkbox" class="form-check-input" disabled />
                                                    }
                                                    else
                                                    {
                                                        <input type="checkbox" name="slotIds" value="@slot.Id" class="form-check-input recurring-slot-checkbox" />
                                                    }
                                                </td>
                                                <td>
                                                    <div class="fw-bold">@slotTpe.ToString("yyyy/MM/dd") (週@dayOfWeekZh)</div>
                                                    <div class="small text-muted">@slotTpe.ToString("HH:mm") ~ @BookingService.ToTaipeiTime(slot.EndsAtUtc).ToString("HH:mm")</div>
                                                </td>
                                                <td>
                                                    <span class="badge @(slot.SlotType == SlotType.GroupCounseling ? "bg-info-subtle text-info border border-info-subtle" : "bg-primary-subtle text-primary border border-primary-subtle")">
                                                        @(slot.SlotType == SlotType.GroupCounseling ? "團體輔導" : "小組指導")
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="fw-semibold">@slot.CourseProgress?.Title</div>
                                                    <div class="small text-muted">年別：@slot.GradeClass ｜ 師資：@slot.TeacherUser?.DisplayName</div>
                                                </td>
                                                <td>
                                                    @if (isMyBooked)
                                                    {
                                                        <span class="badge bg-success-subtle text-success">已預約</span>
                                                    }
                                                    else if (isCutoff)
                                                    {
                                                        <span class="badge bg-secondary">已截止</span>
                                                    }
                                                    else if (isFull)
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger">已額滿</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success">餘 @slot.RemainingSeats 位</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">取消</button>
                        <button type="submit" class="btn btn-primary btn-sm px-4 fw-bold" onclick="return confirmRecurringSubmit();">
                            <i class="bi bi-check-all me-1"></i>一次預約所選時段
                        </button>
                    </div>
                </form>
            }
            else
            {
                <div class="modal-body text-center py-5 text-muted">
                    <i class="bi bi-person-x fs-1 text-warning d-block mb-2"></i>
                    <h5 class="fw-bold text-dark">尚未選擇學生</h5>
                    <p class="small text-secondary mb-0">請先於頁面上方切換或選擇獲授權的孩子，再進行週期預約。</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">關閉</button>
                </div>
            }
        </div>
    </div>
</div>

<!-- 休假日詳情彈窗 Modal -->
