@page
@model PlatoTutoring.Web.Pages.Parent.IndexModel
@{
    ViewData["Title"] = "家長預約與堂數中心";
    var student = Model.SelectedStudent;
    var isEnrollmentBlocked = student != null && (student.IsDroppedOut || student.EnrollmentStatus != StudentEnrollmentStatus.Enrolled);
    var enrollmentStatusDesc = student == null ? "" : (student.EnrollmentStatus == StudentEnrollmentStatus.Unrenewed ? "本學期尚未完成續報" : (student.IsDroppedOut || student.EnrollmentStatus == StudentEnrollmentStatus.DroppedOut) ? "已辦理退班" : "非本學期在學");
}

<!-- 頂部區塊標題與 LINE 通知綁定 -->
<div class="card-plato p-3 p-md-4 mb-4">
    <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3">
        <div>
            <div class="eyebrow-tag">
                <i class="bi bi-calendar2-check-fill"></i>
                <span>家長專屬工作台 · Parent Portal</span>
            </div>
            <h1 class="h3 fw-bold mb-1">孩子輔導預約與分軌堂數查詢</h1>
            <p class="text-secondary small mb-0">
                家長帳號：<strong>@Model.CurrentUser.DisplayName</strong> ｜ 僅顯示獲授權孩子之紀錄 ｜ 扣堂規則：優先扣抵贈送堂數
            </p>
        </div>

        <div class="d-flex flex-column align-items-start align-items-md-end gap-2">
            @if (string.IsNullOrWhiteSpace(Model.CurrentUser.LineUserId))
            {
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <a href="/LineAuth/Login?returnUrl=@Url.Page("/Parent", null, new { studentId = student?.Id })"
                       class="btn text-white fw-bold shadow-sm d-inline-flex align-items-center px-3 py-2"
                       style="background-color: #06c755; border-color: #06c755;">
                        <i class="bi bi-line fs-5 me-2"></i>一鍵自動授權綁定 LINE 通知
                    </a>
                    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#manualBindCollapse" aria-expanded="false" title="進階手動設定">
                        <i class="bi bi-gear-fill"></i>
                    </button>
                </div>
            }
            else
            {
                <div class="d-flex align-items-center gap-2 flex-wrap bg-white p-2 px-3 rounded-3 border shadow-sm">
                    <span class="badge bg-success-subtle text-success border border-success-subtle py-2 px-2 d-inline-flex align-items-center gap-1">
                        <i class="bi bi-check-circle-fill"></i> LINE 通知已綁定
                    </span>
                    <span class="small font-monospace text-muted d-none d-md-inline" title="LINE User ID">
                        @Model.CurrentUser.LineUserId
                    </span>
                    <a href="/LineAuth/Login?returnUrl=@Url.Page("/Parent", null, new { studentId = student?.Id })"
                       class="btn btn-sm btn-outline-success fw-semibold" title="重新綁定或換帳號">
                        <i class="bi bi-arrow-repeat me-1"></i>重新綁定
                    </a>
                    <form method="post" asp-page-handler="UnbindLine" class="d-inline" data-no-loading="true" onsubmit="return confirm('確定要解除 LINE 官方帳號通知綁定嗎？解除後將無法接收即時推播通知。');">
                        <input type="hidden" name="studentId" value="@student?.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger fw-semibold" title="解除綁定">
                            <i class="bi bi-x-circle me-1"></i>解除
                        </button>
                    </form>
                </div>
            }

            <div class="collapse" id="manualBindCollapse">
                <form method="post" asp-page-handler="BindLine" class="d-flex gap-2 align-items-center">
                    <input type="hidden" name="studentId" value="@student?.Id" />
                    <div class="input-group input-group-sm" style="max-width: 340px;">
                        <span class="input-group-text bg-light small">手動 ID</span>
                        <input type="text" name="lineUserId" class="form-control" value="@Model.CurrentUser.LineUserId" placeholder="例如 U4af49806..." />
                        <button type="submit" class="btn btn-outline-secondary">儲存</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@if (Model.CurrentUser.Role == UserRole.Parent)
{
    @if (Model.AuthorizedStudents.Count > 0)
    {
        <!-- 關聯孩子切換列（家長專屬卡片切換） -->
        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small fw-bold text-secondary">
                    <i class="bi bi-people-fill me-1"></i>切換關聯孩子（共 @Model.AuthorizedStudents.Count 位）
                </span>
            </div>
            <div class="row g-3">
                @foreach (var s in Model.AuthorizedStudents)
                {
                    var isSelected = student?.Id == s.Id;
                    <div class="col-12 col-md-6 col-xl-4">
                        <a asp-page="/Parent/Index" asp-route-studentId="@s.Id"
                           class="student-selector-card @(isSelected ? "active" : "")"
                           onclick="this.href = '/Parent/Index?studentId=@s.Id' + (window.location.hash || '#tab-parent-book');">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                     style="width: 44px; height: 44px; background: @(isSelected ? "var(--plato-terracotta)" : "var(--plato-terracotta-soft)"); color: @(isSelected ? "#fff" : "var(--plato-terracotta-dark)");">
                                    @s.FullName.Substring(0, 1)
                                </div>
                                <div>
                                    <div class="fw-bold fs-6 d-flex align-items-center flex-wrap gap-1">
                                        <span>@s.FullName</span>
                                        <span class="badge @(isSelected ? "bg-light text-dark" : "bg-secondary")">@s.DisplaySchoolGradeClass</span>
                                        @if (s.EnrollmentStatus == StudentEnrollmentStatus.Enrolled)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">在學</span>
                                        }
                                        else if (s.EnrollmentStatus == StudentEnrollmentStatus.Unrenewed)
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">⚠️ 未續報</span>
                                        }
                                        else if (s.EnrollmentStatus == StudentEnrollmentStatus.DroppedOut || s.IsDroppedOut)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">❌ 已退班</span>
                                        }
                                    </div>
                                    <div class="small @(isSelected ? "text-white-50" : "text-muted")">
                                        入班日：@s.EnrollmentDate.ToString("yyyy-MM-dd")
                                    </div>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="small @(isSelected ? "text-white-50" : "text-muted")" style="font-size: 0.75rem;">可用總堂數</div>
                                <div class="fs-4 fw-bold">@s.TotalCredits <span class="fs-6 fw-normal">堂</span></div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    }
}
else if (student != null)
{
    <!-- 管理端／教師端檢視模式提示（精簡單行，不展開全校大量學生卡片） -->
    <div class="card-plato p-3 mb-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 bg-light border">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="badge bg-secondary">教務管理模式</span>
            <span class="text-secondary small">檢視學生：</span>
            <strong class="fs-6 text-dark">@student.FullName</strong>
            <span class="badge bg-white text-dark border">@student.DisplaySchoolGradeClass</span>
            @if (student.EnrollmentStatus == StudentEnrollmentStatus.Enrolled)
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle">在學</span>
            }
            else if (student.EnrollmentStatus == StudentEnrollmentStatus.Unrenewed)
            {
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">⚠️ 未續報</span>
            }
            else if (student.EnrollmentStatus == StudentEnrollmentStatus.DroppedOut || student.IsDroppedOut)
            {
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">❌ 已退班</span>
            }
            <span class="text-muted small">入班日：@student.EnrollmentDate.ToString("yyyy-MM-dd") ｜ 可用總堂數：<strong class="text-primary">@student.TotalCredits</strong> 堂</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <label class="small text-muted text-nowrap">切換檢視學生：</label>
            <select class="form-select form-select-sm" style="width: auto; min-width: 200px;" onchange="if(this.value) window.location.href='/Parent/Index?studentId=' + this.value + (window.location.hash || '#tab-parent-book');">
                @foreach (var s in Model.AuthorizedStudents)
                {
                    var stText = s.EnrollmentStatus == StudentEnrollmentStatus.Enrolled ? "在學" : (s.EnrollmentStatus == StudentEnrollmentStatus.Unrenewed ? "未續報" : "已退班");
                    <option value="@s.Id" selected="@(student.Id == s.Id)">@s.FullName (@s.DisplaySchoolGradeClass - @stText)</option>
                }
            </select>
        </div>
    </div>
}

@if (student != null)
{
    <!-- 作業不佳催促提醒橫幅 -->
    @if (Model.OpenHomeworkItems.Any())
    {
        <div class="alert alert-warning border-0 shadow-sm mb-3 p-3" role="alert">
            <div class="d-flex align-items-start gap-2">
                <i class="bi bi-bell-fill fs-5 text-warning-emphasis"></i>
                <div class="w-100">
                    <div class="fw-bold mb-1">老師作業加強提醒（請儘速為 @student.FullName 預約輔導時段）：</div>
                    <ul class="mb-0 ps-3 small">
                        @foreach (var hw in Model.OpenHomeworkItems)
                        {
                            <li class="mb-1">
                                <strong>@hw.CourseProgress?.Code @hw.CourseProgress?.Title：</strong>@hw.SubjectNote
                                <span class="text-muted">（通知時間：@BookingService.FormatTaipeiShortDateZh(hw.FirstNotifiedAtUtc)）</span>
                                @if (hw.IsSecondReminderFlagged)
                                {
                                    <span class="badge bg-danger ms-1">已逾 48 小時二次催促</span>
                                }
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }

    <!-- 候補釋出 30 分鐘確認橫幅 -->
    var activeHolds = Model.StudentWaitlistEntries
        .Where(w => w.Status == WaitlistStatus.NotifiedHold)
        .ToList();

    @if (activeHolds.Any())
    {
        <div class="alert alert-info border-0 shadow-sm mb-3 p-3" role="alert">
            <div class="fw-bold mb-2 d-flex align-items-center gap-2">
                <i class="bi bi-hourglass-split fs-5"></i>
                <span>候補名額已釋出！（系統保留 30 分鐘，請於時限內點擊確認轉為正式預約）</span>
            </div>
            @foreach (var hold in activeHolds)
            {
                var startZh = BookingService.FormatTaipeiShortDateZh(hold.TutoringSlot!.StartsAtUtc);
                var expTpe = hold.HoldExpiresAtUtc.HasValue ? BookingService.ToTaipeiTime(hold.HoldExpiresAtUtc.Value) : BookingService.ToTaipeiTime(hold.TutoringSlot!.StartsAtUtc);
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 bg-white p-3 rounded-3 border mb-2">
                    <div>
                        <strong>@hold.TutoringSlot.CourseProgress?.Code (@startZh)</strong>
                        － 到班目的：@hold.PurposeName
                        <span class="badge bg-danger ms-1">保留至 @expTpe.ToString("HH:mm")</span>
                    </div>
                    <form method="post" asp-page-handler="ConfirmWaitlist">
                        <input type="hidden" name="studentId" value="@student.Id" />
                        <input type="hidden" name="waitlistEntryId" value="@hold.Id" />
                        <button type="submit" class="btn btn-accent btn-sm">
                            <i class="bi bi-check2-circle me-1"></i>立即確認轉為正式預約
                        </button>
                    </form>
                </div>
            }
        </div>
    }

    <!-- 學生堂數整合精簡區塊（單一區塊清晰呈現總堂數與公式結構，消除誤以為有 16 堂之誤會） -->
    <div class="card-plato p-3 mb-3" style="background: linear-gradient(135deg, #ffffff 0%, #fdfbf7 100%); border-left: 4px solid var(--plato-terracotta);">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm"
                     style="width: 52px; height: 52px; background: var(--plato-terracotta-soft); color: var(--plato-terracotta-dark); font-size: 1.5rem; flex-shrink: 0;">
                    <i class="bi bi-wallet2"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="fs-6 fw-bold text-dark">目前可用總堂數：</span>
                        <span class="fs-2 fw-bolder" style="color: var(--plato-terracotta-dark);">@student.TotalCredits</span>
                        <span class="fw-bold text-dark me-1">堂</span>
                        <div class="d-inline-flex align-items-center gap-2 flex-wrap">
                            <span class="badge bg-light text-dark border py-2 px-3 fw-normal">
                                付費儲值 <strong class="text-primary fs-6">@student.PaidCredits</strong> 堂
                            </span>
                            <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle py-2 px-3 fw-normal">
                                學期贈送 <strong class="text-success fs-6">@student.BonusCredits</strong> 堂
                                <span class="text-secondary small ms-1">（期限至當學期結束，以到班日計算）</span>
                            </span>
                        </div>
                    </div>
                    <div class="small text-muted mt-2">
                        <i class="bi bi-info-circle me-1 text-primary"></i>小組指導優先扣抵贈送堂數；團體輔導完全免費不扣堂。贈送堂數一換學期即歸 0。
                    </div>
                </div>
            </div>
            <div class="text-md-end text-nowrap">
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fw-semibold">
                    <i class="bi bi-check-circle me-1"></i>帳戶狀態正常
                </span>
            </div>
        </div>
    </div>


    <!-- 膠囊式分段工作區頁籤 (Segmented Workspace Tabs) -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <ul class="nav nav-pills workspace-tabs-shell" id="parentWorkspaceTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="btn-parent-book" data-bs-toggle="pill"
                        data-bs-target="#tab-parent-book" type="button" role="tab">
                    <i class="bi bi-calendar-week"></i>
                    <span>線上預約時段</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="btn-parent-records" data-bs-toggle="pill"
                        data-bs-target="#tab-parent-records" type="button" role="tab">
                    <i class="bi bi-list-check"></i>
                    <span>我的預約與候補</span>
                    <span class="workspace-tab-count">@(Model.StudentBookings.Count(b => b.Status == BookingStatus.Confirmed) + Model.StudentWaitlistEntries.Count(w => w.Status == WaitlistStatus.Waiting || w.Status == WaitlistStatus.NotifiedHold))</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="btn-parent-ledger" data-bs-toggle="pill"
                        data-bs-target="#tab-parent-ledger" type="button" role="tab">
                    <i class="bi bi-journal-text"></i>
                    <span>堂數異動流水帳</span>
                    <span class="workspace-tab-count">@Model.StudentLedgerEntries.Count</span>
                </button>
            </li>
        </ul>
    </div>

    <div class="tab-content" id="parentWorkspaceTabContent">
        <!-- 分頁一：線上預約時段（先顯示月曆，點日期之後展開當天課堂列表） -->
        <div class="tab-pane fade show active" id="tab-parent-book" role="tabpanel">
            
            <!-- 月曆卡片 (先顯示月曆，標示小組與團體) -->
            <div class="booking-month-calendar card-plato p-3 p-md-4 mb-4 shadow-sm">
                <div class="calendar-month-header">
                    <div class="d-flex align-items-center gap-2 flex-wrap my-auto">
                        <h2 class="h5 fw-bold mb-0 text-dark d-flex align-items-center">
                            <i class="bi bi-calendar3 text-primary me-2"></i>@Model.CalendarYear 年 @Model.CalendarMonth 月 課堂月曆
                        </h2>
                        <div class="btn-group btn-group-sm ms-md-2 my-auto align-self-center" role="group">
                            <a asp-page="/Parent/Index"
                               asp-route-studentId="@student.Id"
                               asp-route-year="@Model.PrevYear"
                               asp-route-month="@Model.PrevMonth"
                               class="btn btn-outline-secondary d-inline-flex align-items-center py-1" title="上一月">
                                <i class="bi bi-chevron-left me-1"></i>上月
                            </a>
                            <a asp-page="/Parent/Index"
                               asp-route-studentId="@student.Id"
                               class="btn btn-outline-dark d-inline-flex align-items-center py-1" title="返回當月">
                                本月
                            </a>
                            <a asp-page="/Parent/Index"
                               asp-route-studentId="@student.Id"
                               asp-route-year="@Model.NextYear"
                               asp-route-month="@Model.NextMonth"
                               class="btn btn-outline-secondary d-inline-flex align-items-center py-1" title="下一月">
                                下月<i class="bi bi-chevron-right ms-1"></i>
                            </a>
                        </div>
                    </div>

                    <!-- 週期預約按鈕與圖例說明 -->
                    <div class="d-flex align-items-center gap-2 flex-wrap small">
                        @if (isEnrollmentBlocked)
                        {
                            <button type="button"
                                    class="btn btn-sm btn-primary fw-bold"
                                    onclick="showEnrollmentBlockedModal('@student?.FullName', '該學生@(enrollmentStatusDesc)，暫無法預約課堂；請洽班主任辦理學期續報。')">
                                <i class="bi bi-arrow-repeat me-1"></i>週期預約
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-sm btn-primary fw-bold"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalRecurringBooking"
                                    onclick="openRecurringBookingModal()">
                                <i class="bi bi-arrow-repeat me-1"></i>週期預約
                            </button>
                        }
                        <span class="text-secondary ms-2 me-1">標示說明：</span>
                        <span class="badge badge-slot-small"><i class="bi bi-people-fill me-1"></i>小組指導</span>
                        <span class="badge badge-slot-group"><i class="bi bi-collection-fill me-1"></i>團體輔導</span>
                        <span class="badge bg-secondary"><i class="bi bi-moon-stars-fill me-1"></i>休假日</span>
                    </div>
                </div>

                <!-- 星期列 (日 一 二 三 四 五 六) -->
                <div class="calendar-month-grid mb-1">
                    <div class="calendar-weekday-cell weekend">週日</div>
                    <div class="calendar-weekday-cell">週一</div>
                    <div class="calendar-weekday-cell">週二</div>
                    <div class="calendar-weekday-cell">週三</div>
                    <div class="calendar-weekday-cell">週四</div>
                    <div class="calendar-weekday-cell">週五</div>
                    <div class="calendar-weekday-cell weekend">週六</div>
                </div>

                <!-- 日期網格 -->
                <div class="calendar-month-grid" id="parentCalendarGrid">
                    <!-- 第一週前的空白格 -->
                    @for (int p = 0; p < Model.StartDayOfWeek; p++)
                    {
                        <div class="calendar-month-cell empty-cell"></div>
                    }

                    @for (int day = 1; day <= Model.DaysInMonth; day++)
                    {
                        var cellDate = new DateOnly(Model.CalendarYear, Model.CalendarMonth, day);
                        var cellDateStr = cellDate.ToString("yyyy-MM-dd");
                        var cellDateDisplayZh = $"{cellDate:yyyy/MM/dd}（週{"日一二三四五六"[(int)cellDate.DayOfWeek]}）";
                        var isHoliday = Model.HolidayDates.Contains(cellDate);
                        var holidayName = isHoliday && Model.HolidayNames.TryGetValue(cellDate, out var hn) ? hn : null;
                        CalendarDaySummary? summary = null;
                        var hasSlots = !isHoliday && Model.CalendarDaysSummary.TryGetValue(cellDate, out summary) && summary.TotalSlots > 0;
                        var isSelected = Model.SelectedDate.HasValue && Model.SelectedDate.Value == cellDate;
                        var isToday = cellDate == DateOnly.FromDateTime(BookingService.ToTaipeiTime(DateTime.UtcNow));

                        <div class="calendar-month-cell @(isHoliday ? "is-holiday" : hasSlots ? "has-slots" : "no-slots") @(isSelected ? "selected-day" : "") @(isToday ? "today-cell" : "")"
                             data-date="@cellDateStr"
                             data-date-zh="@cellDateDisplayZh"
                             data-holiday="@(isHoliday ? "true" : "false")"
                             role="button"
                             tabindex="0"
                             aria-label="@(isHoliday ? $"{cellDateDisplayZh} 為機構休假日（{holidayName}）點擊查看詳情" : hasSlots ? $"{cellDateDisplayZh} 有課堂可預約，點擊展開時段列表" : cellDateDisplayZh)"
                             @(isHoliday ? $"onclick=\"showHolidayNoticeModal('{cellDateDisplayZh}', '{Html.Raw(holidayName ?? "機構休假日")}')\"" : hasSlots ? "onclick=\"selectCalendarDate(this.dataset.date, this.dataset.dateZh)\"" : "")>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="calendar-day-number @(isToday ? "badge bg-primary text-white" : isHoliday ? "text-danger fw-bold" : "")">
                                    @day
                                </span>
                                @if (isHoliday)
                                {
                                    <span class="badge bg-danger text-white p-0 px-1" style="font-size: 0.65rem;">休假</span>
                                }
                            </div>

                            @if (isHoliday)
                            {
                                <div class="calendar-cell-badges d-flex flex-column gap-1">
                                    <span class="badge bg-secondary text-white text-truncate p-1" style="font-size: 0.72rem;" title="節日/休假原因：@holidayName">
                                        🏖️ @(holidayName ?? "休假日")
                                    </span>
                                    <span class="small text-danger fw-semibold" style="font-size: 0.68rem;">
                                        停課不開放
                                    </span>
                                </div>
                            }
                            else if (hasSlots && summary != null)
                            {
                                <div class="calendar-cell-badges d-flex flex-column gap-1">
                                    @if (summary.SmallGroupCount > 0)
                                    {
                                        <span class="badge badge-slot-small text-truncate" title="小組指導（點擊查看時段）">
                                            小組指導
                                        </span>
                                    }
                                    @if (summary.GroupCount > 0)
                                    {
                                        <span class="badge badge-slot-group text-truncate" title="團體輔導（點擊查看時段）">
                                            團體輔導
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- 未點選日期時的引導提示卡片 -->
            <div class="card-plato p-4 p-md-5 text-center text-muted mb-4 shadow-sm @(Model.SelectedDate.HasValue ? "d-none" : "")" id="noDateSelectedPrompt">
                <div class="mb-3">
                    <span class="d-inline-flex p-3 rounded-circle bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-calendar2-week fs-1"></i>
                    </span>
                </div>
                <h3 class="h5 fw-bold text-dark mb-1">請在上方月曆點選有標示課堂的日期</h3>
                <p class="text-secondary small mb-0">
                    點擊月曆中有「小組」或「團體」標籤之日期，將在此展開當天的輔導課堂列表、剩餘名額與預約按鈕。
                </p>
            </div>

            <!-- 點日期之後展開：當天課堂列表容器 -->
            <div id="daySlotsContainer" class="@(Model.SelectedDate.HasValue ? "" : "d-none") mb-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 p-3 bg-white rounded-3 border shadow-sm">
                    <div class="d-flex align-items-center gap-2">
                        <span class="metric-icon-box ocean"><i class="bi bi-calendar-event"></i></span>
                        <div>
                            <h3 class="h5 fw-bold mb-0 text-dark" id="selectedDateTitle">
                                @(Model.SelectedDate.HasValue ? $"📅 {Model.SelectedDate.Value:yyyy/MM/dd}（週{"日一二三四五六"[(int)Model.SelectedDate.Value.DayOfWeek]}）當日課堂列表" : "")
                            </h3>
                            <span class="small text-muted" id="selectedDateSubtitle">
                                @(Model.SelectedDate.HasValue ? $"當天共開放 {Model.AvailableSlots.Count} 堂輔導課，請選擇到班目的後預約" : "")
                            </span>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearSelectedDate()">
                        <i class="bi bi-x-circle me-1"></i>收合課堂列表
                    </button>
                </div>

                <!-- 當天時段卡片清單 -->
                <div class="d-grid gap-3" id="slotCardsList">
                    @foreach (var slot in Model.AllCurrentSlots)
                    {
                        var startTpe = BookingService.ToTaipeiTime(slot.StartsAtUtc);
                        var endTpe = BookingService.ToTaipeiTime(slot.EndsAtUtc);
                        var slotDateStr = DateOnly.FromDateTime(startTpe).ToString("yyyy-MM-dd");
                        var dayZh = "日一二三四五六"[(int)startTpe.DayOfWeek];
                        var isFull = slot.RemainingSeats <= 0;
                        var isGroup = slot.SlotType == SlotType.GroupCounseling;
                        var fillPct = slot.MaxCapacity > 0 ? Math.Min(100, (int)Math.Round(100.0 * slot.CurrentBookedCount / slot.MaxCapacity)) : 100;

                        // 判斷當前學生是否已預約此時段或同進度其他時段
                        var myBooking = Model.StudentBookings.FirstOrDefault(b => b.TutoringSlotId == slot.Id && b.Status == BookingStatus.Confirmed);
                        var isMyBooked = myBooking != null;
                        var sameProgressOtherBooked = slot.SlotType == SlotType.SmallGroup && Model.StudentBookings.Any(b => b.Status == BookingStatus.Confirmed && b.TutoringSlot?.CourseProgressId == slot.CourseProgressId && b.TutoringSlotId != slot.Id);

                        // 判斷當前學生是否已在候補名單中
                        var myWaitlist = Model.StudentWaitlistEntries.FirstOrDefault(w => w.TutoringSlotId == slot.Id && (w.Status == WaitlistStatus.Waiting || w.Status == WaitlistStatus.NotifiedHold));
                        var isMyWaitlisted = myWaitlist != null;

                        var isVisibleForSelectedDate = Model.SelectedDate.HasValue && Model.SelectedDate.Value.ToString("yyyy-MM-dd") == slotDateStr;

                        <div class="card-plato p-3 p-md-4 slot-card slot-card-item @(isVisibleForSelectedDate ? "" : "d-none") @(isMyBooked ? "border-success shadow-sm" : isMyWaitlisted ? "border-warning shadow-sm" : isFull ? "slot-full" : "") @(isGroup ? "slot-group" : "")"
                             data-slot-date="@slotDateStr"
                             style="@(isMyBooked ? "border: 2px solid var(--plato-sage) !important; background: #f8fbf9;" : isMyWaitlisted ? "border: 2px solid #f59e0b !important; background: #fffdf5;" : "")">
                            <div class="d-flex flex-column flex-md-row justify-content-between gap-3">
                                <div class="flex-grow-1">
                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                        <span class="fw-bold fs-5">
                                            <i class="bi bi-clock me-1 text-secondary"></i>@startTpe.ToString("yyyy/MM/dd") (@dayZh) @startTpe.ToString("HH:mm") – @endTpe.ToString("HH:mm")
                                        </span>
                                        @if (slot.SlotType == SlotType.SmallGroup)
                                        {
                                            <span class="badge badge-slot-small px-2 py-1">小組指導 · 扣 1 堂</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-slot-group px-2 py-1">團體輔導 · 免費 0 堂</span>
                                        }
                                        @if (slot.IsExtraSlot)
                                        {
                                            <span class="badge bg-warning text-dark">考前加開</span>
                                        }
                                        @if (isMyBooked)
                                        {
                                            <span class="badge bg-success px-2 py-1 fs-6">
                                                <i class="bi bi-check-circle-fill me-1"></i>您已預約此時段
                                            </span>
                                        }
                                        else if (isMyWaitlisted)
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1 fs-6">
                                                <i class="bi bi-clock-history me-1"></i>候補中（順位：#@myWaitlist!.Position）
                                            </span>
                                        }
                                        else if (isFull)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                <i class="bi bi-x-circle me-1"></i>名額已滿
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                                <i class="bi bi-people me-1"></i>剩餘 @slot.RemainingSeats 空位
                                            </span>
                                        }
                                    </div>
                                    <div class="small text-secondary mb-2">
                                        <span class="me-3"><i class="bi bi-journal-bookmark me-1"></i>進度：<strong>@slot.CourseProgress?.Code @slot.CourseProgress?.Title</strong></span>
                                        <span class="me-3"><i class="bi bi-mortarboard me-1"></i>班別：@slot.GradeClass</span>
                                        <span><i class="bi bi-person-workspace me-1"></i>授課：@slot.TeacherUser?.DisplayName</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(slot.Notes))
                                    {
                                        <div class="small text-muted"><i class="bi bi-chat-left-text me-1"></i>備註：@slot.Notes</div>
                                    }
                                </div>

                                <div class="d-flex flex-column justify-content-between align-items-md-end" style="min-width: 270px;">
                                    <div class="w-100 mb-2">
                                        <div class="d-flex justify-content-between align-items-center small mb-1">
                                            <span class="fw-semibold @(isMyBooked ? "text-success" : isMyWaitlisted ? "text-warning-emphasis" : isFull ? "text-danger" : "text-success")">
                                                @(isMyBooked ? "✓ 您已成功佔位" : isMyWaitlisted ? $"排隊候補中（順位：#{myWaitlist!.Position}）" : isFull ? "名額已滿（開放候補）" : $"尚餘 {slot.RemainingSeats} 名空位")
                                            </span>
                                            <span class="text-muted">已約 @slot.CurrentBookedCount / @slot.MaxCapacity</span>
                                        </div>
                                        <div class="seat-progress">
                                            <div class="h-100 @(isMyBooked ? "bg-success" : isMyWaitlisted ? "bg-warning" : isFull ? "bg-danger" : "bg-success")" style="width: @(fillPct)%;"></div>
                                        </div>
                                    </div>

                                    @if (isMyBooked)
                                    {
                                        <div class="text-md-end w-100 bg-white p-2 rounded-2 border">
                                            <div class="d-flex justify-content-between align-items-center gap-2">
                                                <span class="small text-muted">到班目的：<strong>@myBooking?.PurposeName</strong></span>
                                                <button class="btn btn-sm btn-outline-success disabled fw-bold py-1">
                                                    <i class="bi bi-calendar2-check-fill me-1"></i>已在預約名單
                                                </button>
                                            </div>
                                            <div class="small text-secondary mt-1" style="font-size: 0.75rem;">
                                                欲更換時段或取消，請至「我的預約與候補」頁籤操作
                                            </div>
                                        </div>
                                    }
                                    else if (isMyWaitlisted)
                                    {
                                        <div class="text-md-end w-100 bg-warning bg-opacity-10 p-2 rounded-2 border border-warning-subtle">
                                            <div class="d-flex justify-content-between align-items-center gap-2">
                                                <span class="small text-muted">候補目的：<strong>@myWaitlist?.PurposeName</strong></span>
                                                <span class="badge bg-warning text-dark fw-bold py-1 px-2">
                                                    <i class="bi bi-clock-history me-1"></i>排隊候補中（順位：#@myWaitlist?.Position）
                                                </span>
                                            </div>
                                            <div class="small text-secondary mt-1" style="font-size: 0.75rem;">
                                                若有名額釋出系統將依序遞補；可至「我的預約與候補」取消候補
                                            </div>
                                        </div>
                                    }
                                    else if (sameProgressOtherBooked)
                                    {
                                        <div class="text-md-end w-100 bg-light p-2 rounded-2 border">
                                            <div class="small text-warning-emphasis fw-bold mb-1">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>此進度已預約其他時段
                                            </div>
                                            <div class="small text-muted" style="font-size: 0.74rem;">
                                                小組指導每進度限 1 堂；若想更換為此時段，請至「我的預約與候補」執行改期。
                                            </div>
                                        </div>
                                    }
                                    else if (!isFull)
                                    {
                                        var isCutoff = slot.StartsAtUtc <= DateTime.UtcNow.AddMinutes(30);
                                        if (isCutoff)
                                        {
                                            <div class="text-md-end w-100 bg-light p-2 rounded-2 border">
                                                <button class="btn btn-sm btn-secondary disabled w-100 py-1">
                                                    <i class="bi bi-slash-circle me-1"></i>已截止預約（開課前 30 分鐘截止）
                                                </button>
                                            </div>
                                        }
                                        else if (isEnrollmentBlocked)
                                        {
                                            <div class="d-flex flex-column flex-sm-row gap-2 w-100">
                                                <select class="form-select form-select-sm" disabled aria-label="選擇到班目的">
                                                    <option>目的：課後輔導</option>
                                                </select>
                                                <button type="button" class="btn btn-accent btn-sm text-nowrap px-3"
                                                        onclick="showEnrollmentBlockedModal('@student?.FullName', '該學生@(enrollmentStatusDesc)，暫無法登記或候補課堂；請洽班主任辦理學期續報。');">
                                                    <i class="bi bi-check2 me-1"></i>確認預約
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <form method="post" asp-page-handler="BookSlot" class="w-100">
                                                <input type="hidden" name="studentId" value="@student?.Id" />
                                                <input type="hidden" name="slotId" value="@slot.Id" />
                                                <div class="d-flex flex-column flex-sm-row gap-2">
                                                    <select name="purposeName" class="form-select form-select-sm" aria-label="選擇到班目的" required>
                                                        @foreach (var p in Model.PurposeOptions)
                                                        {
                                                            <option value="@p.Name">目的：@p.Name</option>
                                                        }
                                                    </select>
                                                    <button type="submit" class="btn btn-accent btn-sm text-nowrap px-3"
                                                            onclick="return confirm('確認要為 @student?.FullName 預約此時段嗎？');">
                                                        <i class="bi bi-check2 me-1"></i>確認預約
                                                    </button>
                                                </div>
                                            </form>
                                        }
                                    }
                                    else
                                    {
                                        var isCutoff = slot.StartsAtUtc <= DateTime.UtcNow.AddMinutes(30);
                                        if (isCutoff)
                                        {
                                            <div class="text-md-end w-100 bg-light p-2 rounded-2 border">
                                                <button class="btn btn-sm btn-secondary disabled w-100 py-1">
                                                    <i class="bi bi-slash-circle me-1"></i>已截止預約與候補
                                                </button>
                                            </div>
                                        }
                                        else if (isEnrollmentBlocked)
                                        {
                                            <div class="d-flex flex-column flex-sm-row gap-2 w-100">
                                                <select class="form-select form-select-sm" disabled aria-label="選擇候補到班目的">
                                                    <option>目的：課後輔導</option>
                                                </select>
                                                <button type="button" class="btn btn-outline-danger btn-sm text-nowrap px-3 fw-semibold"
                                                        onclick="showEnrollmentBlockedModal('@student?.FullName', '該學生@(enrollmentStatusDesc)，暫無法登記或候補課堂；請洽班主任辦理學期續報。');">
                                                    <i class="bi bi-clock-history me-1"></i>登記候補
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <form method="post" asp-page-handler="JoinWaitlist" class="w-100">
                                                <input type="hidden" name="studentId" value="@student?.Id" />
                                                <input type="hidden" name="slotId" value="@slot.Id" />
                                                <div class="d-flex flex-column flex-sm-row gap-2">
                                                    <select name="purposeName" class="form-select form-select-sm" aria-label="選擇候補到班目的" required>
                                                        @foreach (var p in Model.PurposeOptions)
                                                        {
                                                            <option value="@p.Name">目的：@p.Name</option>
                                                        }
                                                    </select>
                                                    <button type="submit" class="btn btn-outline-danger btn-sm text-nowrap px-3 fw-semibold">
                                                        <i class="bi bi-clock-history me-1"></i>登記候補
                                                    </button>
                                                </div>
                                            </form>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <div id="noMatchSlotNotice" class="card-plato p-4 text-center text-muted d-none">
                        <i class="bi bi-calendar-x fs-2 text-secondary mb-2 d-block"></i>
                        <h4 class="h6 fw-bold mb-1">所選日期目前暫無開放預約的時段</h4>
                        <p class="small text-secondary mb-0">請點選月曆其他標示有小組或團體的日期進行預約。</p>
                    </div>
                </div>
            </div>

            <!-- 預約與改期規則說明卡片 -->
            <div class="card-plato p-3 p-md-4 bg-light border-0">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-info-circle-fill text-primary"></i>
                    <strong class="text-dark">預約與改期規則提醒</strong>
                </div>
                <div class="row g-2 small text-secondary">
                    <div class="col-12 col-md-4">
                        <i class="bi bi-dot text-primary"></i>小組指導每進度限 <strong>1 堂</strong>（扣 1 堂）；團體輔導免費不限堂數。
                    </div>
                    <div class="col-12 col-md-4">
                        <i class="bi bi-dot text-primary"></i>開課前 <strong>24 小時（含）以上</strong>取消自動退還扣抵堂數；未滿 24 小時取消不退堂。
                    </div>
                    <div class="col-12 col-md-4">
                        <i class="bi bi-dot text-primary"></i>名額額滿可登記候補，釋出空位時系統將依順位直接自動補上轉正、扣堂並發送 LINE 推播通知。
                    </div>
                </div>
            </div>
        </div>


        <!-- 分頁二：我的預約與候補紀錄 -->
        <div class="tab-pane fade" id="tab-parent-records" role="tabpanel">
            <div class="row g-4">
                <div class="col-12 col-xl-8">
                    <div class="card-plato p-3 p-md-4 h-100">
                        <div class="section-header-clean">
                            <div>
                                <h2 class="h5 fw-bold mb-0">@(student?.FullName) 的預約與候補清單</h2>
                                <div class="small text-muted">包含已確認預約與候補排隊，統一依開課時間排序；支援改期、取消預約或取消候補</div>
                            </div>
                        </div>

                        @{
                            var activeBookingList = Model.StudentBookings
                                .Where(b => b.Status == BookingStatus.Confirmed)
                                .Select(b => new {
                                    IsWaitlist = false,
                                    StartsAtUtc = b.TutoringSlot!.StartsAtUtc,
                                    Slot = b.TutoringSlot,
                                    Booking = (Booking?)b,
                                    Waitlist = (WaitlistEntry?)null
                                });

                            var activeWaitlistList = Model.StudentWaitlistEntries
                                .Where(w => w.Status == WaitlistStatus.Waiting || w.Status == WaitlistStatus.NotifiedHold)
                                .Select(w => new {
                                    IsWaitlist = true,
                                    StartsAtUtc = w.TutoringSlot!.StartsAtUtc,
                                    Slot = w.TutoringSlot,
                                    Booking = (Booking?)null,
                                    Waitlist = (WaitlistEntry?)w
                                });

                            var combinedScheduleList = activeBookingList.Concat(activeWaitlistList)
                                .OrderBy(x => x.StartsAtUtc)
                                .ToList();
                        }

                        @if (!combinedScheduleList.Any())
                        {
                            <div class="text-muted small py-4 text-center">目前尚無預約或候補紀錄。</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle table-plato table-responsive-cards mb-0">
                                    <thead>
                                        <tr>
                                            <th>時段與進度</th>
                                            <th>類型 / 到班目的</th>
                                            <th>扣堂明細</th>
                                            <th>狀態 / 順位</th>
                                            <th>操作</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in combinedScheduleList)
                                        {
                                            var slot = item.Slot!;
                                            var sTpe = BookingService.ToTaipeiTime(slot.StartsAtUtc);
                                            var dayZh = "日一二三四五六"[(int)sTpe.DayOfWeek];

                                            if (!item.IsWaitlist)
                                            {
                                                var b = item.Booking!;
                                                var hoursLeft = (slot.StartsAtUtc - DateTime.UtcNow).TotalHours;
                                                var sameProgressTargets = Model.AllCurrentSlots
                                                    .Where(s => s.CourseProgressId == slot.CourseProgressId
                                                                && s.Id != slot.Id
                                                                && s.RemainingSeats > 0
                                                                && s.SlotType == slot.SlotType
                                                                && s.StartsAtUtc > DateTime.UtcNow.AddMinutes(30))
                                                    .OrderBy(s => s.StartsAtUtc)
                                                    .ToList();
                                                var attendanceZh = b.AttendanceStatus switch {
                                                    AttendanceStatus.Pending => "待點名",
                                                    AttendanceStatus.Present => "出席",
                                                    AttendanceStatus.Absent => "請假",
                                                    AttendanceStatus.NoShow => "曠課",
                                                    _ => b.AttendanceStatus.ToString()
                                                };

                                                <tr>
                                                    <td data-label="時段與進度">
                                                        <div>
                                                            <div class="fw-bold text-dark">@sTpe.ToString("MM/dd") (@dayZh) @sTpe.ToString("HH:mm")</div>
                                                            <div class="small text-muted">@slot.CourseProgress?.Code @slot.GradeClass</div>
                                                        </div>
                                                    </td>
                                                    <td data-label="類型 / 目的">
                                                        <div>
                                                            <span class="badge @(slot.SlotType == SlotType.SmallGroup ? "badge-slot-small" : "badge-slot-group")">
                                                                @(slot.SlotType == SlotType.SmallGroup ? "小組指導" : "團體輔導")
                                                            </span>
                                                            <div class="small fw-semibold mt-1">@b.PurposeName</div>
                                                        </div>
                                                    </td>
                                                    <td data-label="扣堂明細">
                                                        @if (b.CreditsDeducted == 0)
                                                        {
                                                            <span class="text-muted small">免費 (0 堂)</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="small">
                                                                贈送 @b.BonusCreditsUsed 堂 + 付費 @b.PaidCreditsUsed 堂
                                                            </span>
                                                        }
                                                    </td>
                                                    <td data-label="狀態 / 順位">
                                                        <div>
                                                            <span class="badge bg-success">
                                                                已預約
                                                            </span>
                                                            <span class="badge bg-light text-dark border ms-1">點名：@attendanceZh</span>
                                                        </div>
                                                    </td>
                                                    <td data-label="操作">
                                                        <div class="d-flex flex-column gap-2">
                                                            <!-- 改期區塊 -->
                                                            <div class="p-2 rounded bg-light border">
                                                                <div class="small fw-semibold text-dark mb-1">
                                                                    <i class="bi bi-arrow-left-right me-1 text-primary"></i>改期至同進度其他時段：
                                                                </div>
                                                                @if (hoursLeft < 24)
                                                                {
                                                                    <div class="small text-muted" style="font-size: 0.74rem;">
                                                                        開課前 24 小時內不可改期
                                                                    </div>
                                                                }
                                                                else if (!sameProgressTargets.Any())
                                                                {
                                                                    <div class="small text-muted" style="font-size: 0.74rem;">
                                                                        此進度目前無其他可改期空位時段
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <form method="post" asp-page-handler="Reschedule" class="d-flex gap-1">
                                                                        <input type="hidden" name="studentId" value="@student.Id" />
                                                                        <input type="hidden" name="existingBookingId" value="@b.Id" />
                                                                        <select name="targetSlotId" class="form-select form-select-sm" aria-label="選擇改期目標時段" required>
                                                                            @foreach (var tgt in sameProgressTargets)
                                                                            {
                                                                                var tStart = BookingService.ToTaipeiTime(tgt.StartsAtUtc);
                                                                                var tDayZh = "日一二三四五六"[(int)tStart.DayOfWeek];
                                                                                <option value="@tgt.Id">@tStart.ToString("MM/dd") (@tDayZh) @tStart.ToString("HH:mm") (餘 @tgt.RemainingSeats 名)</option>
                                                                            }
                                                                        </select>
                                                                        <button type="submit" class="btn btn-outline-primary btn-sm text-nowrap fw-bold"
                                                                                onclick="return confirm('確定要更換至所選的新時段嗎？');">改期</button>
                                                                    </form>
                                                                }
                                                            </div>

                                                            <!-- 取消預約按鈕 -->
                                                            <form method="post" asp-page-handler="CancelBooking">
                                                                <input type="hidden" name="studentId" value="@student.Id" />
                                                                <input type="hidden" name="bookingId" value="@b.Id" />
                                                                <button type="submit" class="btn btn-outline-danger btn-sm w-100"
                                                                        onclick="return confirm('@(hoursLeft >= 24 ? "目前距離開課滿 24 小時，取消將全額退還原扣抵堂數。確定取消？" : "注意：距離開課已不足 24 小時，取消將不退還堂數！確定取消？")');">
                                                                    <i class="bi bi-x-circle me-1"></i>取消預約 @(hoursLeft >= 24 ? "(退還堂數)" : "(逾時不退)")
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                var w = item.Waitlist!;

                                                <tr>
                                                    <td data-label="時段與進度">
                                                        <div>
                                                            <div class="fw-bold text-dark">@sTpe.ToString("MM/dd") (@dayZh) @sTpe.ToString("HH:mm")</div>
                                                            <div class="small text-muted">@slot.CourseProgress?.Code @slot.GradeClass</div>
                                                        </div>
                                                    </td>
                                                    <td data-label="類型 / 目的">
                                                        <div>
                                                            <span class="badge @(slot.SlotType == SlotType.SmallGroup ? "badge-slot-small" : "badge-slot-group")">
                                                                @(slot.SlotType == SlotType.SmallGroup ? "小組指導" : "團體輔導")
                                                            </span>
                                                            <div class="small fw-semibold mt-1">@w.PurposeName</div>
                                                        </div>
                                                    </td>
                                                    <td data-label="扣堂明細">
                                                        <span class="small text-muted">
                                                            <i class="bi bi-info-circle me-1"></i>候補免先扣堂（釋出空位直接自動補上扣 1 堂）
                                                        </span>
                                                    </td>
                                                    <td data-label="狀態 / 順位">
                                                        <div>
                                                            <span class="badge bg-warning text-dark">
                                                                <i class="bi bi-hourglass-split me-1"></i>排隊候補中
                                                            </span>
                                                            <div class="small text-primary fw-bold mt-1">
                                                                順位：第 @w.Position 位
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td data-label="操作">
                                                        <form method="post" asp-page-handler="CancelWaitlist">
                                                            <input type="hidden" name="studentId" value="@student.Id" />
                                                            <input type="hidden" name="waitlistEntryId" value="@w.Id" />
                                                            <button type="submit" class="btn btn-outline-danger btn-sm w-100" onclick="return confirm('確定要取消候補此時段嗎？取消後將釋出順位並重新調整其他候補學生。');">
                                                                <i class="bi bi-x-circle me-1"></i>取消候補
                                                            </button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-12 col-xl-4">
                    <div class="card-plato p-3 p-md-4 h-100">
                        <div class="section-header-clean">
                            <div>
                                <h2 class="h5 fw-bold mb-0">LINE 官方帳號通知</h2>
                                <div class="small text-muted">7 大即時推播與異動歷程</div>
                            </div>
                        </div>

                        <!-- LINE 官方帳號通知綁定狀態與操作 -->
                        <div class="p-3 mb-3 bg-light rounded-3 border">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold small text-dark"><i class="bi bi-line text-success me-1"></i>LINE 官方帳號通知綁定</span>
                                @if (!string.IsNullOrWhiteSpace(Model.CurrentUser.LineUserId))
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-check-circle-fill me-1"></i>已完成綁定
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                        <i class="bi bi-exclamation-circle me-1"></i>尚未綁定
                                    </span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model.CurrentUser.LineUserId))
                            {
                                <div class="small text-muted mb-2">目前接收通知 ID：<code>@Model.CurrentUser.LineUserId</code>（支援 7 大條件即時推播）</div>
                                <form method="post" asp-page-handler="UnbindLine" class="d-inline" data-no-loading="true" onsubmit="return confirm('確定要解除 LINE 官方帳號通知綁定嗎？');">
                                    <input type="hidden" name="studentId" value="@student.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">解除綁定</button>
                                </form>
                            }
                            else
                            {
                                <div class="small text-secondary mb-2">綁定後即可接收堂數異動、預約成功、開課前48小時提醒與候補釋出等 7 大即時通知。</div>
                                <form method="post" asp-page-handler="BindLine" class="d-flex gap-2">
                                    <input type="hidden" name="studentId" value="@student.Id" />
                                    <input type="text" name="lineUserId" class="form-control form-control-sm" placeholder="輸入 LINE User ID" required />
                                    <button type="submit" class="btn btn-sm btn-success text-nowrap fw-bold">立即綁定</button>
                                </form>
                            }
                        </div>

                        <div class="small fw-semibold text-secondary mb-2">最近收到的 LINE 通知：</div>
                        @if (!Model.RecentLineLogs.Any())
                        {
                            <div class="text-muted small">尚無通知紀錄。</div>
                        }
                        else
                        {
                            <div class="d-grid gap-2">
                                @foreach (var log in Model.RecentLineLogs)
                                {
                                    var logDayZh = "日一二三四五六"[(int)BookingService.ToTaipeiTime(log.SentAtUtc).DayOfWeek];
                                    <div class="p-2 bg-light border rounded-3 small">
                                        <div class="d-flex justify-content-between text-muted mb-1">
                                            <span class="fw-semibold text-dark">@log.NotificationType</span>
                                            <span>@BookingService.ToTaipeiTime(log.SentAtUtc).ToString("MM/dd") (@logDayZh) @BookingService.ToTaipeiTime(log.SentAtUtc).ToString("HH:mm")</span>
                                        </div>
                                        <div>@log.MessageText</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- 分頁三：堂數異動流水帳 -->
        <div class="tab-pane fade" id="tab-parent-ledger" role="tabpanel">
            <div class="card-plato p-3 p-md-4">
                <div class="section-header-clean">
                    <div>
                        <h2 class="h5 fw-bold mb-0">@student.FullName 的堂數異動流水帳</h2>
                        <div class="small text-muted">每筆儲值、贈送、扣抵、取消退還與沖正皆為不可覆寫之 Append-Only 紀錄</div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle table-plato table-responsive-cards mb-0">
                        <thead>
                            <tr>
                                <th>時間 (台北時間)</th>
                                <th>狀態</th>
                                <th>贈送異動</th>
                                <th>付費異動</th>
                                <th>異動後餘額 (贈送 / 付費)</th>
                                <th>摘要與操作人</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in Model.StudentLedgerEntries)
                            {
                                var lgtTpe = BookingService.ToTaipeiTime(e.CreatedAtUtc);
                                var lgDayZh = "日一二三四五六"[(int)lgtTpe.DayOfWeek];
                                var txZh = e.TransactionType switch {
                                    LedgerTransactionType.TopUpPaid => "儲值入帳",
                                    LedgerTransactionType.SemesterBonusGrant => "學期贈送",
                                    LedgerTransactionType.ManualBonusGrant => "手動贈送",
                                    LedgerTransactionType.BookingDeduct => "預約扣堂",
                                    LedgerTransactionType.CancelRefund => "取消退堂",
                                    LedgerTransactionType.AdjustmentReversal => "沖正調整",
                                    LedgerTransactionType.SemesterBonusExpiry => "學期到期歸零",
                                    LedgerTransactionType.DropoutSettlementDeduct => "退班結算扣除",
                                    _ => e.TransactionType.ToString()
                                };
                                <tr>
                                    <td data-label="時間">@lgtTpe.ToString("yyyy-MM-dd") (@lgDayZh) @lgtTpe.ToString("HH:mm")</td>
                                    <td data-label="狀態"><span class="badge bg-secondary">@txZh</span></td>
                                    <td data-label="贈送異動" class="fw-bold @(e.BonusDelta > 0 ? "text-success" : e.BonusDelta < 0 ? "text-danger" : "text-muted")">
                                        @(e.BonusDelta > 0 ? $"+{e.BonusDelta}" : e.BonusDelta.ToString())
                                    </td>
                                    <td data-label="付費異動" class="fw-bold @(e.PaidDelta > 0 ? "text-primary" : e.PaidDelta < 0 ? "text-danger" : "text-muted")">
                                        @(e.PaidDelta > 0 ? $"+{e.PaidDelta}" : e.PaidDelta.ToString())
                                    </td>
                                    <td data-label="異動後餘額">
                                        贈送 <strong>@e.BonusBalanceAfter</strong> 堂 / 付費 <strong>@e.PaidBalanceAfter</strong> 堂
                                    </td>
                                    <td data-label="摘要與操作人" class="small">
                                        @e.ReferenceNote <span class="text-muted">(@e.OperatorName)</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

<!-- 週期預約 Modal -->
<div class="modal fade" id="modalRecurringBooking" tabindex="-1" aria-labelledby="modalRecurringBookingLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title h6 fw-bold" id="modalRecurringBookingLabel">
                    <i class="bi bi-arrow-repeat me-1"></i>週期預約（批次預約所選時段）
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @if (Model.SelectedStudent != null)
            {
                <form method="post" asp-page-handler="RecurringBook">
                    <div class="modal-body">
                        <input type="hidden" name="studentId" value="@Model.SelectedStudent.Id" />
                        
                        <!-- 篩選條件：週一～週日 & 年別 -->
                        <div class="p-3 bg-light rounded-3 mb-3 border">
                            <div class="row g-3 align-items-center">
                                <div class="col-12 col-md-7">
                                    <label class="form-label small fw-bold text-dark mb-1">星期篩選（週一至週日）：</label>
                                    <div class="d-flex flex-wrap gap-1" id="recurringDayFilters">
                                        <button type="button" class="btn btn-sm btn-outline-primary active day-filter-btn" data-day="1">週一</button>
                                        <button type="button" class="btn btn-sm btn-outline-primary active day-filter-btn" data-day="2">週二</button>
                                        <button type="button" class="btn btn-sm btn-outline-primary active day-filter-btn" data-day="3">週三</button>
                                        <button type="button" class="btn btn-sm btn-outline-primary active day-filter-btn" data-day="4">週四</button>
                                        <button type="button" class="btn btn-sm btn-outline-primary active day-filter-btn" data-day="5">週五</button>
                                        <button type="button" class="btn btn-sm btn-outline-primary active day-filter-btn" data-day="6">週六</button>
                                        <button type="button" class="btn btn-sm btn-outline-primary active day-filter-btn" data-day="0">週日</button>
                                        <button type="button" class="btn btn-sm btn-link text-decoration-none py-0 px-2" onclick="toggleAllDays(true)">全選</button>
                                        <button type="button" class="btn btn-sm btn-link text-decoration-none py-0 px-1 text-secondary" onclick="toggleAllDays(false)">清空</button>
                                    </div>
                                </div>
                                <div class="col-12 col-md-5">
                                    <label class="form-label small fw-bold text-dark mb-1">年別篩選：</label>
                                    <select class="form-select form-select-sm" id="recurringGradeFilter" onchange="filterRecurringSlots()">
                                        <option value="">全部年別</option>
                                        @foreach (var g in Model.GradeOptions)
                                        {
                                            <option value="@g">@g</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- 到班目的設定 -->
                        <div class="row g-2 mb-3 align-items-center">
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-bold text-dark mb-1">統一到班目的：</label>
                                <select name="purposeName" class="form-select form-select-sm" required>
                                    @foreach (var p in Model.PurposeOptions)
                                    {
                                        <option value="@p.Name">目的：@p.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-md-6 d-flex align-items-end justify-content-md-end gap-2 pt-2 pt-md-0">
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAllVisibleSlots(true)">勾選所有符合時段</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAllVisibleSlots(false)">全取消</button>
                            </div>
                        </div>

                        <!-- 可預約時段清單 -->
                        <div class="table-responsive border rounded-3" style="max-height: 380px;">
                            <table class="table table-hover table-sm align-middle mb-0" id="recurringSlotsTable">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width: 40px;" class="text-center">選取</th>
                                        <th>日期時間 (台北)</th>
                                        <th>類型</th>
                                        <th>進度與年別</th>
                                        <th>剩餘名額</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!Model.AllCurrentSlots.Any())
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-4">目前沒有開放預約的未來時段。</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var slot in Model.AllCurrentSlots.OrderBy(s => s.StartsAtUtc))
                                        {
                                            var slotTpe = BookingService.ToTaipeiTime(slot.StartsAtUtc);
                                            var dayOfWeekInt = (int)slotTpe.DayOfWeek;
                                            var dayOfWeekZh = "日一二三四五六"[dayOfWeekInt];
                                            var isMyBooked = Model.StudentBookings.Any(b => b.TutoringSlotId == slot.Id);
                                            var isCutoff = slot.StartsAtUtc <= DateTime.UtcNow.AddMinutes(30);
                                            var isFull = slot.RemainingSeats <= 0;
                                            var isDisabled = isMyBooked || isCutoff || isFull;

                                            <tr class="recurring-slot-row"
                                                data-day-of-week="@dayOfWeekInt"
                                                data-grade="@slot.GradeClass">
                                                <td class="text-center">
                                                    @if (isDisabled)
                                                    {
                                                        <input type="checkbox" class="form-check-input" disabled />
                                                    }
                                                    else
                                                    {
                                                        <input type="checkbox" name="slotIds" value="@slot.Id" class="form-check-input recurring-slot-checkbox" />
                                                    }
                                                </td>
                                                <td>
                                                    <div class="fw-bold">@slotTpe.ToString("yyyy/MM/dd") (週@dayOfWeekZh)</div>
                                                    <div class="small text-muted">@slotTpe.ToString("HH:mm") ~ @BookingService.ToTaipeiTime(slot.EndsAtUtc).ToString("HH:mm")</div>
                                                </td>
                                                <td>
                                                    <span class="badge @(slot.SlotType == SlotType.GroupCounseling ? "bg-info-subtle text-info border border-info-subtle" : "bg-primary-subtle text-primary border border-primary-subtle")">
                                                        @(slot.SlotType == SlotType.GroupCounseling ? "團體輔導" : "小組指導")
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="fw-semibold">@slot.CourseProgress?.Code @slot.CourseProgress?.Title</div>
                                                    <div class="small text-muted">年別：@slot.GradeClass ｜ 師資：@slot.TeacherUser?.DisplayName</div>
                                                </td>
                                                <td>
                                                    @if (isMyBooked)
                                                    {
                                                        <span class="badge bg-success-subtle text-success">已預約</span>
                                                    }
                                                    else if (isCutoff)
                                                    {
                                                        <span class="badge bg-secondary">已截止</span>
                                                    }
                                                    else if (isFull)
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger">已額滿</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success">餘 @slot.RemainingSeats 位</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">取消</button>
                        <button type="submit" class="btn btn-primary btn-sm px-4 fw-bold" onclick="return confirmRecurringSubmit();">
                            <i class="bi bi-check-all me-1"></i>一次預約所選時段
                        </button>
                    </div>
                </form>
            }
            else
            {
                <div class="modal-body text-center py-5 text-muted">
                    <i class="bi bi-person-x fs-1 text-warning d-block mb-2"></i>
                    <h5 class="fw-bold text-dark">尚未選擇學生</h5>
                    <p class="small text-secondary mb-0">請先於頁面上方切換或選擇獲授權的孩子，再進行週期預約。</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">關閉</button>
                </div>
            }
        </div>
    </div>
</div>

<!-- 休假日詳情彈窗 Modal -->
<div class="modal fade" id="modalHolidayNotice" tabindex="-1" aria-labelledby="modalHolidayNoticeLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title h6 fw-bold" id="modalHolidayNoticeLabel">
                    <i class="bi bi-moon-stars-fill me-2"></i>機構休假日通知
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <div class="display-6 text-danger mb-2">🏖️</div>
                <h5 class="fw-bold text-dark mb-1" id="holidayNoticeDateText">--</h5>
                <div class="mb-3">
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle fs-6 px-3 py-2" id="holidayNoticeReasonBadge">
                        --
                    </span>
                </div>
                <div class="p-3 bg-light rounded-3 text-secondary small text-start">
                    <div class="fw-semibold text-dark mb-1"><i class="bi bi-info-circle me-1 text-primary"></i>停課與預約限制說明：</div>
                    該日為本機構排定之公休日／節日休假，當天<strong>全日停課</strong>，暫停所有小組指導與團體輔導預約服務。如需預約其他日期輔導，請點選月曆其他開放日期。祝您假期愉快！
                </div>
            </div>
            <div class="modal-footer justify-content-center bg-light">
                <button type="button" class="btn btn-secondary px-4 fw-semibold" data-bs-dismiss="modal">我知道了</button>
            </div>
        </div>
    </div>
</div>

<!-- 無法預約/候補提醒視窗 Modal -->
<div class="modal fade" id="modalEnrollmentBlocked" tabindex="-1" aria-labelledby="modalEnrollmentBlockedLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-warning bg-opacity-10 border-bottom border-warning-subtle">
                <h5 class="modal-title fw-bold text-warning-emphasis d-flex align-items-center gap-2" id="modalEnrollmentBlockedLabel">
                    <i class="bi bi-exclamation-triangle-fill fs-4 text-warning"></i>
                    無法預約或登記候補
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
            </div>
            <div class="modal-body p-4">
                <div class="d-flex align-items-start gap-3 mb-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-warning bg-warning bg-opacity-10 flex-shrink-0" style="width: 48px; height: 48px;">
                        <i class="bi bi-person-x fs-3"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1 text-dark" id="enrollmentBlockedStudentName">@student?.FullName</h6>
                        <p class="text-secondary small mb-0" id="enrollmentBlockedMessage">
                            該學生本學期尚未完成續報（或已退班），暫無法登記或候補課堂；請洽班主任辦理學期續報。
                        </p>
                    </div>
                </div>
                <div class="p-3 bg-light rounded-3 border small text-muted">
                    <i class="bi bi-info-circle me-1 text-primary"></i>如已完成續費或確認在籍，請向補習班行政老師確認學生學籍狀態已更新為「本學期在學」。
                </div>
            </div>
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-secondary px-4 fw-semibold" data-bs-dismiss="modal">我知道了</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showEnrollmentBlockedModal(studentName, message) {
            const nameEl = document.getElementById('enrollmentBlockedStudentName');
            const msgEl = document.getElementById('enrollmentBlockedMessage');
            if (nameEl && studentName) nameEl.textContent = studentName;
            if (msgEl && message) msgEl.textContent = message;

            const modalElem = document.getElementById('modalEnrollmentBlocked');
            if (modalElem) {
                const modal = bootstrap.Modal.getInstance(modalElem) || new bootstrap.Modal(modalElem);
                modal.show();
            }
        }
        window.showEnrollmentBlockedModal = showEnrollmentBlockedModal;

        function showHolidayNoticeModal(dateZh, reason) {
            document.getElementById('holidayNoticeDateText').textContent = dateZh || '休假日';
            document.getElementById('holidayNoticeReasonBadge').textContent = '節日 / 休假原因：' + (reason || '機構公休');
            new bootstrap.Modal(document.getElementById('modalHolidayNotice')).show();
        }
        window.showHolidayNoticeModal = showHolidayNoticeModal;

        function selectCalendarDate(dateStr, dateZh) {
            if (!dateStr) return;

            // 1. 更新月曆格子的選中樣式
            document.querySelectorAll('.calendar-month-cell').forEach(cell => {
                if (cell.getAttribute('data-date') === dateStr) {
                    cell.classList.add('selected-day');
                } else {
                    cell.classList.remove('selected-day');
                }
            });

            // 2. 顯示課堂容器，隱藏未選擇提示
            const noDatePrompt = document.getElementById('noDateSelectedPrompt');
            const daySlotsContainer = document.getElementById('daySlotsContainer');
            if (noDatePrompt) noDatePrompt.classList.add('d-none');
            if (daySlotsContainer) daySlotsContainer.classList.remove('d-none');

            // 3. 篩選當日課堂卡片
            let matchCount = 0;
            document.querySelectorAll('.slot-card-item').forEach(card => {
                if (card.getAttribute('data-slot-date') === dateStr) {
                    card.classList.remove('d-none');
                    matchCount++;
                } else {
                    card.classList.add('d-none');
                }
            });

            // 4. 當日無符合時段之提示處理
            const noMatchNotice = document.getElementById('noMatchSlotNotice');
            if (noMatchNotice) {
                if (matchCount === 0) {
                    noMatchNotice.classList.remove('d-none');
                } else {
                    noMatchNotice.classList.add('d-none');
                }
            }

            // 5. 更新標題文字
            const titleElem = document.getElementById('selectedDateTitle');
            const subTitleElem = document.getElementById('selectedDateSubtitle');
            if (titleElem) {
                titleElem.textContent = `📅 ${dateZh || dateStr} 當日課堂列表`;
            }
            if (subTitleElem) {
                subTitleElem.textContent = matchCount > 0 
                    ? `當天共開放 ${matchCount} 堂輔導課，請選擇到班目的後預約`
                    : `當天暫無開放預約之輔導課堂`;
            }

            // 6. 更新網址 query string（保留原有 hash，不重新整理頁面）
            try {
                const url = new URL(window.location.href);
                url.searchParams.set('date', dateStr);
                history.replaceState(null, null, url.toString());
            } catch (err) {
                console.warn('Unable to update history state:', err);
            }

            // 7. 平滑捲動至時段列表
            daySlotsContainer?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function clearSelectedDate() {
            // 1. 清除月曆選取樣式
            document.querySelectorAll('.calendar-month-cell').forEach(cell => {
                cell.classList.remove('selected-day');
            });

            // 2. 隱藏課堂容器，顯示提示
            const noDatePrompt = document.getElementById('noDateSelectedPrompt');
            const daySlotsContainer = document.getElementById('daySlotsContainer');
            if (noDatePrompt) noDatePrompt.classList.remove('d-none');
            if (daySlotsContainer) daySlotsContainer.classList.add('d-none');

            // 3. 隱藏所有課堂卡片
            document.querySelectorAll('.slot-card-item').forEach(card => {
                card.classList.add('d-none');
            });

            const noMatchNotice = document.getElementById('noMatchSlotNotice');
            if (noMatchNotice) noMatchNotice.classList.add('d-none');

            // 4. 移除網址中的 date 參數
            try {
                const url = new URL(window.location.href);
                url.searchParams.delete('date');
                history.replaceState(null, null, url.toString());
            } catch (err) {
                console.warn('Unable to update history state:', err);
            }
        }

        // 明確暴露至全域 window 物件
        window.selectCalendarDate = selectCalendarDate;
        window.clearSelectedDate = clearSelectedDate;

        // 全域事件委派：攔截月曆格子點擊（即便子元素點擊亦能精準捕捉）
        document.addEventListener('click', function (e) {
            const cell = e.target.closest('.calendar-month-cell.has-slots');
            if (cell) {
                const dateStr = cell.getAttribute('data-date');
                const dateZh = cell.getAttribute('data-date-zh');
                if (dateStr) {
                    selectCalendarDate(dateStr, dateZh);
                }
            }
        });

        // 全域鍵盤無障礙支援：Enter 或空白鍵觸發
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') {
                const cell = e.target.closest('.calendar-month-cell.has-slots');
                if (cell && (document.activeElement === cell || cell.contains(document.activeElement))) {
                    e.preventDefault();
                    const dateStr = cell.getAttribute('data-date');
                    const dateZh = cell.getAttribute('data-date-zh');
                    if (dateStr) {
                        selectCalendarDate(dateStr, dateZh);
                    }
                }
            }
        });

        document.addEventListener('DOMContentLoaded', function () {
            @if (TempData["EnrollmentBlockedMessage"] is string blockedMsg)
            {
                <text>
                showEnrollmentBlockedModal('@student?.FullName', '@blockedMsg');
                </text>
            }

            // 保留切換孩子時的目前頁籤
            const hash = window.location.hash;
            if (hash) {
                const targetBtn = document.querySelector(`#parentWorkspaceTabs button[data-bs-target="${hash}"]`);
                if (targetBtn) {
                    const tab = new bootstrap.Tab(targetBtn);
                    tab.show();
                }
            }

            const tabButtons = document.querySelectorAll('#parentWorkspaceTabs button[data-bs-toggle="pill"]');
            tabButtons.forEach(btn => {
                btn.addEventListener('shown.bs.tab', function (e) {
                    const target = e.target.getAttribute('data-bs-target');
                    if (target) {
                        history.replaceState(null, null, target);
                    }
                });
            });

            // 若網址帶有 date 參數，且該日期格子存在，自動觸發選取
            const urlParams = new URLSearchParams(window.location.search);
            const dateParam = urlParams.get('date');
            if (dateParam) {
                const targetCell = document.querySelector(`.calendar-month-cell[data-date="${dateParam}"]`);
                if (targetCell) {
                    const dateZh = targetCell.getAttribute('data-date-zh') || dateParam;
                    selectCalendarDate(dateParam, dateZh);
                }
            }

            // 初始化週期預約星期按鈕監聽
            document.querySelectorAll('#recurringDayFilters .day-filter-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    this.classList.toggle('active');
                    if (this.classList.contains('active')) {
                        this.classList.remove('btn-outline-primary');
                        this.classList.add('btn-primary');
                    } else {
                        this.classList.add('btn-outline-primary');
                        this.classList.remove('btn-primary');
                    }
                    filterRecurringSlots();
                });
            });

            // 監聽週期預約 Modal 開啟，自動重新整理過濾
            const recModal = document.getElementById('modalRecurringBooking');
            if (recModal) {
                recModal.addEventListener('show.bs.modal', function () {
                    filterRecurringSlots();
                });
            }
        });

        function openRecurringBookingModal() {
            filterRecurringSlots();
            const modalElem = document.getElementById('modalRecurringBooking');
            if (modalElem) {
                const modal = bootstrap.Modal.getInstance(modalElem) || new bootstrap.Modal(modalElem);
                modal.show();
            }
        }
        window.openRecurringBookingModal = openRecurringBookingModal;

        function filterRecurringSlots() {
            // 取得選取的星期集合
            const activeDays = new Set();
            document.querySelectorAll('#recurringDayFilters .day-filter-btn.active').forEach(btn => {
                activeDays.add(btn.getAttribute('data-day'));
            });

            const gradeFilter = document.getElementById('recurringGradeFilter')?.value || '';

            document.querySelectorAll('.recurring-slot-row').forEach(row => {
                const day = row.getAttribute('data-day-of-week');
                const grade = row.getAttribute('data-grade') || '';

                const matchesDay = activeDays.has(day);
                const matchesGrade = !gradeFilter || grade === gradeFilter;

                if (matchesDay && matchesGrade) {
                    row.classList.remove('d-none');
                } else {
                    row.classList.add('d-none');
                    // 隱藏時取消勾選避免誤提交
                    const chk = row.querySelector('.recurring-slot-checkbox');
                    if (chk) chk.checked = false;
                }
            });
        }

        function toggleAllDays(select) {
            document.querySelectorAll('#recurringDayFilters .day-filter-btn').forEach(btn => {
                if (select) {
                    btn.classList.add('active');
                    btn.classList.remove('btn-outline-primary');
                    btn.classList.add('btn-primary');
                } else {
                    btn.classList.remove('active');
                    btn.classList.add('btn-outline-primary');
                    btn.classList.remove('btn-primary');
                }
            });
            filterRecurringSlots();
        }

        function selectAllVisibleSlots(checked) {
            document.querySelectorAll('.recurring-slot-row:not(.d-none) .recurring-slot-checkbox').forEach(chk => {
                if (!chk.disabled) {
                    chk.checked = checked;
                }
            });
        }

        function confirmRecurringSubmit() {
            const checkedBoxes = document.querySelectorAll('.recurring-slot-checkbox:checked');
            if (checkedBoxes.length === 0) {
                alert('請至少勾選一個欲預約的時段！');
                return false;
            }
            return confirm(`確認要一次批次預約所勾選的 ${checkedBoxes.length} 個時段嗎？`);
        }
    </script>
}

