<div class="modal fade" id="modalEditSchedule" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="UpdateScheduleConfig">
                <input type="hidden" name="jobCode" id="editScheduleJobCode" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="editScheduleTitle">
                        <i class="bi bi-clock-history me-2 text-primary"></i>設定排程週期與開關
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
                </div>
                <div class="modal-body">
                    <!-- 1. 開關設定 -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">排程運行開關</label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="isEnabled" id="schedEnabledTrue" value="true">
                                <label class="form-check-label text-success fw-bold" for="schedEnabledTrue">
                                    <i class="bi bi-play-circle me-1"></i>啟用常駐排程
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="isEnabled" id="schedEnabledFalse" value="false">
                                <label class="form-check-label text-secondary fw-semibold" for="schedEnabledFalse">
                                    <i class="bi bi-pause-circle me-1"></i>暫停停用排程
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- 2. 頻率模式 -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">執行週期與時間設定</label>
                        <div class="d-flex flex-column gap-2">
                            <!-- 模式 A：間隔分鐘執行（支援每 1 分鐘、每 5 分鐘...） -->
                            <div class="border rounded-3 p-3 bg-light">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="frequencyType" id="freqInterval" value="1" onchange="updateFreqModeDisplay()">
                                    <label class="form-check-label fw-bold text-dark" for="freqInterval">
                                        間隔分鐘執行（包含每分鐘、每 5 分鐘...）
                                    </label>
                                </div>
                                <div class="text-muted small mt-1 ps-4">適合候補逾期名額釋放、即時遞補巡檢等短週期頻繁任務</div>
                                <div id="intervalMinutesWrapper" class="mt-2 ps-4">
                                    <div class="input-group input-group-sm" style="max-width: 210px;">
                                        <span class="input-group-text">每隔</span>
                                        <input type="number" name="intervalMinutes" id="editScheduleInterval" class="form-control text-center fw-bold" min="1" max="1440" value="5" />
                                        <span class="input-group-text">分鐘執行</span>
                                    </div>
                                    <div class="d-flex gap-1 mt-2 flex-wrap">
                                        <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" style="font-size:0.75rem;" onclick="setIntervalValue(1)">每 1 分鐘</button>
                                        <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" style="font-size:0.75rem;" onclick="setIntervalValue(5)">每 5 分鐘</button>
                                        <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" style="font-size:0.75rem;" onclick="setIntervalValue(15)">每 15 分鐘</button>
                                        <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" style="font-size:0.75rem;" onclick="setIntervalValue(30)">每 30 分鐘</button>
                                        <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" style="font-size:0.75rem;" onclick="setIntervalValue(60)">每 60 分鐘</button>
                                    </div>
                                </div>
                            </div>

                            <!-- 模式 B：每日固定時間執行（台北時間） -->
                            <div class="border rounded-3 p-3 bg-light">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="frequencyType" id="freqDaily" value="0" onchange="updateFreqModeDisplay()">
                                    <label class="form-check-label fw-bold text-dark" for="freqDaily">
                                        每日固定時間執行（台北時間）
                                    </label>
                                </div>
                                <div class="text-muted small mt-1 ps-4">適合每日學期歸零、課前 LINE 提醒、每日作業催促等每日一次性排程</div>
                                <div id="dailyTimeWrapper" class="mt-2 ps-4">
                                    <div class="input-group input-group-sm" style="max-width: 210px;">
                                        <span class="input-group-text"><i class="bi bi-clock me-1 text-primary"></i>每日</span>
                                        <input type="time" name="dailyTime" id="editScheduleDailyTime" class="form-control fw-bold" value="00:00" />
                                    </div>
                                    <div class="d-flex gap-1 mt-2 flex-wrap">
                                        <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" style="font-size:0.75rem;" onclick="setDailyTimeValue('00:00')">00:00 (午夜)</button>
                                        <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" style="font-size:0.75rem;" onclick="setDailyTimeValue('08:00')">08:00 (早晨)</button>
                                        <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" style="font-size:0.75rem;" onclick="setDailyTimeValue('12:00')">12:00 (中午)</button>
                                        <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" style="font-size:0.75rem;" onclick="setDailyTimeValue('17:00')">17:00 (傍晚)</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary fw-bold">
                        <i class="bi bi-save me-1"></i>儲存排程設定
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditScheduleModal(jobCode, name, isEnabled, freqType, dailyTime, intervalMinutes) {
            document.getElementById('editScheduleJobCode').value = jobCode;
            document.getElementById('editScheduleTitle').innerHTML = '<i class="bi bi-clock-history me-2 text-primary"></i>設定「' + name + '」排程週期與開關';
            
            if (isEnabled) {
                document.getElementById('schedEnabledTrue').checked = true;
            } else {
                document.getElementById('schedEnabledFalse').checked = true;
            }

            if (freqType === 1 || freqType === '1' || freqType === 'IntervalMinutes') {
                document.getElementById('freqInterval').checked = true;
            } else {
                document.getElementById('freqDaily').checked = true;
            }

            document.getElementById('editScheduleDailyTime').value = dailyTime || '00:00';
            document.getElementById('editScheduleInterval').value = intervalMinutes || 5;

            updateFreqModeDisplay();
            new bootstrap.Modal(document.getElementById('modalEditSchedule')).show();
        }

        function updateFreqModeDisplay() {
            const isInterval = document.getElementById('freqInterval').checked;
            document.getElementById('intervalMinutesWrapper').style.opacity = isInterval ? '1' : '0.4';
            document.getElementById('intervalMinutesWrapper').style.pointerEvents = isInterval ? 'auto' : 'none';
            document.getElementById('dailyTimeWrapper').style.opacity = isInterval ? '0.4' : '1';
            document.getElementById('dailyTimeWrapper').style.pointerEvents = isInterval ? 'none' : 'auto';
        }

        function setIntervalValue(val) {
            document.getElementById('editScheduleInterval').value = val;
            document.getElementById('freqInterval').checked = true;
            updateFreqModeDisplay();
        }

        function setDailyTimeValue(val) {
            document.getElementById('editScheduleDailyTime').value = val;
            document.getElementById('freqDaily').checked = true;
            updateFreqModeDisplay();
        }
        function prepareNewSemester() {
            document.getElementById('semIdInput').value = '0';
            document.getElementById('semNameInput').value = '';
            document.getElementById('semStartInput').value = '@DateTime.Today.ToString("yyyy-MM-dd")';
            document.getElementById('semEndInput').value = '@DateTime.Today.AddMonths(6).ToString("yyyy-MM-dd")';
            document.getElementById('semIsCurrentInput').checked = false;
            document.getElementById('semesterFormTitle').innerHTML = '<i class="bi bi-plus-circle me-1 text-primary"></i>新增學期期間';
            document.getElementById('semesterFormMode').textContent = '新增模式';
            document.getElementById('semSubmitBtn').innerHTML = '<i class="bi bi-plus-lg me-1"></i>確認新增學期';
            document.getElementById('semNameInput').focus();
        }

        function loadSemesterForEdit(id, name, start, end, isCurrent) {
            document.getElementById('semIdInput').value = id;
            document.getElementById('semNameInput').value = name;
            document.getElementById('semStartInput').value = start;
            document.getElementById('semEndInput').value = end;
            document.getElementById('semIsCurrentInput').checked = isCurrent;
            document.getElementById('semesterFormTitle').innerHTML = '<i class="bi bi-pencil-square me-1 text-primary"></i>編輯學期期間';
            document.getElementById('semesterFormMode').textContent = '編輯現有學期';
            document.getElementById('semSubmitBtn').innerHTML = '<i class="bi bi-save me-1"></i>儲存學期期間';
        }

        function openCreateOptionModal(category, tabName) {
            document.getElementById('createOptionCategory').value = category || 'School';
            document.getElementById('createOptionValue').value = '';
            document.getElementById('createOptionActiveTab').value = tabName || ('tab-' + (category || 'school').toLowerCase());
            new bootstrap.Modal(document.getElementById('modalCreateOption')).show();
        }

        function openEditOptionModal(id, category, value, sortOrder, tabName) {
            document.getElementById('editOptionId').value = id;
            document.getElementById('editOptionValue').value = value;
            document.getElementById('editOptionSortOrder').value = sortOrder;
            document.getElementById('editOptionActiveTab').value = tabName || ('tab-' + (category || 'school').toLowerCase());
            new bootstrap.Modal(document.getElementById('modalEditOption')).show();
        }

        function openCreatePurposeModal() {
            const form = document.getElementById('formPurpose');
            form.action = '?handler=CreatePurpose';
            document.getElementById('purposeModalTitle').innerHTML = '<i class="bi bi-plus-circle me-2"></i>新增到班目的';
            document.getElementById('purposeId').value = '';
            document.getElementById('purposeName').value = '';
            document.getElementById('purposeSortOrder').value = '0';
            document.getElementById('purposeSubmitBtn').textContent = '確認新增';
            new bootstrap.Modal(document.getElementById('modalPurpose')).show();
        }

        function openEditPurposeModal(id, name, sortOrder) {
            const form = document.getElementById('formPurpose');
            form.action = '?handler=UpdatePurpose';
            document.getElementById('purposeModalTitle').innerHTML = '<i class="bi bi-pencil-square me-2"></i>修改到班目的';
            document.getElementById('purposeId').value = id;
            document.getElementById('purposeName').value = name;
            document.getElementById('purposeSortOrder').value = sortOrder;
            document.getElementById('purposeSubmitBtn').textContent = '儲存修改';
            new bootstrap.Modal(document.getElementById('modalPurpose')).show();
        }

        function openCreateHolidayModal() {
            document.getElementById('holidayDateInput').value = '@DateTime.Today.ToString("yyyy-MM-dd")';
            document.getElementById('holidayNameInput').value = '';
            new bootstrap.Modal(document.getElementById('modalCreateHoliday')).show();
        }

        function openCreateHolidayModalWithDate(dateStr) {
            if (!dateStr) return;
            document.getElementById('holidayDateInput').value = dateStr;
            document.getElementById('holidayNameInput').value = '';
            new bootstrap.Modal(document.getElementById('modalCreateHoliday')).show();
        }

        function switchSubTab(sub) {
            localStorage.setItem('plato_admin_subtab', sub);
        }

        // 保存目前切換的 Tab 分頁到 hash 與 localStorage
        document.addEventListener('DOMContentLoaded', function () {
            // 處理主要子功能切換 (學期行事曆 vs 系統欄位 vs 排程管理)
            const urlParams = new URLSearchParams(window.location.search);
            let subParam = urlParams.get('sub');
            if (!subParam) {
                if (window.location.hash.includes('subtab-notifications')) {
                    subParam = 'notifications';
                } else if (window.location.hash.includes('subtab-fields')) {
                    subParam = 'fields';
                } else if (window.location.hash.includes('subtab-schedules')) {
                    subParam = 'schedules';
                } else if (window.location.hash.includes('subtab-calendar') || urlParams.has('year') || urlParams.has('month') || urlParams.has('semesterId')) {
                    subParam = 'calendar';
                } else if (window.location.hash.includes('tab-')) {
                    subParam = 'fields';
                } else {
                    subParam = localStorage.getItem('plato_admin_subtab') || 'calendar';
                }
            }

            if (subParam === 'notifications') {
                const notifBtn = document.getElementById('subtab-notifications-btn');
                if (notifBtn) new bootstrap.Tab(notifBtn).show();
            } else if (subParam === 'fields') {
                const fieldsBtn = document.getElementById('subtab-fields-btn');
                if (fieldsBtn) new bootstrap.Tab(fieldsBtn).show();
            } else if (subParam === 'schedules') {
                const schedulesBtn = document.getElementById('subtab-schedules-btn');
                if (schedulesBtn) new bootstrap.Tab(schedulesBtn).show();
            } else {
                const calBtn = document.getElementById('subtab-calendar-btn');
                if (calBtn) new bootstrap.Tab(calBtn).show();
            }

            // 處理欄位管理內部的子分頁
            let activeHash = window.location.hash;
            if (!activeHash || activeHash.includes('subtab-')) {
                const saved = localStorage.getItem('plato_admin_tab');
                if (saved) activeHash = saved;
            }
            if (activeHash && !activeHash.includes('subtab-')) {
                if (!activeHash.startsWith('#')) activeHash = '#' + activeHash;
                const targetBtn = document.querySelector(`#adminFieldTabs button[data-bs-target="${activeHash}"]`);
                if (targetBtn) {
                    const tab = new bootstrap.Tab(targetBtn);
                    tab.show();
                }
            }

            const tabButtons = document.querySelectorAll('#adminFieldTabs button[data-bs-toggle="pill"]');
            tabButtons.forEach(btn => {
                btn.addEventListener('shown.bs.tab', function (e) {
                    const target = e.target.getAttribute('data-bs-target');
                    if (target) {
                        history.replaceState(null, null, target);
                        localStorage.setItem('plato_admin_tab', target);
                    }
                });
            });
        });
    </script>
}
