    <!-- =================================================================== -->
    <!-- 子功能 3：排程管理（系統常駐背景定時排程清單、執行時間、歷程紀錄與手動觸發） -->
    <!-- =================================================================== -->
    <div class="tab-pane fade" id="subtab-schedules" role="tabpanel" aria-labelledby="subtab-schedules-btn">
        <div class="card card-plato shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle fw-semibold">
                                <i class="bi bi-broadcast me-1"></i>常駐背景服務已掛載運行中
                            </span>
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle fw-semibold">
                                共 @Model.ScheduledTasks.Count 個排程工作（@(Model.ScheduledTasks.Count(t => t.IsEnabled)) 個啟用中）
                            </span>
                        </div>
                        <h5 class="fw-bold mb-1 text-dark"><i class="bi bi-clock-history me-2 text-primary"></i>系統背景排程管理與執行記錄</h5>
                        <div class="text-muted small">所有排程均已常駐掛載於系統背景。您可自由切換排程開關、自訂執行時間（支援每 N 分鐘或每日固定時間），並直接在各排程下方檢視近 3 筆執行歷程</div>
                    </div>
                </div>
            </div>
            <div class="card-body p-3 p-md-4">
                <div class="row g-3">
                    @foreach (var task in Model.ScheduledTasks)
                    {
                        var isEnabled = task.IsEnabled;
                        <div class="col-12">
                            <div class="border rounded-3 p-3 @(isEnabled ? "bg-white shadow-sm" : "bg-light text-muted opacity-75")">
                                <!-- 卡片頂部：標題、代碼、狀態、開關與操作按鈕 -->
                                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 pb-2 border-bottom">
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <h6 class="fw-bold mb-0 text-dark">
                                            <i class="bi bi-cpu text-primary me-1"></i>@task.Name
                                        </h6>
                                        <code class="text-secondary small">@task.JobCode</code>
                                        @if (isEnabled)
                                        {
                                            <span class="badge bg-success text-white">
                                                <i class="bi bi-play-circle me-1"></i>@task.Status
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary text-white">
                                                <i class="bi bi-pause-circle me-1"></i>已停用
                                            </span>
                                        }
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <!-- 開關切換按鈕 -->
                                        <form method="post" asp-page-handler="ToggleSchedule" class="d-inline">
                                            <input type="hidden" name="jobCode" value="@task.JobCode" />
                                            <input type="hidden" name="isEnabled" value="@(isEnabled ? "false" : "true")" />
                                            <button type="submit" class="btn btn-sm @(isEnabled ? "btn-outline-danger" : "btn-outline-success") fw-bold py-1 px-2"
                                                    title="@(isEnabled ? "點擊暫停停用此排程" : "點擊啟用此排程")">
                                                <i class="bi @(isEnabled ? "bi-pause-fill" : "bi-play-fill") me-1"></i>@(isEnabled ? "停用排程" : "啟用排程")
                                            </button>
                                        </form>

                                        <!-- 設定排程週期按鈕 -->
                                        <button type="button" class="btn btn-sm btn-outline-secondary fw-semibold py-1 px-2"
                                                onclick="openEditScheduleModal('@task.JobCode', '@Html.Raw(task.Name)', @(isEnabled.ToString().ToLower()), '@((int)task.FrequencyType)', '@task.DailyTime', @task.IntervalMinutes)">
                                            <i class="bi bi-gear-fill me-1"></i>設定時間
                                        </button>

                                        <!-- 手動立即執行按鈕 -->
                                        <form method="post" asp-page-handler="TriggerSchedule" onsubmit="return confirm('確定要立即手動執行「@task.Name」嗎？');" class="d-inline">
                                            <input type="hidden" name="jobCode" value="@task.JobCode" />
                                            <button type="submit" class="btn btn-sm btn-primary fw-bold py-1 px-2">
                                                <i class="bi bi-lightning-charge-fill me-1"></i>立即執行
                                            </button>
                                        </form>
                                    </div>
                                </div>

                                <div class="text-secondary small mt-2 mb-3">
                                    @task.Description
                                </div>

                                <!-- 排程運行資訊欄位 -->
                                <div class="row g-2 mb-3 small">
                                    <div class="col-sm-6 col-md-3">
                                        <span class="text-muted d-block">執行週期模式：</span>
                                        <span class="fw-bold text-dark">
                                            <i class="bi bi-clock me-1 text-primary"></i>@task.ScheduleInterval
                                        </span>
                                    </div>
                                    <div class="col-sm-6 col-md-3">
                                        <span class="text-muted d-block">上次執行時間：</span>
                                        @if (task.LastRunAtUtc.HasValue)
                                        {
                                            <span class="fw-semibold text-dark">
                                                @task.LastRunAtUtc.Value.AddHours(8).ToString("yyyy/MM/dd HH:mm:ss")
                                            </span>
                                            @if (task.LastDuration.HasValue)
                                            {
                                                <span class="text-muted ms-1" style="font-size: 0.75rem;">
                                                    (@((int)Math.Round(task.LastDuration.Value.TotalMilliseconds)) ms)
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">尚無紀錄</span>
                                        }
                                    </div>
                                    <div class="col-sm-6 col-md-3">
                                        <span class="text-muted d-block">下次預計執行：</span>
                                        @if (isEnabled && task.NextRunAtUtc.HasValue)
                                        {
                                            <span class="fw-bold text-primary">
                                                <i class="bi bi-hourglass-split me-1"></i>@task.NextRunAtUtc.Value.AddHours(8).ToString("yyyy/MM/dd HH:mm:ss")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-secondary">⏸️ 暫不排程（已停用）</span>
                                        }
                                    </div>
                                    <div class="col-sm-6 col-md-3">
                                        <span class="text-muted d-block">上次執行結果：</span>
                                        <span class="@(task.IsLastSuccess ? "text-success" : "text-danger") fw-semibold text-truncate d-block" title="@task.LastResult">
                                            @task.LastResult
                                        </span>
                                    </div>
                                </div>

                                <!-- 每筆排程下方近 3 筆執行歷程清單 -->
                                <div class="bg-light rounded-3 p-2 border">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="small fw-bold text-secondary">
                                            <i class="bi bi-journal-text me-1 text-primary"></i>近 3 筆執行紀錄
                                        </span>
                                    </div>
                                    @if (!task.RecentLogs.Any())
                                    {
                                        <div class="text-muted text-center py-2 small">尚無執行紀錄</div>
                                    }
                                    else
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.82rem;">
                                                <tbody>
                                                    @foreach (var log in task.RecentLogs.Take(3))
                                                    {
                                                        <tr>
                                                            <td class="text-secondary text-nowrap ps-2" style="width: 170px;">
                                                                @log.TriggeredAtUtc.AddHours(8).ToString("yyyy/MM/dd HH:mm:ss")
                                                            </td>
                                                            <td style="width: 110px;">
                                                                <span class="badge @(log.TriggeredBy.Contains("手動") ? "bg-warning text-dark" : "bg-light text-secondary border")">
                                                                    @log.TriggeredBy
                                                                </span>
                                                            </td>
                                                            <td style="width: 90px;" class="text-muted">
                                                                @((int)Math.Round(log.Duration.TotalMilliseconds)) ms
                                                            </td>
                                                            <td style="width: 80px;">
                                                                <span class="badge @(log.IsSuccess ? "bg-success" : "bg-danger")">
                                                                    @(log.IsSuccess ? "成功" : "失敗")
                                                                </span>
                                                            </td>
                                                            <td class="pe-2 @(log.IsSuccess ? "text-dark" : "text-danger fw-semibold")">
                                                                @log.Message
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- =================================================================== -->
    <!-- 子功能 4：通知管理（LINE 官方帳號通知情境一覽、觸發時機、樣板與近 10 筆通知紀錄） -->
    <!-- =================================================================== -->
    <div class="tab-pane fade" id="subtab-notifications" role="tabpanel" aria-labelledby="subtab-notifications-btn">
        <!-- 頂部資訊卡片 -->
        <div class="card card-plato shadow-sm mb-4 border-0">
            <div class="card-header bg-white py-3">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold">LINE 官方帳號推播</span>
                            <span class="badge bg-light text-secondary border">雙向連動通知體系</span>
                        </div>
                        <h4 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-bell-fill text-success me-2"></i>LINE 官方帳號通知管理中心
                        </h4>
                        <div class="text-muted small mt-1">
                            完整列出系統所有 LINE 官方帳號支援之通知情境、自動觸發條件與訊息樣板，並提供最新 10 筆發送日誌展開檢視與異常手動重試。
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div class="p-2 px-3 bg-light rounded-3 border text-center">
                            <div class="small text-secondary fw-semibold">推播成功總計</div>
                            <div class="h5 fw-bold text-success mb-0">@Model.LineSentCount 筆</div>
                        </div>
                        <div class="p-2 px-3 bg-light rounded-3 border text-center">
                            <div class="small text-secondary fw-semibold">異常 / 待重試</div>
                            <div class="h5 fw-bold @(Model.LineFailedCount > 0 ? "text-danger" : "text-muted") mb-0">@Model.LineFailedCount 筆</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 區塊一：列出所有賴有的通知（9 大核心情境清單） -->
        <div class="card card-plato shadow-sm mb-4 border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-chat-dots-fill text-primary me-2"></i>系統所有支援之 LINE 通知情境一覽（共 9 大情境）
                    </h5>
                    <div class="text-muted small">點開下方卡片可預覽完整推播樣板與觸發時機說明</div>
                </div>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
                    <i class="bi bi-shield-check me-1"></i>全數支援冪等防重鍵 (Idempotency)
                </span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 50px;" class="text-center">#</th>
                                <th style="width: 170px;">通知名稱與代碼</th>
                                <th style="width: 220px;">觸發時機</th>
                                <th style="width: 120px;">接收對象</th>
                                <th>訊息樣板與內容預覽</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="text-center fw-bold text-secondary">1</td>
                                <td>
                                    <div class="fw-bold text-dark">堂數異動通知</div>
                                    <code class="small text-primary">CreditsChanged</code>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border mb-1">即時觸發</span>
                                    <div class="small text-secondary">儲值入帳、獲得贈券、預約扣堂、取消預約退還堂數、退班結清退費</div>
                                </td>
                                <td><span class="badge bg-secondary-subtle text-secondary border">學生家長</span></td>
                                <td>
