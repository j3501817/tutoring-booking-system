                    </table>
                </div>
            </div>
        </div>

        <!-- 區塊二：下方可展開近 10 筆通知 -->
        <div class="card card-plato shadow-sm mb-4 border-0">
            <div class="card-header bg-white py-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-clock-history text-primary me-2"></i>最近 10 筆 LINE 通知發送紀錄（點擊可展開詳細內容）
                    </h5>
                    <div class="text-muted small">點擊下方任一項目即可展開查看發送全文、LINE User ID、防重冪等鍵與重送按鈕</div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="small text-muted">目前顯示最新 10 筆</span>
                </div>
            </div>
            <div class="card-body p-3">
                @if (!Model.RecentLineLogs.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                        目前尚無任何 LINE 通知發送紀錄。
                    </div>
                }
                else
                {
                    <div class="accordion accordion-flush" id="accordionRecentLineLogs">
                        @for (int i = 0; i < Model.RecentLineLogs.Count; i++)
                        {
                            var log = Model.RecentLineLogs[i];
                            var collapseId = $"collapseLineLog{log.Id}";
                            var headingId = $"headingLineLog{log.Id}";
                            var isFailed = log.Status.StartsWith("Failed");
                            var statusBadgeClass = isFailed ? "bg-danger" : (log.Status == "RetriedSuccess" ? "bg-info text-dark" : "bg-success");
                            var statusText = log.Status == "Sent" ? "發送成功" : (log.Status == "RetriedSuccess" ? "重試成功" : (log.Status == "Failed_NoLineId" ? "未綁定 LINE" : "API 失敗"));
                            var tpeTime = BookingService.ToTaipeiTime(log.SentAtUtc);

                            <div class="accordion-item border rounded-3 mb-2 shadow-sm overflow-hidden">
                                <h2 class="accordion-header" id="@headingId">
                                    <button class="accordion-button @(i == 0 ? "" : "collapsed") py-2 px-3 bg-light" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#@collapseId"
                                            aria-expanded="@(i == 0 ? "true" : "false")" aria-controls="@collapseId">
                                        <div class="d-flex justify-content-between align-items-center w-100 pe-3 flex-wrap gap-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge @statusBadgeClass">@statusText</span>
                                                <span class="badge bg-primary-subtle text-primary border">@log.NotificationType</span>
                                                <strong class="text-dark">@(log.RecipientParentUser?.DisplayName ?? "未具名家長")</strong>
                                                <span class="small text-muted font-monospace d-none d-md-inline">(@log.LineUserId)</span>
                                            </div>
                                            <div class="d-flex align-items-center gap-3">
                                                <span class="small text-muted">
                                                    <i class="bi bi-clock me-1"></i>@tpeTime.ToString("yyyy/MM/dd HH:mm:ss")
                                                </span>
                                            </div>
                                        </div>
                                    </button>
                                </h2>
                                <div id="@collapseId" class="accordion-collapse collapse @(i == 0 ? "show" : "")"
                                     aria-labelledby="@headingId" data-bs-parent="#accordionRecentLineLogs">
                                    <div class="accordion-body bg-white p-3 border-top">
                                        <div class="row g-3">
                                            <div class="col-12 col-lg-8">
                                                <div class="small fw-bold text-secondary mb-1">通知內容全文：</div>
                                                <div class="p-3 bg-light rounded-3 border small font-monospace text-dark" style="white-space: pre-wrap; line-height: 1.6;">@log.MessageText</div>
                                            </div>
                                            <div class="col-12 col-lg-4">
                                                <div class="small fw-bold text-secondary mb-1">發送中繼與歷程資訊：</div>
                                                <div class="p-2 bg-light rounded-3 border small">
                                                    <div class="mb-1"><strong>收件人 ID：</strong><code>@log.RecipientParentUserId</code></div>
                                                    <div class="mb-1"><strong>LINE User ID：</strong><code>@log.LineUserId</code></div>
                                                    <div class="mb-1"><strong>防重冪等鍵：</strong><code>@log.IdempotencyKey</code></div>
                                                    <div class="mb-1"><strong>重試計數：</strong>@log.RetryCount 次</div>
                                                    <div class="mb-2"><strong>點擊前往網址：</strong><a href="@log.ActionUrl" target="_blank" class="text-decoration-none">@log.ActionUrl</a></div>
                                                    @if (isFailed)
                                                    {
                                                        <form method="post" asp-page-handler="RetryLine">
                                                            <input type="hidden" name="logId" value="@log.Id" />
                                                            <button type="submit" class="btn btn-sm btn-danger w-100 fw-bold">
                                                                <i class="bi bi-arrow-repeat me-1"></i>立即手動重新發送
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div> <!-- 閉合 systemAdminTabContent -->

