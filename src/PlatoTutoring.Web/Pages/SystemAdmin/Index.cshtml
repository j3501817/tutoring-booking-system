@page
@model PlatoTutoring.Web.Pages.SystemAdmin.IndexModel
@using PlatoTutoring.Web.Models
@{
    ViewData["Title"] = "系統管理 － 欄位與行事曆管理";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-dark">系統管理</span>
            <span class="badge badge-terracotta">欄位與行事曆</span>
        </div>
        <h2 class="fw-bold mb-1">系統欄位與學期行事曆管理</h2>
        <p class="text-muted small mb-0">
            集中維護系統下拉欄位（學校、年別、班別、任教科目、到班目的）以及學期行事曆與休假日排定。
        </p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-danger fw-bold px-3"
                onclick="openCreateHolidayModal()">
            <i class="bi bi-calendar-x me-1"></i>新增休假日
        </button>
        <button type="button" class="btn btn-accent fw-bold px-3"
                onclick="openCreateOptionModal('School')">
            <i class="bi bi-plus-lg me-1"></i>新增欄位選項
        </button>
    </div>
</div>

<!-- 1. 學期行事曆與休假日管理區塊（月曆視覺化顯示） -->
<div class="card card-plato mb-4 border-primary border-opacity-25 shadow-sm">
    <div class="card-header bg-primary bg-opacity-10 py-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
        <div>
            <h5 class="fw-bold mb-0 text-primary"><i class="bi bi-calendar3 me-2"></i>學期行事曆與休假日設定</h5>
            <div class="text-muted small">設定學期起訖時間與機構休假日，休假日將同步於家長預約行事曆上全格反灰且禁止預約</div>
        </div>
        <div class="d-flex align-items-center gap-2 small">
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle">
                <i class="bi bi-calendar2-range me-1"></i>學期期間
            </span>
            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle">
                <i class="bi bi-moon-stars-fill me-1"></i>休假日（停課）
            </span>
        </div>
    </div>
    <div class="card-body">
        <div class="row g-4">
            <!-- 左側：學期列表與起訖時間設定 -->
            <div class="col-lg-5 border-end-lg">
                <!-- 1. 學期功能列表（支援多學期：目前學期與下學期等） -->
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-calendar2-week me-2 text-primary"></i>學期清單功能列表 (@Model.AllSemesters.Count)
                    </h6>
                    <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 fw-semibold" onclick="prepareNewSemester()">
                        <i class="bi bi-plus-lg me-1"></i>新增學期
                    </button>
                </div>
                
                <div class="table-responsive border rounded-3 bg-white mb-3" style="max-height: 200px; overflow-y: auto;">
                    <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.82rem;">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>學期名稱</th>
                                <th>起訖期間</th>
                                <th>狀態</th>
                                <th class="text-end">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.AllSemesters.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-2">尚未建立任何學期。</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var sem in Model.AllSemesters)
                                {
                                    var isViewing = sem.Id == Model.ViewingSemester?.Id;
                                    <tr class="@(isViewing ? "table-primary bg-opacity-25" : "")">
                                        <td>
                                            <a asp-page="./Index" asp-route-semesterId="@sem.Id" class="fw-bold text-decoration-none text-dark">
                                                @sem.Name
                                            </a>
                                            @if (isViewing)
                                            {
                                                <span class="badge bg-primary text-white ms-1" style="font-size: 0.65rem;">檢視中</span>
                                            }
                                        </td>
                                        <td class="text-nowrap text-secondary small">
                                            @sem.StartDate.ToString("yyyy/MM/dd") ～ @sem.EndDate.ToString("yyyy/MM/dd")
                                        </td>
                                        <td>
                                            @if (sem.IsCurrent)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">目前學期</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border">非目前</span>
                                            }
                                        </td>
                                        <td class="text-end text-nowrap">
                                            @if (!sem.IsCurrent)
                                            {
                                                <form method="post" asp-page-handler="SwitchSemester" class="d-inline"
                                                      onsubmit="return confirm('確定要切換至「@sem.Name」為目前學期嗎？\n\n【注意】依系統規定：贈送堂數一換學期即歸零，系統將自動結算前學期之剩餘贈送堂數！');">
                                                    <input type="hidden" name="semesterId" value="@sem.Id" />
                                                    <button type="submit" class="btn btn-sm btn-link text-success p-0 me-2 text-decoration-none fw-bold" title="啟用為目前學期並歸零前學期贈送堂數">
                                                        啟用
                                                    </button>
                                                </form>
                                            }
                                            <button type="button" class="btn btn-sm btn-link text-primary p-0 me-2 text-decoration-none"
                                                    onclick="loadSemesterForEdit(@sem.Id, '@Html.Raw(sem.Name)', '@sem.StartDate.ToString("yyyy-MM-dd")', '@sem.EndDate.ToString("yyyy-MM-dd")', @(sem.IsCurrent ? "true" : "false"))"
                                                    title="編輯此學期">
                                                編輯
                                            </button>
                                            @if (!sem.IsCurrent)
                                            {
                                                <form method="post" asp-page-handler="DeleteSemester" class="d-inline"
                                                      onsubmit="return confirm('確定要刪除學期「@sem.Name」嗎？');">
                                                    <input type="hidden" name="semesterId" value="@sem.Id" />
                                                    <button type="submit" class="btn btn-sm btn-link text-danger p-0 text-decoration-none" title="刪除此學期">
                                                        刪除
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- 2. 學期起訖時間設定與編輯表單 -->
                <div class="bg-light p-3 rounded-3 mb-3 border">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold small text-dark" id="semesterFormTitle">
                            <i class="bi bi-pencil-square me-1 text-primary"></i>編輯學期期間
                        </span>
                        <span class="badge bg-secondary-subtle text-secondary" id="semesterFormMode">編輯現有學期</span>
                    </div>
                    <form method="post" asp-page-handler="SaveSemester" id="formSemester">
                        <input type="hidden" name="semesterId" id="semIdInput" value="@(Model.ViewingSemester?.Id ?? 0)" />
                        <div class="mb-2">
                            <label class="form-label fw-semibold small mb-1">學期名稱</label>
                            <input type="text" name="name" id="semNameInput" class="form-control form-control-sm"
                                   value="@(Model.ViewingSemester?.Name ?? $"{DateTime.Today.Year} 學年度")" required />
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label fw-semibold small mb-1">開始日期</label>
                                <input type="date" name="startDate" id="semStartInput" class="form-control form-control-sm"
                                       value="@(Model.ViewingSemester?.StartDate.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))" required />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold small mb-1">結束日期</label>
                                <input type="date" name="endDate" id="semEndInput" class="form-control form-control-sm"
                                       value="@(Model.ViewingSemester?.EndDate.ToString("yyyy-MM-dd") ?? DateTime.Today.AddMonths(6).ToString("yyyy-MM-dd"))" required />
                            </div>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="setAsCurrent" value="true" id="semIsCurrentInput" @(Model.ViewingSemester?.IsCurrent == true ? "checked" : "") />
                            <label class="form-check-label small text-secondary" for="semIsCurrentInput">
                                設為目前進行中學期（若切換將歸零舊學期贈送堂數）
                            </label>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-sm btn-primary flex-fill fw-bold" id="semSubmitBtn">
                                <i class="bi bi-save me-1"></i>儲存學期期間
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="prepareNewSemester()">
                                清空填寫新學期
                            </button>
                        </div>
                    </form>
                </div>

                <!-- 3. 休假日快速列表 -->
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold small text-secondary">已排定休假日清單 (@Model.AcademicHolidays.Count 天)</span>
                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" onclick="openCreateHolidayModal()">
                        <i class="bi bi-plus me-1"></i>排休
                    </button>
                </div>
                <div class="table-responsive border rounded-3 bg-white" style="max-height: 180px; overflow-y: auto;">
                    <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.82rem;">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>日期</th>
                                <th>休假原因</th>
                                <th class="text-end">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.AcademicHolidays.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-3">尚未排定休假日。</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var h in Model.AcademicHolidays)
                                {
                                    <tr>
                                        <td class="fw-bold text-danger text-nowrap">@h.Date.ToString("MM/dd (ddd)")</td>
                                        <td class="text-truncate" style="max-width: 110px;">@h.Name</td>
                                        <td class="text-end">
                                            <form method="post" asp-page-handler="DeleteHoliday" class="d-inline"
                                                  onsubmit="return confirm('確定要移除 @h.Date.ToString("yyyy-MM-dd") 休假日嗎？');">
                                                <input type="hidden" name="id" value="@h.Id" />
                                                <button type="submit" class="btn btn-sm btn-link text-danger p-0 text-decoration-none">刪除</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 右側：學期與休假日「月曆檢視」 -->
            <div class="col-lg-7">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar-month me-2 text-primary"></i>學期行事曆月曆視圖</h6>
                        @if (Model.ViewingSemester != null)
                        {
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle">
                                目前檢視：@Model.ViewingSemester.Name
                            </span>
                        }
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <a asp-page="./Index" asp-route-year="@Model.PrevYear" asp-route-month="@Model.PrevMonth" asp-route-semesterId="@Model.SelectedSemesterId"
                           class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                        <span class="fw-bold px-2 text-nowrap" style="min-width: 130px; text-align: center;">
                            @Model.CalendarYear 年 @Model.CalendarMonth 月
                        </span>
                        <a asp-page="./Index" asp-route-year="@Model.NextYear" asp-route-month="@Model.NextMonth" asp-route-semesterId="@Model.SelectedSemesterId"
                           class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                        <a asp-page="./Index" asp-route-semesterId="@Model.SelectedSemesterId" class="btn btn-sm btn-outline-primary ms-1">本月</a>
                    </div>
                </div>
                           class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                        <a asp-page="./Index" class="btn btn-sm btn-outline-primary ms-1">本月</a>
                    </div>
                </div>

                <!-- 月曆網格 (星期日 ~ 星期六) -->
                <div class="border rounded-3 p-2 bg-light">
                    <!-- 星期標題 -->
                    <div class="row g-1 text-center small fw-bold text-secondary mb-1">
                        <div class="col text-danger">日</div>
                        <div class="col">一</div>
                        <div class="col">二</div>
                        <div class="col">三</div>
                        <div class="col">四</div>
                        <div class="col">五</div>
                        <div class="col text-primary">六</div>
                    </div>

                    <!-- 日期網格 -->
                    <div class="d-flex flex-wrap" style="margin: -2px;">
                        @for (int p = 0; p < Model.StartDayOfWeek; p++)
                        {
                            <div style="width: 14.285%; padding: 2px;">
                                <div class="p-2 border rounded bg-white opacity-25" style="min-height: 68px;"></div>
                            </div>
                        }

                        @for (int day = 1; day <= Model.DaysInMonth; day++)
                        {
                            var cellDate = new DateOnly(Model.CalendarYear, Model.CalendarMonth, day);
                            var cellDateStr = cellDate.ToString("yyyy-MM-dd");
                            var isHoliday = Model.HolidayMap.TryGetValue(cellDate, out var holiday);
                            var activeSem = Model.ViewingSemester ?? Model.CurrentSemester;
                            var isInSemester = activeSem != null
                                               && cellDate >= activeSem.StartDate
                                               && cellDate <= activeSem.EndDate;
                            var isToday = cellDate == DateOnly.FromDateTime(DateTime.Today);

                            <div style="width: 14.285%; padding: 2px;">
                                <div class="p-2 border rounded position-relative d-flex flex-column justify-content-between @(isHoliday ? "bg-danger bg-opacity-10 border-danger border-opacity-50" : isInSemester ? "bg-white border-primary border-opacity-25" : "bg-white")"
                                     style="min-height: 68px; cursor: pointer; transition: all 0.15s ease;"
                                     onclick="@(isHoliday ? "" : $"openCreateHolidayModalWithDate('{cellDateStr}')")"
                                     title="@(isHoliday ? $"休假：{holiday!.Name}" : isInSemester ? $"{cellDateStr}（學期中，點擊設為休假日）" : $"{cellDateStr}（點擊設為休假日）")">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="small fw-bold @(isToday ? "badge bg-primary text-white" : isHoliday ? "text-danger" : "text-dark")">
                                            @day
                                        </span>
                                        @if (isInSemester && !isHoliday)
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary p-0 px-1" style="font-size: 0.65rem;">學期</span>
                                        }
                                    </div>

                                    @if (isHoliday)
                                    {
                                        <div class="mt-1">
                                            <span class="badge bg-danger text-white text-truncate w-100 p-1" style="font-size: 0.7rem;" title="@holiday!.Name">
                                                🏖️ @holiday.Name
                                            </span>
                                            <form method="post" asp-page-handler="DeleteHoliday" class="mt-1 text-end"
                                                  onsubmit="event.stopPropagation(); return confirm('確定要移除 @cellDateStr 休假日嗎？');">
                                                <input type="hidden" name="id" value="@holiday.Id" />
                                                <button type="submit" class="btn btn-sm btn-link text-danger p-0 text-decoration-none" style="font-size: 0.68rem;">
                                                    <i class="bi bi-trash"></i> 移除
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 2. 下拉選單項目管理（改用 Tab 分頁，解決雜亂問題） -->
<div class="card card-plato shadow-sm">
    <div class="card-header bg-white py-3">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h5 class="fw-bold mb-1 text-dark"><i class="bi bi-menu-button-wide me-2 text-primary"></i>下拉欄位選單項目管理</h5>
                <div class="text-muted small">點選分頁切換維護學校、年別、班別、到班目的與任教科目下拉選單</div>
            </div>
        </div>

        <!-- 導覽分頁 Tabs -->
        <ul class="nav nav-pills custom-tab-pills mt-3" id="adminFieldTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="tab-school-btn" data-bs-toggle="pill" data-bs-target="#tab-school" type="button" role="tab">
                    <i class="bi bi-building me-1"></i>學校選項 (@Model.SchoolOptions.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-grade-btn" data-bs-toggle="pill" data-bs-target="#tab-grade" type="button" role="tab">
                    <i class="bi bi-layers me-1"></i>年別選項 (@Model.GradeOptions.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-class-btn" data-bs-toggle="pill" data-bs-target="#tab-class" type="button" role="tab">
                    <i class="bi bi-diagram-3 me-1"></i>班別選項 (@Model.ClassOptions.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-purpose-btn" data-bs-toggle="pill" data-bs-target="#tab-purpose" type="button" role="tab">
                    <i class="bi bi-bullseye me-1"></i>到班目的 (@Model.PurposeOptions.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-subject-btn" data-bs-toggle="pill" data-bs-target="#tab-subject" type="button" role="tab">
                    <i class="bi bi-book me-1"></i>任教科目 (@Model.SubjectOptions.Count)
                </button>
            </li>
        </ul>
    </div>

    <div class="card-body p-3 p-md-4">
        <div class="tab-content" id="adminFieldTabsContent">
            <!-- Tab 1: 學校選項 -->
            <div class="tab-pane fade show active" id="tab-school" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h6 class="fw-bold mb-0"><i class="bi bi-building text-primary me-2"></i>學生就讀學校下拉選單</h6>
                        <div class="text-muted small">學生與儲值作業時的學校篩選清單</div>
                    </div>
                    <button type="button" class="btn btn-sm btn-primary" onclick="openCreateOptionModal('@FieldCategories.School')">
                        <i class="bi bi-plus-lg me-1"></i>新增學校
                    </button>
                </div>
                <div class="table-responsive border rounded-3">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3" style="width: 80px;">排序</th>
                                <th>學校名稱</th>
                                <th class="text-end pe-3" style="width: 140px;">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.SchoolOptions)
                            {
                                <tr>
                                    <td class="ps-3 text-muted small">@item.SortOrder</td>
                                    <td class="fw-bold">@item.Value</td>
                                    <td class="text-end pe-3">
                                        <div class="d-inline-flex gap-1">
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2"
                                                    onclick="openEditOptionModal(@item.Id, '@item.Category', '@Html.Raw(item.Value)', @item.SortOrder, 'tab-school')">
                                                修改
                                            </button>
                                            <form method="post" asp-page-handler="DeleteOption"
                                                  onsubmit="return confirm('確定要刪除學校「@item.Value」嗎？');">
                                                <input type="hidden" name="optionId" value="@item.Id" />
                                                <input type="hidden" name="activeTab" value="tab-school" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">刪除</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Tab 2: 年別選項 -->
            <div class="tab-pane fade" id="tab-grade" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h6 class="fw-bold mb-0"><i class="bi bi-layers text-success me-2"></i>學生年別下拉選單</h6>
                        <div class="text-muted small">國一、國二、國三、高一等年別選項</div>
                    </div>
                    <button type="button" class="btn btn-sm btn-success" onclick="openCreateOptionModal('@FieldCategories.Grade', 'tab-grade')">
                        <i class="bi bi-plus-lg me-1"></i>新增年別
                    </button>
                </div>
                <div class="table-responsive border rounded-3">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3" style="width: 80px;">排序</th>
                                <th>年別名稱</th>
                                <th class="text-end pe-3" style="width: 140px;">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.GradeOptions)
                            {
                                <tr>
                                    <td class="ps-3 text-muted small">@item.SortOrder</td>
                                    <td class="fw-bold">@item.Value</td>
                                    <td class="text-end pe-3">
                                        <div class="d-inline-flex gap-1">
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2"
                                                    onclick="openEditOptionModal(@item.Id, '@item.Category', '@Html.Raw(item.Value)', @item.SortOrder, 'tab-grade')">
                                                修改
                                            </button>
                                            <form method="post" asp-page-handler="DeleteOption"
                                                  onsubmit="return confirm('確定要刪除年別「@item.Value」嗎？');">
                                                <input type="hidden" name="optionId" value="@item.Id" />
                                                <input type="hidden" name="activeTab" value="tab-grade" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">刪除</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Tab 3: 班別選項 -->
            <div class="tab-pane fade" id="tab-class" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h6 class="fw-bold mb-0"><i class="bi bi-diagram-3 text-warning-emphasis me-2"></i>學生班別選項（不需連動學校）</h6>
                        <div class="text-muted small">資優班、精英班等班別選項</div>
                    </div>
                    <button type="button" class="btn btn-sm btn-warning fw-bold text-dark" onclick="openCreateOptionModal('@FieldCategories.Class', 'tab-class')">
                        <i class="bi bi-plus-lg me-1"></i>新增班別
                    </button>
                </div>
                <div class="table-responsive border rounded-3">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3" style="width: 80px;">排序</th>
                                <th>班別名稱</th>
                                <th class="text-end pe-3" style="width: 140px;">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ClassOptions)
                            {
                                <tr>
                                    <td class="ps-3 text-muted small">@item.SortOrder</td>
                                    <td><span class="badge bg-warning bg-opacity-25 text-dark border fs-6">@item.Value</span></td>
                                    <td class="text-end pe-3">
                                        <div class="d-inline-flex gap-1">
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2"
                                                    onclick="openEditOptionModal(@item.Id, '@item.Category', '@Html.Raw(item.Value)', @item.SortOrder, 'tab-class')">
                                                修改
                                            </button>
                                            <form method="post" asp-page-handler="DeleteOption"
                                                  onsubmit="return confirm('確定要刪除班別「@item.Value」嗎？');">
                                                <input type="hidden" name="optionId" value="@item.Id" />
                                                <input type="hidden" name="activeTab" value="tab-class" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">刪除</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Tab 4: 到班目的選項 -->
            <div class="tab-pane fade" id="tab-purpose" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h6 class="fw-bold mb-0"><i class="bi bi-bullseye text-primary me-2"></i>到班輔導目的選項</h6>
                        <div class="text-muted small">家長預約、候補及老師代預約時選擇的 6 大到班目的維護</div>
                    </div>
                    <button type="button" class="btn btn-sm btn-primary" onclick="openCreatePurposeModal()">
                        <i class="bi bi-plus-lg me-1"></i>新增目的
                    </button>
                </div>
                <div class="table-responsive border rounded-3">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3" style="width: 80px;">排序</th>
                                <th>目的名稱</th>
                                <th class="text-end pe-3" style="width: 140px;">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.PurposeOptions)
                            {
                                <tr>
                                    <td class="ps-3 text-muted small">@item.SortOrder</td>
                                    <td><span class="badge bg-primary bg-opacity-10 text-primary border fs-6">@item.Name</span></td>
                                    <td class="text-end pe-3">
                                        <div class="d-inline-flex gap-1">
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2"
                                                    onclick="openEditPurposeModal(@item.Id, '@Html.Raw(item.Name)', @item.SortOrder)">
                                                修改
                                            </button>
                                            <form method="post" asp-page-handler="DeletePurpose"
                                                  onsubmit="return confirm('確定要刪除到班目的「@item.Name」嗎？');">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="activeTab" value="tab-purpose" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">刪除</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Tab 5: 任教科目選項 -->
            <div class="tab-pane fade" id="tab-subject" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h6 class="fw-bold mb-0"><i class="bi bi-book text-info me-2"></i>老師任教科目選項</h6>
                        <div class="text-muted small">數學、理化、英文等老師任教科目標籤</div>
                    </div>
                    <button type="button" class="btn btn-sm btn-info text-white" onclick="openCreateOptionModal('@FieldCategories.Subject', 'tab-subject')">
                        <i class="bi bi-plus-lg me-1"></i>新增科目
                    </button>
                </div>
                <div class="table-responsive border rounded-3">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3" style="width: 80px;">排序</th>
                                <th>科目名稱</th>
                                <th class="text-end pe-3" style="width: 140px;">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.SubjectOptions)
                            {
                                <tr>
                                    <td class="ps-3 text-muted small">@item.SortOrder</td>
                                    <td><span class="badge bg-info bg-opacity-10 text-info border fs-6">@item.Value</span></td>
                                    <td class="text-end pe-3">
                                        <div class="d-inline-flex gap-1">
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2"
                                                    onclick="openEditOptionModal(@item.Id, '@item.Category', '@Html.Raw(item.Value)', @item.SortOrder, 'tab-subject')">
                                                修改
                                            </button>
                                            <form method="post" asp-page-handler="DeleteOption"
                                                  onsubmit="return confirm('確定要刪除科目「@item.Value」嗎？');">
                                                <input type="hidden" name="optionId" value="@item.Id" />
                                                <input type="hidden" name="activeTab" value="tab-subject" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">刪除</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 新增選項 Modal -->
<div class="modal fade" id="modalCreateOption" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="CreateOption">
                <input type="hidden" name="category" id="createOptionCategory" />
                <input type="hidden" name="activeTab" id="createOptionActiveTab" value="tab-school" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="createOptionTitle"><i class="bi bi-plus-circle me-2"></i>新增下拉選項</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">選項名稱</label>
                        <input type="text" name="value" id="createOptionValue" class="form-control" required />
                    </div>
                    <div class="mb-0">
                        <label class="form-label fw-semibold">顯示排序</label>
                        <input type="number" name="sortOrder" class="form-control" value="0" min="0" />
                        <div class="form-text">填 0 將由系統自動排至最後一筆。</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary fw-bold">確認新增</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 修改選項 Modal -->
