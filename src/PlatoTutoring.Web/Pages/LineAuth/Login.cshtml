@page
@model PlatoTutoring.Web.Pages.LineAuth.LoginModel
@{
    ViewData["Title"] = "LINE 官方通知綁定設定";
}

<div class="container py-5" style="max-width: 680px;">
    <div class="card-plato p-4 p-md-5 text-center shadow-sm">
        <div class="mb-3">
            <span class="d-inline-flex p-3 rounded-circle bg-success bg-opacity-10 text-success">
                <i class="bi bi-line fs-1"></i>
            </span>
        </div>
        <h2 class="h4 fw-bold mb-2">LINE 官方帳號通知授權綁定</h2>
        <p class="text-secondary small mb-4">
            綁定完成後，孩子的課程預約確認、上課提醒與作業輔導通知將會即時發送至您的 LINE。
        </p>

        @if (!Model.IsConfigured)
        {
            <div class="alert alert-warning text-start mb-4">
                <div class="d-flex align-items-center mb-2">
                    <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-warning"></i>
                    <strong>伺服器尚未完成 LINE Login 憑證設定</strong>
                </div>
                <div class="small text-muted mb-2">
                    系統偵測到 Web App 環境變數或組態檔中尚未設定 <code>LineLogin__ClientId</code> 與 <code>LineLogin__ClientSecret</code>。
                </div>
                <div class="small">
                    <strong>請管理員在環境變數加入：</strong>
                    <ul class="mb-0 mt-1 ps-3">
                        <li><code>LineLogin__ClientId</code> (或 <code>LineBot__ChannelId</code>)</li>
                        <li><code>LineLogin__ClientSecret</code> (或 <code>LineBot__ChannelSecret</code>)</li>
                    </ul>
                </div>
            </div>

            <div class="card p-3 bg-light border-0 mb-4 text-start">
                <div class="fw-semibold small text-dark mb-1">
                    <i class="bi bi-tools me-1 text-primary"></i>開發與測試模式
                </div>
                <div class="small text-secondary mb-3">
                    您可以在此使用「模擬綁定」功能，驗證家長頁面的通知綁定狀態與後續業務流程。
                </div>
                <form method="post" asp-page-handler="SimulateBind">
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <button type="submit" class="btn btn-outline-success w-100 fw-bold">
                        <i class="bi bi-magic me-1"></i>建立測試模擬 LINE 帳號綁定
                    </button>
                </form>
            </div>
        }

        <div class="d-flex justify-content-center gap-2">
            <a href="@Model.ReturnUrl" class="btn btn-secondary px-4">
                <i class="bi bi-arrow-left me-1"></i>返回上一頁
            </a>
        </div>
    </div>
</div>
