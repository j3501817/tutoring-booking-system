                    <h5 class="modal-title fw-bold"><i class="bi bi-person-plus-fill me-2 text-primary"></i>新增家長帳號</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">家長姓名</label>
                            <input type="text" name="displayName" class="form-control" placeholder="例如：張媽媽" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">聯絡電話</label>
                            <input type="text" name="phone" class="form-control" placeholder="0912-000-000" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">登入帳號</label>
                            <input type="text" name="username" class="form-control" placeholder="parent.chang" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">初始密碼</label>
                            <input type="text" name="password" class="form-control" value="demo123" required />
                        </div>
