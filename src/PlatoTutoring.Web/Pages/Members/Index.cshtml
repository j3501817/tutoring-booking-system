@page
@model PlatoTutoring.Web.Pages.Members.IndexModel
@using PlatoTutoring.Web.Models
@using System.Text.Json
@{
    ViewData["Title"] = "學生 / 家長 / 老師管理";
    var todayStr = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(8)).ToString("yyyy-MM-dd");
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge badge-terracotta">成員與關係管理</span>
            <span class="text-muted small">學生 @(Model.Students.Count) 位 ・ 家長 @(Model.Parents.Count) 位 ・ 老師 @(Model.Teachers.Count) 位</span>
        </div>
        <h2 class="fw-bold mb-0">學生 / 家長 / 老師管理</h2>
    </div>
    <div class="workspace-tabs-shell">
        <ul class="nav nav-pills bg-white border rounded-3 p-1 shadow-sm" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-semibold px-3 py-2"
                        id="btn-tab-student-parent"
                        data-bs-toggle="pill"
                        data-bs-target="#tab-student-parent"
                        type="button" role="tab">
                    <i class="bi bi-mortarboard-fill me-1"></i>學生與家長管理
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold px-3 py-2"
                        id="btn-tab-teachers"
                        data-bs-toggle="pill"
                        data-bs-target="#tab-teachers"
                        type="button" role="tab">
                    <i class="bi bi-easel2-fill me-1"></i>老師管理
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold px-3 py-2"
                        id="btn-tab-member-accounts"
                        data-bs-toggle="pill"
                        data-bs-target="#tab-member-accounts"
                        type="button" role="tab">
                    <i class="bi bi-shield-lock-fill me-1"></i>帳號與學生綁定
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold px-3 py-2"
                        id="btn-tab-member-semester"
                        data-bs-toggle="pill"
                        data-bs-target="#tab-member-semester"
                        type="button" role="tab">
                    <i class="bi bi-calendar-range me-1"></i>學期與每週進度
                </button>
            </li>
        </ul>
    </div>
</div>

<div class="tab-content">
    <!-- =================================================================== -->
    <!-- 頁籤 1：學生與家長管理（進入即顯示列表、同家長合併一列、10筆/頁） -->
    <!-- =================================================================== -->
    <div class="tab-pane fade show active" id="tab-student-parent" role="tabpanel">
        <div class="card card-plato">
            <div class="card-header bg-white py-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                <div>
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-people-fill me-2 text-primary"></i>家長與學生關係列表
                    </h5>
                    <div class="text-muted small">
                        同一位家長的多位學生自動合併於同一列顯示，清楚呈現親子關係與就學班級（每頁 10 筆，目前第 @Model.StudentParentPage / @Model.StudentParentTotalPages 頁，共 @Model.AllFamilyRows.Count 戶）
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-primary fw-bold"
                            onclick="openCreateParentModal()">
                        <i class="bi bi-person-plus-fill me-1"></i>新增家長
                    </button>
                    <button type="button" class="btn btn-accent fw-bold"
                            onclick="openCreateStudentModal(0, '媽媽')">
                        <i class="bi bi-plus-lg me-1"></i>新增學生
                    </button>
                </div>
            </div>

            <!-- 篩選列（學校、年別、班別獨立不連動） -->
            <div class="px-3 pt-3 pb-2 bg-light border-bottom">
                <form method="get" class="row g-2 align-items-end">
                    <input type="hidden" name="sp" value="1" />
                    <input type="hidden" name="tp" value="@Model.TeacherPage" />
                    <div class="col-6 col-md-3">
                        <label class="form-label small fw-semibold text-secondary mb-1">學校篩選</label>
                        <select name="FilterSchool" class="form-select form-select-sm">
                            <option value="">全部學校</option>
                            @foreach (var s in Model.SchoolOptions)
                            {
                                <option value="@s.Value" selected="@(Model.FilterSchool == s.Value)">@s.Value</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small fw-semibold text-secondary mb-1">年別篩選</label>
                        <select name="FilterGrade" class="form-select form-select-sm">
                            <option value="">全部年別</option>
                            @foreach (var g in Model.GradeOptions)
                            {
                                <option value="@g.Value" selected="@(Model.FilterGrade == g.Value)">@g.Value</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small fw-semibold text-secondary mb-1">班別篩選（資優班／精英班）</label>
                        <select name="FilterClass" class="form-select form-select-sm">
                            <option value="">全部班別</option>
                            @foreach (var c in Model.ClassOptions)
                            {
                                <option value="@c.Value" selected="@(Model.FilterClass == c.Value)">@c.Value</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-sm btn-primary flex-fill">
                            <i class="bi bi-funnel me-1"></i>篩選
                        </button>
                        <a href="/Members" class="btn btn-sm btn-outline-secondary">清除</a>
                    </div>
                </form>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3" style="width: 34%;">家長資訊與操作</th>
                                <th style="width: 66%;">所屬學生與就學資訊（關係稱謂 ／ 學校 ・ 年別 ・ 班級 ／ 堂數 ／ 操作）</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.PagedFamilyRows.Count == 0)
                            {
                                <tr>
                                    <td colspan="2" class="text-center text-muted py-5">目前尚無家長或學生資料。</td>
                                </tr>
                            }
                            @foreach (var row in Model.PagedFamilyRows)
                            {
                                var primaryParent = row.Parents.FirstOrDefault();
                                <tr>
                                    <td class="ps-3 align-top py-3">
                                        @if (row.Parents.Count > 0)
                                        {
                                            <div class="d-flex flex-column gap-3">
                                                @for (var pIdx = 0; pIdx < row.Parents.Count; pIdx++)
                                                {
                                                    var parent = row.Parents[pIdx];
                                                    <div class="@(pIdx > 0 ? "pt-2 border-top" : "")">
                                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                                            <div>
                                                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                                                    <span class="fw-bold fs-6 text-dark">@parent.DisplayName</span>
                                                                    @if (row.Parents.Count > 1)
                                                                    {
                                                                        <span class="badge bg-secondary-subtle text-secondary border">家長 @(pIdx + 1)</span>
                                                                    }
                                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                                        共 @row.Children.Count 位孩子
                                                                    </span>
                                                                </div>
                                                                <div class="small text-muted mt-1">
                                                                    <div><i class="bi bi-person-badge me-1"></i>帳號：<code>@parent.Username</code></div>
                                                                    <div><i class="bi bi-telephone me-1"></i>電話：@(string.IsNullOrWhiteSpace(parent.Phone) ? "未填寫" : parent.Phone)</div>
                                                                    <div>
                                                                        <i class="bi bi-chat-dots me-1"></i>LINE：
                                                                        @if (!string.IsNullOrWhiteSpace(parent.LineUserId))
                                                                        {
                                                                            <span class="text-success fw-semibold">已綁定 (@parent.LineUserId)</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="text-muted">未綁定</span>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="d-flex flex-column gap-1">
                                                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2"
                                                                        onclick="openCreateStudentModal(@parent.Id, '@(row.Children.FirstOrDefault()?.Relationship ?? "媽媽")')">
                                                                    <i class="bi bi-plus-circle me-1"></i>新增孩子
                                                                </button>
                                                                <div class="d-flex gap-1">
                                                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 flex-fill"
                                                                            onclick="openEditParentModal(@parent.Id, '@Html.Raw(parent.DisplayName)', '@Html.Raw(parent.Username)', '@Html.Raw(parent.Phone)', '@Html.Raw(parent.LineUserId ?? "")')">
                                                                        修改家長
                                                                    </button>
                                                                    <form method="post" asp-page-handler="DeleteParent" class="d-inline"
                                                                          onsubmit="return confirm('確定要刪除家長「@parent.DisplayName」嗎？（學生資料將保留並改為未綁定）');">
                                                                        <input type="hidden" name="userId" value="@parent.Id" />
                                                                        <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">刪除</button>
                                                                    </form>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="p-2 rounded bg-warning-subtle border border-warning-subtle">
                                                <div class="fw-bold text-dark"><i class="bi bi-exclamation-circle me-1 text-warning"></i>尚未綁定家長</div>
                                                <div class="small text-muted">請點擊右側學生的「修改學生」選擇所屬家長與關係稱謂。</div>
                                            </div>
                                        }
                                    </td>
                                    <td class="align-top py-3 pe-3">
                                        @if (row.Children.Count == 0)
                                        {
                                            <div class="d-flex align-items-center justify-content-between p-2 rounded border bg-light text-muted small">
                                                <span>此家長目前尚未綁定任何學生。</span>
                                                @if (primaryParent != null)
                                                {
                                                    <button type="button" class="btn btn-sm btn-accent py-0 px-2"
                                                            onclick="openCreateStudentModal(@primaryParent.Id, '媽媽')">
                                                        + 立即新增綁定學生
                                                    </button>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-column gap-2">
                                                @foreach (var item in row.Children)
                                                {
                                                    var stu = item.Student;
                                                    var rel = item.Relationship;
                                                    <div class="p-2 px-3 rounded-3 border bg-white shadow-sm d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2">
                                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                                            <span class="fw-bold fs-6 text-dark">@stu.FullName</span>
                                                            @if (stu.IsDroppedOut || stu.EnrollmentStatus == PlatoTutoring.Web.Models.StudentEnrollmentStatus.DroppedOut)
                                                            {
                                                                <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>退班</span>
                                                            }
                                                            else if (stu.EnrollmentStatus == PlatoTutoring.Web.Models.StudentEnrollmentStatus.Unrenewed)
                                                            {
                                                                <span class="badge bg-warning text-dark"><i class="bi bi-pause-circle me-1"></i>未續報</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>本學期在學</span>
                                                            }
                                                            <span class="badge bg-light text-dark border">
                                                                <i class="bi bi-building me-1 text-primary"></i>學校：@(string.IsNullOrWhiteSpace(stu.School) ? "未填" : stu.School)
                                                            </span>
                                                            <span class="badge bg-light text-dark border">
                                                                <i class="bi bi-mortarboard me-1 text-success"></i>年別：@(string.IsNullOrWhiteSpace(stu.Grade) ? "未填" : stu.Grade)
                                                            </span>
                                                            <span class="badge bg-danger bg-opacity-10 text-danger border">
                                                                <i class="bi bi-diagram-3 me-1"></i>班別：@(string.IsNullOrWhiteSpace(stu.ClassName) ? "未填" : stu.ClassName)
                                                            </span>
                                                            @if (!string.IsNullOrWhiteSpace(stu.Phone1) || !string.IsNullOrWhiteSpace(stu.Phone2) || !string.IsNullOrWhiteSpace(stu.Phone3))
                                                            {
                                                                <span class="badge bg-light text-secondary border">
                                                                    <i class="bi bi-telephone me-1"></i>@(string.Join(" / ", stu.AllPhones))
                                                                </span>
                                                            }
                                                            <span class="small text-muted ms-1">
                                                                堂數：<strong class="text-success">@stu.PaidCredits</strong> 購 / <strong class="text-primary">@stu.BonusCredits</strong> 贈
                                                            </span>
                                                        </div>
                                                        <div class="d-flex align-items-center gap-1 flex-shrink-0 flex-wrap">
                                                            @if (!stu.IsDroppedOut)
                                                            {
                                                                @if (stu.EnrollmentStatus == PlatoTutoring.Web.Models.StudentEnrollmentStatus.Enrolled)
                                                                {
                                                                    <form method="post" asp-page-handler="MarkUnrenewed" class="d-inline"
                                                                          onsubmit="return confirm('確定將學生「@stu.FullName」標記為「未續報」嗎？\n\n・已購堂數將完整保留\n・本學期不可預約課堂\n・新學期不會自動補發贈送堂數');">
                                                                        <input type="hidden" name="studentId" value="@stu.Id" />
                                                                        <button type="submit" class="btn btn-sm btn-outline-warning text-dark py-0 px-2" title="暫不報名當前學期">
                                                                            <i class="bi bi-pause-circle me-1"></i>標為未續報
                                                                        </button>
                                                                    </form>
                                                                }
                                                                else if (stu.EnrollmentStatus == PlatoTutoring.Web.Models.StudentEnrollmentStatus.Unrenewed)
                                                                {
                                                                    <form method="post" asp-page-handler="RenewStudent" class="d-inline"
                                                                          onsubmit="return confirm('確定為學生「@stu.FullName」辦理「續報」嗎？\n\n・將立即恢復為「本學期在學」\n・恢復預約權限\n・若當前學期尚未發放贈堂，系統將自動補發');">
                                                                        <input type="hidden" name="studentId" value="@stu.Id" />
                                                                        <button type="submit" class="btn btn-sm btn-success py-0 px-2 fw-semibold shadow-sm" title="恢復在學並自動補發本期贈堂">
                                                                            <i class="bi bi-arrow-repeat me-1"></i>👉 續報
                                                                        </button>
                                                                    </form>
                                                                }
                                                            }
                                                            <button type="button" class="btn btn-sm btn-outline-info py-0 px-2"
                                                                    onclick="showStatusLogs(@stu.Id, '@Html.Raw(stu.FullName)')" title="查看學籍狀態異動歷程">
                                                                <i class="bi bi-clock-history me-1"></i>歷程
                                                            </button>
                                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2"
                                                                    onclick="openEditStudentModal(@stu.Id, '@Html.Raw(stu.FullName)', '@Html.Raw(stu.School)', '@Html.Raw(stu.Grade)', '@Html.Raw(stu.ClassName)', '@Html.Raw(stu.Phone1)', '@Html.Raw(stu.Phone2)', '@Html.Raw(stu.Phone3)', '@stu.EnrollmentDate.ToString("yyyy-MM-dd")', @(primaryParent?.Id ?? 0))">
                                                                <i class="bi bi-pencil-square me-1"></i>修改
                                                            </button>
                                                            <form method="post" asp-page-handler="DeleteStudent" class="d-inline"
                                                                  onsubmit="return confirm('確定要刪除學生「@stu.FullName」及其預約紀錄嗎？');">
                                                                <input type="hidden" name="studentId" value="@stu.Id" />
                                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">刪除</button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 學生與家長管理 10筆/頁 分頁列 -->
            <div class="card-footer bg-white py-3 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                <div class="small text-muted">
                    每頁顯示 <strong>@IndexModel.PageSize</strong> 筆家庭資料 ・ 第 <strong>@Model.StudentParentPage</strong> / <strong>@Model.StudentParentTotalPages</strong> 頁（共 @Model.AllFamilyRows.Count 筆）
                </div>
                <nav aria-label="學生與家長列表分頁">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.StudentParentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="/Members?sp=@(Model.StudentParentPage - 1)&tp=@Model.TeacherPage&FilterSchool=@Model.FilterSchool&FilterGrade=@Model.FilterGrade&FilterClass=@Model.FilterClass#tab-student-parent">上一頁</a>
                        </li>
                        @for (var p = 1; p <= Model.StudentParentTotalPages; p++)
                        {
                            <li class="page-item @(p == Model.StudentParentPage ? "active" : "")">
                                <a class="page-link" href="/Members?sp=@p&tp=@Model.TeacherPage&FilterSchool=@Model.FilterSchool&FilterGrade=@Model.FilterGrade&FilterClass=@Model.FilterClass#tab-student-parent">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.StudentParentPage >= Model.StudentParentTotalPages ? "disabled" : "")">
                            <a class="page-link" href="/Members?sp=@(Model.StudentParentPage + 1)&tp=@Model.TeacherPage&FilterSchool=@Model.FilterSchool&FilterGrade=@Model.FilterGrade&FilterClass=@Model.FilterClass#tab-student-parent">下一頁</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>

    <!-- =================================================================== -->
    <!-- 頁籤 2：老師管理（進入即顯示列表、10筆/頁、任教科目多選、代理權限勾選） -->
    <!-- =================================================================== -->
    <div class="tab-pane fade" id="tab-teachers" role="tabpanel">
        <div class="card card-plato">
            <div class="card-header bg-white py-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                <div>
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-easel2-fill me-2 text-success"></i>授課老師列表
                    </h5>
                    <div class="text-muted small">
                        管理授課老師帳號、任教科目（多選）與代理管理員權限（每頁 10 筆，目前第 @Model.TeacherPage / @Model.TeacherTotalPages 頁，共 @Model.Teachers.Count 位）
                    </div>
                </div>
                <div>
                    <button type="button" class="btn btn-success fw-bold"
                            onclick="openCreateTeacherModal()">
                        <i class="bi bi-person-plus-fill me-1"></i>新增老師
                    </button>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">老師姓名</th>
                                <th>登入帳號</th>
                                <th>任教科目（多選）</th>
                                <th>代理權限（營運報表／系統管理）</th>
                                <th>聯絡電話</th>
                                <th>已開設時段數</th>
                                <th class="text-end pe-3">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.PagedTeachers.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-5">目前尚無老師資料。</td>
                                </tr>
                            }
                            @foreach (var t in Model.PagedTeachers)
                            {
                                var slotCount = Model.TeacherSlotCounts.TryGetValue(t.Id, out var c) ? c : 0;
                                var subjectList = t.SubjectList;
                                var subjectsJson = JsonSerializer.Serialize(subjectList);
                                <tr>
                                    <td class="ps-3 fw-bold">@t.DisplayName</td>
                                    <td><code>@t.Username</code></td>
                                    <td>
                                        @if (subjectList.Count == 0)
                                        {
                                            <span class="text-muted small">未設定科目</span>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var sub in subjectList)
                                                {
                                                    <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">@sub</span>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @if (t.IsProxyAdmin)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-shield-check me-1"></i>已勾選代理（可使用營運報表與系統管理）
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border">一般授課老師</span>
                                        }
                                    </td>
                                    <td class="small">@(string.IsNullOrWhiteSpace(t.Phone) ? "未填寫" : t.Phone)</td>
                                    <td><span class="badge bg-light text-dark border">@slotCount 堂</span></td>
                                    <td class="text-end pe-3">
                                        <div class="d-inline-flex gap-1">
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2"
                                                    onclick='openEditTeacherModal(@t.Id, @Html.Raw(JsonSerializer.Serialize(t.DisplayName)), @Html.Raw(JsonSerializer.Serialize(t.Username)), @Html.Raw(JsonSerializer.Serialize(t.Phone)), @Html.Raw(subjectsJson), @(t.IsProxyAdmin ? "true" : "false"))'>
                                                <i class="bi bi-pencil-square me-1"></i>修改
                                            </button>
                                            <form method="post" asp-page-handler="DeleteTeacher" class="d-inline"
                                                  onsubmit="return confirm('確定要刪除老師「@t.DisplayName」嗎？');">
                                                <input type="hidden" name="userId" value="@t.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2"
                                                        @(t.Id == Model.CurrentUser.Id ? "disabled title=無法刪除目前登入中的帳號" : "")>
                                                    刪除
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 老師管理 10筆/頁 分頁列 -->
            <div class="card-footer bg-white py-3 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                <div class="small text-muted">
                    每頁顯示 <strong>@IndexModel.PageSize</strong> 筆老師資料 ・ 第 <strong>@Model.TeacherPage</strong> / <strong>@Model.TeacherTotalPages</strong> 頁（共 @Model.Teachers.Count 位）
                </div>
                <nav aria-label="老師列表分頁">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.TeacherPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="/Members?sp=@Model.StudentParentPage&tp=@(Model.TeacherPage - 1)#tab-teachers">上一頁</a>
                        </li>
                        @for (var p = 1; p <= Model.TeacherTotalPages; p++)
                        {
                            <li class="page-item @(p == Model.TeacherPage ? "active" : "")">
                                <a class="page-link" href="/Members?sp=@Model.StudentParentPage&tp=@p#tab-teachers">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.TeacherPage >= Model.TeacherTotalPages ? "disabled" : "")">
                            <a class="page-link" href="/Members?sp=@Model.StudentParentPage&tp=@(Model.TeacherPage + 1)#tab-teachers">下一頁</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>

    <!-- =================================================================== -->
    <!-- 頁籤 3：帳號與學生綁定 -->
    <!-- =================================================================== -->
    <div class="tab-pane fade" id="tab-member-accounts" role="tabpanel">
        <div class="card card-plato">
            <div class="card-header bg-white py-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                <div>
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-shield-lock-fill me-2 text-primary"></i>全系統登入帳號清單與密碼／聯絡資訊維護
                    </h5>
                    <div class="text-muted small">
                        點擊右側按鈕可彈跳開啟建立新帳號或進行家長 ↔ 學生授權綁定；下方可直接維護所有帳號之密碼與聯絡資料
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-accent fw-bold shadow-sm"
                            data-bs-toggle="modal" data-bs-target="#modalCreateAccount"
                            onclick="openCreateAccountModal()">
                        <i class="bi bi-person-fill-add me-1"></i>建立登入帳號
                    </button>
                    <button type="button" class="btn btn-outline-primary fw-bold shadow-sm"
                            data-bs-toggle="modal" data-bs-target="#modalBindParentStudent"
                            onclick="openBindParentStudentModal()">
                        <i class="bi bi-link-45deg me-1"></i>家長帳號 ↔ 學生授權綁定管理
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">角色</th>
                                <th>顯示姓名 / 登入帳號</th>
                                <th>關聯學生（家長適用）</th>
                                <th>電話與 LINE 通知綁定</th>
                                <th class="pe-3">重設密碼 / 儲存更新</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.AllUsers.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">目前尚無帳號資料。</td>
                                </tr>
                            }
                            @foreach (var u in Model.AllUsers)
                            {
                                var linkedStudents = Model.AllLinks
                                    .Where(l => l.ParentUserId == u.Id)
                                    .Select(l => $"{l.Student?.FullName}({l.Student?.GradeClass})")
                                    .ToList();

                                <tr>
                                    <td class="ps-3" data-label="角色">
                                        <span class="badge @(u.Role == UserRole.Admin ? "bg-dark" : u.Role == UserRole.Teacher ? "bg-primary" : "bg-success")">
                                            @(u.Role == UserRole.Admin ? "管理員 (Admin)" : u.Role == UserRole.Teacher ? "授課老師 (Teacher)" : "家長 (Parent)")
                                        </span>
                                    </td>
                                    <td data-label="姓名 / 帳號">
                                        <div class="fw-bold">@u.DisplayName</div>
                                        <div class="small text-muted">登入帳號：<code>@u.Username</code></div>
                                    </td>
                                    <td data-label="關聯學生" class="small">
                                        @if (u.Role == UserRole.Parent)
                                        {
                                            if (linkedStudents.Any())
                                            {
                                                <span>@string.Join("、", linkedStudents)</span>
                                            }
                                            else
                                            {
                                                <span class="text-danger">尚未綁定學生</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">全班別教務／系統權限</span>
                                        }
                                    </td>
                                    <td data-label="聯絡與密碼維護" colspan="2" class="pe-3">
                                        <form method="post" asp-page-handler="ResetPassword" class="row g-2 align-items-center justify-content-end">
                                            <input type="hidden" name="targetUserId" value="@u.Id" />
                                            <div class="col-12 col-md-3">
                                                <input type="text" name="phone" class="form-control form-control-sm" value="@u.Phone" placeholder="聯絡電話" />
                                            </div>
                                            <div class="col-12 col-md-4">
                                                <input type="text" name="lineUserId" class="form-control form-control-sm" value="@u.LineUserId" placeholder="LINE User ID" />
                                            </div>
                                            <div class="col-12 col-md-3">
                                                <input type="password" name="newPassword" class="form-control form-control-sm" placeholder="輸入新密碼（留空不改）" />
                                            </div>
                                            <div class="col-12 col-md-2 text-end">
                                                <button type="submit" class="btn btn-sm btn-outline-dark w-100">更新設定</button>
                                            </div>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- =================================================================== -->
    <!-- 頁籤 4：學期與每週進度 -->
    <!-- =================================================================== -->
    <div class="tab-pane fade" id="tab-member-semester" role="tabpanel">
        <div class="row g-4">
            <div class="col-12 col-xl-7">
                <div class="card card-plato h-100">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold mb-0">
                                <i class="bi bi-calendar-range me-2 text-primary"></i>學期與目前開放進度切換
                            </h5>
                            <div class="small text-muted">
                                目前學期：@(Model.CurrentSemester?.Name ?? "未設定")（每學期預設贈送 @(Model.CurrentSemester?.DefaultBonusCredits ?? 0) 堂）
                            </div>
                        </div>
                        <form method="post" asp-page-handler="EndSemesterBonusExpiry"
                              onsubmit="return confirm('確定要執行「學期結束贈送堂數歸零」嗎？所有學生未使用的贈送堂數將歸零並寫入稽核流水帳（付費堂數保留）。');">
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-hourglass-bottom me-1"></i>期末贈送堂數歸零
                            </button>
                        </form>
                    </div>
                    <div class="card-body">
                        <div class="small fw-semibold mb-2">切換目前開放預約進度（家長僅可預約目前進度）：</div>
                        <div class="d-grid gap-2">
                            @if (Model.AllProgresses.Count == 0)
                            {
                                <div class="text-center text-muted py-4">目前尚無每週進度資料。</div>
                            }
                            @foreach (var p in Model.AllProgresses)
                            {
                                <div class="p-3 border rounded-3 d-flex justify-content-between align-items-center @(p.IsCurrentProgress ? "bg-light border-dark" : "")">
                                    <div>
                                        <strong>@p.Code @p.Title</strong>
                                        <span class="badge bg-secondary ms-1">@p.GradeClass</span>
                                        <div class="small text-muted">@p.WeekStartDate.ToString("MM/dd") ~ @p.WeekEndDate.ToString("MM/dd")</div>
                                    </div>
                                    @if (p.IsCurrentProgress)
                                    {
                                        <span class="badge bg-success px-3 py-2">目前開放進度</span>
                                    }
                                    else
                                    {
                                        <form method="post" asp-page-handler="SwitchCurrentProgress">
                                            <input type="hidden" name="progressId" value="@p.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-dark">設為目前進度</button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-5">
                <div class="card card-plato h-100">
                    <div class="card-header bg-white py-3">
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-plus-square-fill me-2 text-primary"></i>新增每週課程進度
                        </h5>
                        <div class="small text-muted">設定進度代碼、起訖日期與適用班別</div>
                    </div>
                    <div class="card-body">
                        <form method="post" asp-page-handler="CreateProgress">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">進度代碼（如 W09）</label>
                                <input type="text" name="code" class="form-control" placeholder="例如：W09" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">進度主題名稱</label>
                                <input type="text" name="title" class="form-control" placeholder="例如：幾何證明與相似形總複習" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">適用班別</label>
                                <input type="text" name="gradeClass" class="form-control" value="國三A班" required />
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">開始日期</label>
                                    <input type="date" name="weekStartDate" class="form-control" value="@todayStr" required />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">結束日期</label>
                                    <input type="date" name="weekEndDate" class="form-control" value="@DateOnly.FromDateTime(DateTime.UtcNow.AddHours(8).AddDays(6)).ToString("yyyy-MM-dd")" required />
                                </div>
                            </div>
                            <div class="form-check mb-3 small">
                                <input type="checkbox" class="form-check-input" id="setAsCurrent" name="setAsCurrent" value="true" />
                                <label class="form-check-label" for="setAsCurrent">立即設為目前開放進度</label>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 fw-bold">
                                <i class="bi bi-check2-circle me-1"></i>新增課程進度
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

