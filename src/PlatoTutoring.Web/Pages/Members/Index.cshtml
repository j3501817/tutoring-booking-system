@section Scripts {
    <script>
        function openCreateAccountModal() {
            new bootstrap.Modal(document.getElementById('modalCreateAccount')).show();
        }

        function openBindParentStudentModal() {
            new bootstrap.Modal(document.getElementById('modalBindParentStudent')).show();
        }

        window.addEventListener('DOMContentLoaded', function () {
            const hash = window.location.hash;
            if (hash) {
                const triggerEl = document.querySelector(`button[data-bs-target="${hash}"]`);
                if (triggerEl) {
                    bootstrap.Tab.getOrCreateInstance(triggerEl).show();
                }
            }
        });

        function ensureSelectOption(selectEl, val) {
            if (!val) return;
            const exists = Array.from(selectEl.options).some(o => o.value === val);
            if (!exists) {
                const opt = document.createElement('option');
                opt.value = val;
                opt.textContent = val;
                selectEl.appendChild(opt);
            }
            selectEl.value = val;
        }

        function openCreateStudentModal(parentId) {
            document.getElementById('createStudentFullName').value = '';
            const schoolSelect = document.getElementById('createStudentSchool');
            if (schoolSelect.options.length > 0) schoolSelect.selectedIndex = 0;
            const classSelect = document.getElementById('createStudentClass');
            if (classSelect.options.length > 0) classSelect.selectedIndex = 0;

            const parentSelect = document.getElementById('createStudentParentId');
            parentSelect.value = parentId && parentId > 0 ? String(parentId) : '';

            new bootstrap.Modal(document.getElementById('modalCreateStudent')).show();
        }

        function openEditStudentModal(id, fullName, school, grade, className, phone1, phone2, phone3, enrollmentDate, parentId) {
            document.getElementById('editStudentId').value = id;
            document.getElementById('editStudentFullName').value = fullName;
            document.getElementById('editStudentEnrollmentDate').value = enrollmentDate;

            const schoolSelect = document.getElementById('editStudentSchool');
            ensureSelectOption(schoolSelect, school);

            const gradeSelect = document.getElementById('editStudentGrade');
            ensureSelectOption(gradeSelect, grade);

            const classSelect = document.getElementById('editStudentClass');
            ensureSelectOption(classSelect, className);

            document.getElementById('editStudentPhone1').value = phone1 || '';
            document.getElementById('editStudentPhone2').value = phone2 || '';
            document.getElementById('editStudentPhone3').value = phone3 || '';

            const parentSelect = document.getElementById('editStudentParentId');
            parentSelect.value = parentId && parentId > 0 ? String(parentId) : '';

            new bootstrap.Modal(document.getElementById('modalEditStudent')).show();
        }

        function openCreateParentModal() {
            new bootstrap.Modal(document.getElementById('modalCreateParent')).show();
        }

        function openEditParentModal(id, displayName, username, phone, lineUserId) {
            document.getElementById('editParentId').value = id;
            document.getElementById('editParentDisplayName').value = displayName;
            document.getElementById('editParentUsername').value = username;
            document.getElementById('editParentPhone').value = phone || '';
            document.getElementById('editParentLineUserId').value = lineUserId || '';
            new bootstrap.Modal(document.getElementById('modalEditParent')).show();
        }

        function openCreateTeacherModal() {
            new bootstrap.Modal(document.getElementById('modalCreateTeacher')).show();
        }

        function openEditTeacherModal(id, displayName, username, phone, subjects, isProxyAdmin) {
            document.getElementById('editTeacherId').value = id;
            document.getElementById('editTeacherDisplayName').value = displayName;
            document.getElementById('editTeacherUsername').value = username;
            document.getElementById('editTeacherPhone').value = phone || '';
            document.getElementById('editTeacherProxyAdmin').checked = !!isProxyAdmin;

            const selectedSet = new Set(Array.isArray(subjects) ? subjects : []);
            document.querySelectorAll('.edit-teacher-subject-chk').forEach(function (chk) {
                chk.checked = selectedSet.has(chk.value);
            });

            new bootstrap.Modal(document.getElementById('modalEditTeacher')).show();
        }

        async function showStatusLogs(studentId, studentName) {
            document.getElementById('statusLogsStudentName').textContent = studentName;
            const container = document.getElementById('statusLogsContainer');
            container.innerHTML = '<div class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>載入中...</div>';
            new bootstrap.Modal(document.getElementById('modalStatusLogs')).show();

            try {
                const res = await fetch(`/Members?handler=StudentStatusLogs&studentId=${studentId}`);
                if (!res.ok) throw new Error('讀取歷程失敗');
                const list = await res.json();
                if (!list || list.length === 0) {
                    container.innerHTML = '<div class="text-center py-4 text-muted"><i class="bi bi-info-circle me-1"></i>目前尚無狀態異動歷程（自入學起皆維持原在學狀態）。</div>';
                    return;
                }

                let html = '<div class="timeline p-2">';
                list.forEach((item, idx) => {
                    const toBadgeClass = item.toStatus === '本學期在學' ? 'bg-success' : (item.toStatus === '未續報' ? 'bg-warning text-dark' : 'bg-danger');
                    const fromBadgeClass = item.fromStatus === '本學期在學' ? 'bg-success' : (item.fromStatus === '未續報' ? 'bg-warning text-dark' : 'bg-danger');
                    html += `
                        <div class="border rounded p-3 mb-2 bg-light shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge bg-secondary">${item.semesterName}</span>
                                <small class="text-muted"><i class="bi bi-clock me-1"></i>${item.createdAt}</small>
                            </div>
                            <div class="d-flex align-items-center gap-2 my-2">
                                <span class="badge ${fromBadgeClass}">${item.fromStatus}</span>
                                <i class="bi bi-arrow-right text-muted"></i>
                                <span class="badge ${toBadgeClass}">${item.toStatus}</span>
                            </div>
                            <div class="small text-dark mb-1"><strong>備註說明：</strong>${item.note || '無'}</div>
                            <div class="small text-muted text-end">經辦人：${item.operatorName || '系統'}</div>
                        </div>
                    `;
                });
                html += '</div>';
                container.innerHTML = html;
            } catch (err) {
                container.innerHTML = `<div class="alert alert-danger mb-0">${err.message}</div>`;
            }
        }
    </script>
}

<!-- 學籍狀態異動歷程彈跳視窗 (Modal) -->
<div class="modal fade" id="modalStatusLogs" tabindex="-1" aria-labelledby="modalStatusLogsLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow border-0">
            <div class="modal-header bg-dark text-white">
