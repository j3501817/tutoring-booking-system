<div class="modal fade" id="modalCreateStudent" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="CreateStudent">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-mortarboard-fill me-2 text-primary"></i>新增學生</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="關閉"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">學生姓名</label>
                            <input type="text" name="fullName" id="createStudentFullName" class="form-control" placeholder="例如：張小華" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">入班日期</label>
                            <input type="date" name="enrollmentDate" id="createStudentEnrollmentDate" class="form-control" value="@todayStr" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">學校</label>
                            <select name="school" id="createStudentSchool" class="form-select" required>
                                @foreach (var s in Model.SchoolOptions)
                                {
                                    <option value="@s.Value">@s.Value</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">年別</label>
                            <select name="grade" id="createStudentGrade" class="form-select" required>
                                @foreach (var g in Model.GradeOptions)
                                {
                                    <option value="@g.Value">@g.Value</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">班別</label>
                            <select name="className" id="createStudentClass" class="form-select" required>
                                <option value="">-- 請選擇班別 --</option>
                                @foreach (var c in Model.ClassOptions)
                                {
                                    <option value="@c.Value">@c.Value</option>
                                }
                            </select>
                        </div>
                        <!-- 學生聯絡電話（三個手機欄位，自動關聯家長） -->
                        <div class="col-12">
                            <div class="p-3 rounded border bg-light">
                                <label class="form-label fw-bold text-dark mb-1">
                                    <i class="bi bi-phone me-1 text-primary"></i>學生手機號碼（共可填寫 3 支，將自動比對並關聯家長聯絡電話）
                                </label>
                                <div class="text-muted small mb-2">輸入後若與家長聯絡電話相符將自動關聯；若未找到對應家長則維持未綁定。</div>
                                <div class="row g-2">
                                    <div class="col-md-4">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">主要手機</span>
                                            <input type="text" name="phone1" class="form-control" placeholder="0912-345-678" />
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">備用手機 1</span>
                                            <input type="text" name="phone2" class="form-control" placeholder="0922-000-000" />
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">備用手機 2</span>
                                            <input type="text" name="phone3" class="form-control" placeholder="0933-000-000" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">手動指定家長（選填，若已填寫手機號碼則可留空由系統自動關聯）</label>
                            <select name="parentUserId" id="createStudentParentId" class="form-select">
                                <option value="">-- 由電話自動比對／暫不指定 --</option>
                                @foreach (var p in Model.Parents)
                                {
                                    <option value="@p.Id">@p.DisplayName (@p.Username / @p.Phone)</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="grantProRataBonus" value="true" id="chkCreateStudentBonus" checked />
                                <label class="form-check-label small text-muted" for="chkCreateStudentBonus">
                                    依入班日期比例自動發放本學期贈送堂數
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-accent fw-bold">確認新增學生</button>
                </div>
            </form>
        </div>
    </div>
</div>

