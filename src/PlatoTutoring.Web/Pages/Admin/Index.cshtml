@page
@model PlatoTutoring.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "管理員營運、帳號權限與月報表中心";
}

<!-- 頂部管理員工作台標題、正式環境連線狀態與匯出工具 -->
<div class="card-plato p-3 p-md-4 mb-4">
    <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3">
        <div>
            <div class="eyebrow-tag">
                <i class="bi bi-bar-chart-line-fill"></i>
                <span>管理員決策與稽核中心 · Admin Console</span>
            </div>
            <h1 class="h3 fw-bold mb-1">營運月報表、帳號權限、學期規則與退班結算中心</h1>
            <p class="text-secondary small mb-2">
                管理員：<strong>@Model.CurrentUser.DisplayName</strong> ｜ 涵蓋家長／老師／管理員帳號管理、學生關聯授權、財務對帳與退班結算
            </p>
            <div class="d-flex flex-wrap gap-2 small">
                <span class="badge bg-light text-dark border px-2 py-1">
                    <i class="bi bi-database-check text-primary me-1"></i>資料庫：@Model.DatabaseStatusText
                </span>
                <span class="badge bg-light text-dark border px-2 py-1">
                    <i class="bi bi-cloud-check text-success me-1"></i>憑證儲存：@Model.BlobStorageStatusText
                </span>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="/admin/export/credits.csv" class="btn btn-accent btn-sm">
                <i class="bi bi-filetype-csv me-1"></i>匯出學生堂數 CSV
            </a>
            <form method="post" asp-page-handler="PurgeExpiredAttachments" class="d-inline">
                <button type="submit" class="btn btn-outline-dark btn-sm">
                    <i class="bi bi-trash3 me-1"></i>清除 90 天到期截圖
                </button>
            </form>
        </div>
    </div>
</div>

<!-- 營運月報表核心指標 (KPI 卡片列) -->
<section class="mb-4">
    <div class="row g-3">
        <div class="col-6 col-md-4 col-xl-2">
            <div class="metric-card metric-ocean h-100">
                <div class="small text-secondary fw-semibold">儲值入帳總額</div>
                <div class="fs-4 fw-bold mt-1">NT$@Model.TotalTopUpAmountNtd.ToString("N0")</div>
                <div class="small text-muted">人工核對匯款入帳</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="metric-card h-100">
                <div class="small text-secondary fw-semibold">預收款餘額</div>
                <div class="fs-4 fw-bold mt-1">NT$@Model.TotalUnearnedRevenueNtd.ToString("N0")</div>
                <div class="small text-muted">未消耗付費堂數價值</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="metric-card metric-sage h-100">
                <div class="small text-secondary fw-semibold">課堂出席率</div>
                <div class="fs-4 fw-bold mt-1">@Model.AttendanceRatePercent%</div>
                <div class="small text-muted">依已點名課程統計</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="metric-card metric-ocean h-100">
                <div class="small text-secondary fw-semibold">時段滿座率</div>
                <div class="fs-4 fw-bold mt-1">@Model.SlotUtilizationPercent%</div>
                <div class="small text-muted">已預約 / 總開放名額</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="metric-card metric-sage h-100">
                <div class="small text-secondary fw-semibold">作業不佳解決率</div>
                <div class="fs-4 fw-bold mt-1">@Model.HomeworkResolvedCount / @Model.HomeworkTotalCount</div>
                <div class="small text-muted">已預約輔導 / 總標記數</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="metric-card h-100">
                <div class="small text-secondary fw-semibold">LINE 推播用量</div>
                <div class="fs-4 fw-bold mt-1">@Model.LineSentTotal 則</div>
                <div class="small text-muted">失敗待重試：@Model.LineFailedTotal 則</div>
            </div>
        </div>
    </div>
</section>

<!-- 夜間對帳檢核狀態橫幅 -->
<div class="alert @(Model.Discrepancies.Count == 0 ? "alert-success" : "alert-danger") border-0 shadow-sm mb-4 p-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <i class="bi @(Model.Discrepancies.Count == 0 ? "bi-shield-check" : "bi-exclamation-diamond") fs-4"></i>
            <div>
                <strong>系統堂數三方對帳結果：</strong>
                @if (Model.Discrepancies.Count == 0)
                {
                    <span>所有學生的「主檔餘額」、「不可篡改流水帳總和」與「儲值批次剩餘堂數」100% 吻合，無任何帳務異常。</span>
                }
                else
                {
                    <span>發現 @Model.Discrepancies.Count 筆帳務不一致異常，請立即檢視！</span>
                }
            </div>
        </div>
        <span class="badge bg-dark">對帳時間：@DateTime.UtcNow.AddHours(8).ToString("yyyy-MM-dd HH:mm")</span>
    </div>
</div>

<!-- 膠囊式分段工作區頁籤 (Segmented Workspace Tabs) -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <ul class="nav nav-pills workspace-tabs-shell" id="adminWorkspaceTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="btn-admin-accounts" data-bs-toggle="pill"
                    data-bs-target="#tab-admin-accounts" type="button" role="tab">
                <i class="bi bi-shield-lock-fill"></i>
                <span>帳號與學生綁定</span>
                <span class="workspace-tab-count">@Model.AllUsers.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="btn-admin-semester" data-bs-toggle="pill"
                    data-bs-target="#tab-admin-semester" type="button" role="tab">
                <i class="bi bi-calendar-range"></i>
                <span>學期與每週進度</span>
                <span class="workspace-tab-count">@Model.AllProgresses.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="btn-admin-students" data-bs-toggle="pill"
                    data-bs-target="#tab-admin-students" type="button" role="tab">
                <i class="bi bi-person-plus-fill"></i>
                <span>學生與爽約規則</span>
                <span class="workspace-tab-count">@Model.AllStudents.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="btn-admin-dropout" data-bs-toggle="pill"
                    data-bs-target="#tab-admin-dropout" type="button" role="tab">
                <i class="bi bi-calculator-fill"></i>
                <span>退班批次結算</span>
                <span class="workspace-tab-count">@Model.SettlementPreviews.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="btn-admin-audit" data-bs-toggle="pill"
                    data-bs-target="#tab-admin-audit" type="button" role="tab">
                <i class="bi bi-journal-code"></i>
                <span>流水帳與 LINE 稽核</span>
                <span class="workspace-tab-count">@Model.RecentLedgerEntries.Count</span>
            </button>
        </li>
    </ul>

    <span class="small text-secondary">
        <i class="bi bi-compass me-1"></i>點選上方頁籤或左側子選單可快速切換管理分頁
    </span>
</div>

<div class="tab-content" id="adminWorkspaceTabContent">
    <!-- 分頁一：帳號權限管理與家長↔學生綁定 -->
    <div class="tab-pane fade show active" id="tab-admin-accounts" role="tabpanel">
        <div class="row g-4 mb-4">
            <!-- 新增家長 / 老師 / 管理員登入帳號 -->
            <div class="col-12 col-xl-6">
                <div class="card-plato p-3 p-md-4 h-100">
                    <div class="section-header-clean">
                        <div class="section-header-title">
                            <span class="metric-icon-box ocean"><i class="bi bi-person-fill-add"></i></span>
                            <div>
                                <h2 class="h5 fw-bold mb-0">建立登入帳號（家長／老師／管理員）</h2>
                                <div class="small text-muted">密碼自動以 PBKDF2-SHA256 加鹽雜湊加密儲存</div>
                            </div>
                        </div>
                    </div>

                    <form method="post" asp-page-handler="CreateUser">
                        <div class="row g-2 mb-3">
                            <div class="col-12 col-sm-6">
                                <label class="form-label small fw-semibold" for="newUsername">登入帳號 (Username)</label>
                                <input type="text" id="newUsername" name="username" class="form-control" placeholder="例如：parent.wang / teacher.lee" required />
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="form-label small fw-semibold" for="newPassword">初始登入密碼</label>
                                <input type="password" id="newPassword" name="password" class="form-control" placeholder="請設定初始密碼" required />
                            </div>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-12 col-sm-6">
                                <label class="form-label small fw-semibold" for="newDisplayName">顯示名稱／稱謂</label>
                                <input type="text" id="newDisplayName" name="displayName" class="form-control" placeholder="例如：王媽媽（家長）／李老師" required />
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="form-label small fw-semibold" for="newRole">帳號角色權限</label>
                                <select id="newRole" name="role" class="form-select" required>
                                    <option value="Parent">家長／學生家庭帳號 (Parent)</option>
                                    <option value="Teacher">授課老師 (Teacher)</option>
                                    <option value="Admin">系統管理員 (Admin)</option>
                                </select>
                            </div>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-12 col-sm-6">
                                <label class="form-label small fw-semibold" for="newPhone">聯絡電話</label>
                                <input type="text" id="newPhone" name="phone" class="form-control" placeholder="例如：0912-345-678" />
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="form-label small fw-semibold" for="newLineId">LINE User ID（選填）</label>
                                <input type="text" id="newLineId" name="lineUserId" class="form-control" placeholder="家長可於登入後自行綁定" />
                            </div>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-12 col-sm-8">
                                <label class="form-label small fw-semibold" for="linkStu">若為家長帳號，可同時綁定在籍學生（選填）</label>
                                <select id="linkStu" name="linkStudentId" class="form-select">
                                    <option value="">-- 暫不綁定（或稍後於右側綁定多位孩子） --</option>
                                    @foreach (var s in Model.AllStudents)
                                    {
                                        <option value="@s.Id">@s.FullName (@s.GradeClass)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-sm-4">
                                <label class="form-label small fw-semibold" for="linkRel">親屬關係</label>
                                <input type="text" id="linkRel" name="relationship" class="form-control" value="家長" placeholder="母親/父親/本人" />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-accent w-100">
                            <i class="bi bi-shield-plus me-1"></i>建立登入帳號
                        </button>
                    </form>
                </div>
            </div>

            <!-- 家長 ↔ 學生授權綁定管理 -->
            <div class="col-12 col-xl-6">
                <div class="card-plato p-3 p-md-4 h-100">
                    <div class="section-header-clean">
                        <div class="section-header-title">
                            <span class="metric-icon-box sage"><i class="bi bi-people-fill"></i></span>
                            <div>
                                <h2 class="h5 fw-bold mb-0">家長帳號 ↔ 學生授權綁定管理</h2>
                                <div class="small text-muted">支援一位家長綁定多位兄弟姊妹，或父母雙方各自帳號綁定同一位學生</div>
                            </div>
                        </div>
                    </div>

                    <form method="post" asp-page-handler="LinkParentStudent" class="mb-3">
                        <div class="row g-2 align-items-end">
                            <div class="col-12 col-sm-5">
                                <label class="form-label small fw-semibold">選擇家長帳號</label>
                                <select name="parentUserId" class="form-select" required>
                                    @foreach (var p in Model.ParentUsers)
                                    {
                                        <option value="@p.Id">@p.DisplayName (@p.Username)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12 col-sm-4">
                                <label class="form-label small fw-semibold">選擇學生</label>
                                <select name="studentId" class="form-select" required>
                                    @foreach (var s in Model.AllStudents)
                                    {
                                        <option value="@s.Id">@s.FullName (@s.GradeClass)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6 col-sm-3">
                                <label class="form-label small fw-semibold">關係</label>
                                <input type="text" name="relationship" class="form-control" value="家長" />
                            </div>
                            <div class="col-12 mt-2">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-link-45deg me-1"></i>新增「家長 ↔ 學生」授權綁定
                                </button>
                            </div>
                        </div>
                    </form>

                    <div class="small fw-semibold mb-2">目前生效中的家長與學生綁定清單（家長僅能查看與預約已綁定之學生）：</div>
                    <div class="d-grid gap-2" style="max-height: 240px; overflow-y: auto;">
                        @foreach (var link in Model.AllParentStudentLinks)
                        {
                            <div class="p-2 border rounded-3 bg-light d-flex justify-content-between align-items-center small">
                                <div>
                                    <strong>@link.ParentUser?.DisplayName</strong> (<code>@link.ParentUser?.Username</code>)
                                    <i class="bi bi-arrow-left-right mx-1 text-muted"></i>
                                    <span class="badge bg-dark">@link.Student?.FullName (@link.Student?.GradeClass)</span>
                                    <span class="text-muted ms-1">[@link.Relationship]</span>
                                </div>
                                <form method="post" asp-page-handler="UnlinkParentStudent"
                                      onsubmit="return confirm('確定要解除此家長對該學生的存取綁定嗎？');">
                                    <input type="hidden" name="linkId" value="@link.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0">解除</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- 全系統帳號總覽與密碼重設 -->
        <div class="card-plato p-3 p-md-4">
            <div class="section-header-clean">
                <div class="section-header-title">
                    <span class="metric-icon-box"><i class="bi bi-key-fill"></i></span>
                    <div>
                        <h2 class="h5 fw-bold mb-0">全系統登入帳號清單與密碼／聯絡資訊維護</h2>
                        <div class="small text-muted">可隨時為家長、老師或管理員重設密碼、修改聯絡電話與 LINE User ID</div>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle table-plato table-responsive-cards mb-0">
                    <thead>
                        <tr>
                            <th>角色</th>
                            <th>顯示姓名 / 登入帳號</th>
                            <th>關聯學生（家長適用）</th>
                            <th>電話與 LINE 通知綁定</th>
                            <th>重設密碼 / 儲存更新</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.AllUsers)
                        {
                            var linkedStudents = Model.AllParentStudentLinks
                                .Where(l => l.ParentUserId == u.Id)
                                .Select(l => $"{l.Student?.FullName}({l.Student?.GradeClass})")
                                .ToList();

                            <tr>
                                <td data-label="角色">
                                    <span class="badge @(u.Role == UserRole.Admin ? "bg-dark" : u.Role == UserRole.Teacher ? "badge-slot-group" : "badge-slot-small")">
                                        @(u.Role == UserRole.Admin ? "管理員 (Admin)" : u.Role == UserRole.Teacher ? "授課老師 (Teacher)" : "家長 (Parent)")
                                    </span>
                                </td>
                                <td data-label="姓名 / 帳號">
                                    <div class="fw-bold">@u.DisplayName</div>
                                    <div class="small text-muted">登入帳號：<code>@u.Username</code></div>
                                </td>
                                <td data-label="關聯學生" class="small">
                                    @if (u.Role == UserRole.Parent)
                                    {
                                        if (linkedStudents.Any())
                                        {
                                            <span>@string.Join("、", linkedStudents)</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">尚未綁定學生</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">全班別教務／系統權限</span>
                                    }
                                </td>
                                <td data-label="聯絡與密碼維護" colspan="2">
                                    <form method="post" asp-page-handler="ResetPassword" class="row g-2 align-items-center justify-content-end">
                                        <input type="hidden" name="targetUserId" value="@u.Id" />
                                        <div class="col-12 col-md-3">
                                            <input type="text" name="phone" class="form-control form-control-sm" value="@u.Phone" placeholder="聯絡電話" />
                                        </div>
                                        <div class="col-12 col-md-4">
                                            <input type="text" name="lineUserId" class="form-control form-control-sm" value="@u.LineUserId" placeholder="LINE User ID" />
                                        </div>
                                        <div class="col-12 col-md-3">
                                            <input type="password" name="newPassword" class="form-control form-control-sm" placeholder="輸入新密碼（留空不改）" />
                                        </div>
                                        <div class="col-12 col-md-2 text-end">
                                            <button type="submit" class="btn btn-sm btn-outline-dark w-100">更新設定</button>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 分頁二：學期與每週課程進度控制 -->
    <div class="tab-pane fade" id="tab-admin-semester" role="tabpanel">
        <div class="row g-4">
            <div class="col-12 col-xl-7">
                <div class="card-plato p-3 p-md-4 h-100">
                    <div class="section-header-clean">
                        <div class="section-header-title">
                            <span class="metric-icon-box"><i class="bi bi-calendar-range"></i></span>
                            <div>
                                <h2 class="h5 fw-bold mb-0">學期與目前開放進度切換</h2>
                                <div class="small text-muted">
                                    目前學期：@Model.CurrentSemester?.Name（每學期預設贈送 @Model.CurrentSemester?.DefaultBonusCredits 堂）
                                </div>
                            </div>
                        </div>
                        <form method="post" asp-page-handler="EndSemesterBonusExpiry"
                              onsubmit="return confirm('確定要執行「學期結束贈送堂數歸零」嗎？所有學生未使用的贈送堂數將歸零並寫入稽核流水帳（付費堂數保留）。');">
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-hourglass-bottom me-1"></i>期末贈送堂數歸零
                            </button>
                        </form>
                    </div>

                    <div class="small fw-semibold mb-2">切換目前開放預約進度（家長僅可預約目前進度）：</div>
                    <div class="d-grid gap-2">
                        @foreach (var p in Model.AllProgresses)
                        {
                            <div class="p-3 border rounded-3 d-flex justify-content-between align-items-center @(p.IsCurrentProgress ? "bg-light border-dark" : "")">
                                <div>
                                    <strong>@p.Code @p.Title</strong>
                                    <span class="badge bg-secondary ms-1">@p.GradeClass</span>
                                    <div class="small text-muted">@p.WeekStartDate.ToString("MM/dd") ~ @p.WeekEndDate.ToString("MM/dd")</div>
                                </div>
                                @if (p.IsCurrentProgress)
                                {
                                    <span class="badge bg-success px-3 py-2">目前開放進度</span>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="SwitchCurrentProgress">
                                        <input type="hidden" name="progressId" value="@p.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-dark">設為目前進度</button>
                                    </form>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-5">
                <div class="card-plato p-3 p-md-4 h-100">
                    <div class="section-header-clean">
                        <div class="section-header-title">
                            <span class="metric-icon-box sage"><i class="bi bi-plus-square-fill"></i></span>
                            <div>
                                <h2 class="h5 fw-bold mb-0">新增每週課程進度</h2>
                                <div class="small text-muted">設定進度代碼、起訖日期與適用班別</div>
                            </div>
                        </div>
                    </div>
                    <form method="post" asp-page-handler="CreateProgress">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">進度代碼（如 W09）</label>
                            <input type="text" name="code" class="form-control" placeholder="例如：W09" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">進度主題名稱</label>
                            <input type="text" name="title" class="form-control" placeholder="例如：幾何證明與相似形總複習" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">適用班別</label>
                            <input type="text" name="gradeClass" class="form-control" value="國三A班" required />
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label small fw-semibold">開始日期</label>
                                <input type="date" name="weekStartDate" class="form-control" value="2026-11-02" required />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-semibold">結束日期</label>
                                <input type="date" name="weekEndDate" class="form-control" value="2026-11-08" required />
                            </div>
                        </div>
                        <div class="form-check mb-3 small">
                            <input type="checkbox" class="form-check-input" id="setAsCurrent" name="setAsCurrent" value="true" />
                            <label class="form-check-label" for="setAsCurrent">立即設為目前開放進度</label>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-check2-circle me-1"></i>新增課程進度
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- 分頁三：新增學生、插班生比例贈送堂數與爽約記點規則 -->
    <div class="tab-pane fade" id="tab-admin-students" role="tabpanel">
        <div class="row g-4">
            <div class="col-12 col-xl-6">
                <div class="card-plato p-3 p-md-4 h-100">
                    <div class="section-header-clean">
                        <div class="section-header-title">
                            <span class="metric-icon-box ocean"><i class="bi bi-person-plus-fill"></i></span>
                            <div>
                                <h2 class="h5 fw-bold mb-0">新增學生與插班生比例贈送堂數</h2>
                                <div class="small text-muted">依「入班日至期末剩餘天數 ÷ 學期總天數 × 3 堂」四捨五入核發</div>
                            </div>
                        </div>
                    </div>
                    <form method="post" asp-page-handler="CreateStudent">
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label small fw-semibold" for="stuName">學生姓名</label>
                                <input type="text" id="stuName" name="fullName" class="form-control" placeholder="例如：張子軒" required />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-semibold" for="stuClass">班別</label>
                                <input type="text" id="stuClass" name="gradeClass" class="form-control" value="國三A班" required />
                            </div>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label small fw-semibold" for="enrollDate">入班日期</label>
                                <input type="date" id="enrollDate" name="enrollmentDate" class="form-control"
                                       value="@DateTime.UtcNow.AddHours(8).ToString("yyyy-MM-dd")" required />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-semibold" for="parentUser">關聯家長帳號</label>
                                <select id="parentUser" name="parentUserId" class="form-select" required>
                                    @foreach (var p in Model.ParentUsers)
                                    {
                                        <option value="@p.Id">@p.DisplayName (@p.Username)</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-check mb-3 small">
                            <input type="checkbox" class="form-check-input" id="grantProRataBonus" name="grantProRataBonus" value="true" checked />
                            <label class="form-check-label" for="grantProRataBonus">自動依入班日比例核發本學期贈送堂數</label>
                        </div>
                        <button type="submit" class="btn btn-accent w-100">
                            <i class="bi bi-person-check-fill me-1"></i>新增學生並核發贈送堂數
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-12 col-xl-6">
                <div class="card-plato p-3 p-md-4 h-100">
                    <div class="section-header-clean">
                        <div class="section-header-title">
                            <span class="metric-icon-box"><i class="bi bi-sliders"></i></span>
                            <div>
                                <h2 class="h5 fw-bold mb-0">團體課爽約記點規則與到班目的管理</h2>
                                <div class="small text-muted">管理爽約停權開關與家長預約必填之到班目的選項</div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center p-3 bg-light border rounded-3 mb-3">
                        <div class="small">
                            <div class="fw-bold">團體課爽約記點停權（30 天內爽約 3 次暫停預約 14 天）</div>
                            <div class="text-muted">目前狀態：@(Model.IsGroupNoShowPenaltyEnabled ? "已啟用" : "預設關閉")</div>
                        </div>
                        <form method="post" asp-page-handler="ToggleNoShowPenalty">
                            <input type="hidden" name="enabled" value="@(Model.IsGroupNoShowPenaltyEnabled ? "false" : "true")" />
                            <button type="submit" class="btn btn-sm @(Model.IsGroupNoShowPenaltyEnabled ? "btn-outline-danger" : "btn-outline-success")">
                                @(Model.IsGroupNoShowPenaltyEnabled ? "切換為關閉" : "切換為啟用")
                            </button>
                        </form>
                    </div>

                    <div class="small fw-semibold mb-2">目前開放之到班目的及預約次數分佈：</div>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @foreach (var p in Model.PurposeOptions)
                        {
                            var cnt = Model.PurposeCounts.TryGetValue(p.Name, out var c) ? c : 0;
                            <span class="badge bg-light text-dark border p-2">
                                @p.Name <strong class="text-primary">(@cnt 筆)</strong>
                            </span>
                        }
                    </div>
                    <form method="post" asp-page-handler="AddPurpose" class="d-flex gap-2">
                        <input type="text" name="purposeName" class="form-control" placeholder="新增自訂到班目的名稱" required />
                        <button type="submit" class="btn btn-outline-dark text-nowrap">新增目的</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- 分頁四：退班批次結算計算器 -->
    <div class="tab-pane fade" id="tab-admin-dropout" role="tabpanel">
        <div class="card-plato p-3 p-md-4">
            <div class="section-header-clean">
                <div class="section-header-title">
                    <span class="metric-icon-box"><i class="bi bi-calculator-fill"></i></span>
                    <div>
                        <h2 class="h5 fw-bold mb-0">退班結算計算器（依各批儲值單價計算應退金額）</h2>
                        <div class="small text-muted">退款採線下處理並留存紀錄；贈送堂數僅供折抵課程，退班時不計入退費金額</div>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle table-plato table-responsive-cards mb-0">
                    <thead>
                        <tr>
                            <th>學生</th>
                            <th>剩餘可退付費堂數</th>
                            <th>作廢贈送堂數</th>
                            <th>批次計價明細</th>
                            <th>試算應退總金額</th>
                            <th>執行退班結算</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pre in Model.SettlementPreviews)
                        {
                            <tr>
                                <td data-label="學生"><strong>@pre.StudentName</strong></td>
                                <td data-label="可退付費堂數"><span class="badge badge-paid fs-6">@pre.TotalRefundablePaidCredits 堂</span></td>
                                <td data-label="作廢贈送堂數"><span class="badge badge-bonus">@pre.RemainingBonusCreditsToForfeit 堂</span></td>
                                <td data-label="批次計價明細" class="small">
                                    @if (pre.BatchBreakdowns.Any())
                                    {
                                        @string.Join("；", pre.BatchBreakdowns)
                                    }
                                    else
                                    {
                                        <span class="text-muted">無剩餘付費批次</span>
                                    }
                                </td>
                                <td data-label="應退總金額" class="fw-bold text-danger fs-5">
                                    NT$@pre.TotalRefundAmountNtd.ToString("N0")
                                </td>
                                <td data-label="執行退班">
                                    <form method="post" asp-page-handler="ExecuteDropout" class="d-flex gap-1 justify-content-end"
                                          onsubmit="return confirm('確定要為 @pre.StudentName 執行退班結算（應退 NT$@pre.TotalRefundAmountNtd.ToString("N0")）並將堂數歸零嗎？');">
                                        <input type="hidden" name="studentId" value="@pre.StudentId" />
                                        <input type="text" name="note" class="form-control form-control-sm" placeholder="退費備註" style="max-width: 140px;" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger text-nowrap">退班結算</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.PastSettlements.Any())
            {
                <hr class="my-3" />
                <h3 class="h6 fw-bold mb-2">歷史退班結算紀錄</h3>
                <div class="d-grid gap-2">
                    @foreach (var s in Model.PastSettlements)
                    {
                        <div class="p-3 border rounded-3 bg-light small">
                            <strong>@s.Student?.FullName</strong> － 退還付費 @s.TotalRefundablePaidCredits 堂 /
                            應退金額 <strong>NT$@s.CalculatedRefundAmountNtd.ToString("N0")</strong>
                            （@s.BreakdownSummary）｜ 經辦：@s.ProcessedByAdminName (@BookingService.ToTaipeiTime(s.CreatedAtUtc).ToString("yyyy-MM-dd HH:mm"))
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- 分頁五：不可篡改流水帳與 LINE 通知稽核 -->
    <div class="tab-pane fade" id="tab-admin-audit" role="tabpanel">
        <div class="row g-4">
            <div class="col-12 col-xl-7">
                <div class="card-plato p-3 p-md-4 h-100">
                    <div class="section-header-clean">
                        <div class="section-header-title">
                            <span class="metric-icon-box ocean"><i class="bi bi-journal-code"></i></span>
                            <div>
                                <h2 class="h5 fw-bold mb-0">全系統最新堂數異動流水帳稽核</h2>
                                <div class="small text-muted">不可篡改之帳務軌跡，所有更正皆透過沖正調整紀錄</div>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle table-plato table-responsive-cards mb-0">
                            <thead>
                                <tr>
                                    <th>時間</th>
                                    <th>學生</th>
                                    <th>類型</th>
                                    <th>贈送/付費異動</th>
                                    <th>摘要與操作人</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in Model.RecentLedgerEntries)
                                {
                                    <tr>
                                        <td data-label="時間" class="small">@BookingService.ToTaipeiTime(e.CreatedAtUtc).ToString("MM/dd HH:mm")</td>
                                        <td data-label="學生"><strong>@e.Student?.FullName</strong></td>
                                        <td data-label="類型"><span class="badge bg-secondary">@e.TransactionType</span></td>
                                        <td data-label="異動">
                                            贈送 @(e.BonusDelta >= 0 ? $"+{e.BonusDelta}" : e.BonusDelta.ToString()) /
                                            付費 @(e.PaidDelta >= 0 ? $"+{e.PaidDelta}" : e.PaidDelta.ToString())
                                        </td>
                                        <td data-label="摘要與操作人" class="small">@e.ReferenceNote (@e.OperatorName)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-5">
                <div class="card-plato p-3 p-md-4 h-100">
                    <div class="section-header-clean">
                        <div class="section-header-title">
                            <span class="metric-icon-box sage"><i class="bi bi-chat-dots-fill"></i></span>
                            <div>
                                <h2 class="h5 fw-bold mb-0">LINE 推播紀錄與失敗重試管理</h2>
                                <div class="small text-muted">支援冪等鍵防重複發送與失敗手動重試</div>
                            </div>
                        </div>
                    </div>
                    <div class="d-grid gap-2">
                        @foreach (var log in Model.RecentLineLogs)
                        {
                            <div class="p-3 border rounded-3 bg-light small">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span>
                                        <strong>@log.RecipientParentUser?.DisplayName</strong>
                                        <span class="badge @(log.Status.StartsWith("Failed") ? "bg-danger" : "bg-success") ms-1">@log.Status</span>
                                    </span>
                                    <span class="text-muted">@BookingService.ToTaipeiTime(log.SentAtUtc).ToString("MM/dd HH:mm")</span>
                                </div>
                                <div class="mb-1">@log.MessageText</div>
                                <div class="d-flex justify-content-between align-items-center text-muted">
                                    <span>冪等鍵：<code>@log.IdempotencyKey</code> (重試:@log.RetryCount)</span>
                                    @if (log.Status.StartsWith("Failed"))
                                    {
                                        <form method="post" asp-page-handler="RetryLine">
                                            <input type="hidden" name="logId" value="@log.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary py-0">重試推播</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
