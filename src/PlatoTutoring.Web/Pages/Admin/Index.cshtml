@page
@model PlatoTutoring.Web.Pages.Admin.IndexModel
@using PlatoTutoring.Web.Models
@using PlatoTutoring.Web.Services
@{
    ViewData["Title"] = "管理員營運與月報表中心";
}
@functions {
    string GetTransactionTypeName(LedgerTransactionType type) => type switch
    {
        LedgerTransactionType.TopUpPaid => "儲值付費堂數",
        LedgerTransactionType.SemesterBonusGrant => "學期贈送核發",
        LedgerTransactionType.ManualBonusGrant => "人工贈送核發",
        LedgerTransactionType.BookingDeduct => "預約扣抵堂數",
        LedgerTransactionType.CancelRefund => "取消全額退回",
        LedgerTransactionType.AdjustmentReversal => "沖正調整記錄",
        LedgerTransactionType.SemesterBonusExpiry => "期末贈堂歸零",
        LedgerTransactionType.DropoutSettlementDeduct => "退班結算結清",
        _ => type.ToString()
    };
    string GetTransactionTypeBadgeClass(LedgerTransactionType type) => type switch
    {
        LedgerTransactionType.TopUpPaid => "bg-success text-white",
        LedgerTransactionType.SemesterBonusGrant => "bg-info text-dark",
        LedgerTransactionType.ManualBonusGrant => "bg-info text-dark",
        LedgerTransactionType.BookingDeduct => "bg-primary text-white",
        LedgerTransactionType.CancelRefund => "bg-teal text-white",
        LedgerTransactionType.AdjustmentReversal => "bg-warning text-dark",
        LedgerTransactionType.SemesterBonusExpiry => "bg-secondary text-white",
        LedgerTransactionType.DropoutSettlementDeduct => "bg-danger text-white",
        _ => "bg-secondary text-white"
    };
}

<!-- 頂部管理員工作台標題、正式環境連線狀態與匯出工具 -->
<div class="card-plato p-3 p-md-4 mb-4">
    <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3">
        <div>
            <div class="eyebrow-tag">
                <i class="bi bi-bar-chart-line-fill"></i>
                <span>管理員決策與稽核中心 · Admin Console</span>
            </div>
            <h1 class="h3 fw-bold mb-1">營運月報表、帳號權限、學期規則與退班結算中心</h1>
            <p class="text-secondary small mb-2">
                管理員：<strong>@Model.CurrentUser.DisplayName</strong> ｜ 涵蓋家長／老師／管理員帳號管理、學生關聯授權、財務對帳與退班結算
            </p>
            <div class="d-flex flex-wrap gap-2 small">
                <span class="badge bg-light text-dark border px-2 py-1">
                    <i class="bi bi-database-check text-primary me-1"></i>資料庫：@Model.DatabaseStatusText
                </span>
                <span class="badge bg-light text-dark border px-2 py-1">
                    <i class="bi bi-cloud-check text-success me-1"></i>憑證儲存：@Model.BlobStorageStatusText
                </span>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="/admin/export/credits.csv" class="btn btn-accent btn-sm">
                <i class="bi bi-filetype-csv me-1"></i>匯出學生堂數 CSV
            </a>
            <form method="post" asp-page-handler="PurgeExpiredAttachments" class="d-inline">
                <button type="submit" class="btn btn-outline-dark btn-sm">
                    <i class="bi bi-trash3 me-1"></i>清除 90 天到期截圖
                </button>
            </form>
        </div>
    </div>
</div>

<!-- 營運月報表核心指標 (KPI 卡片列) -->
<section class="mb-4">
    <div class="row g-3">
        <div class="col-6 col-md-4 col-xl-2">
            <div class="metric-card metric-ocean h-100">
                <div class="small text-secondary fw-semibold">儲值入帳總額</div>
                <div class="fs-4 fw-bold mt-1">NT$@Model.TotalTopUpAmountNtd.ToString("N0")</div>
                <div class="small text-muted">人工核對匯款入帳</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="metric-card h-100">
                <div class="small text-secondary fw-semibold">預收款餘額</div>
                <div class="fs-4 fw-bold mt-1">NT$@Model.TotalUnearnedRevenueNtd.ToString("N0")</div>
                <div class="small text-muted">未消耗付費堂數價值</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="metric-card metric-sage h-100">
                <div class="small text-secondary fw-semibold">課堂出席率</div>
                <div class="fs-4 fw-bold mt-1">@Model.AttendanceRatePercent%</div>
                <div class="small text-muted">依已點名課程統計</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="metric-card metric-ocean h-100">
                <div class="small text-secondary fw-semibold">時段滿座率</div>
                <div class="fs-4 fw-bold mt-1">@Model.SlotUtilizationPercent%</div>
                <div class="small text-muted">已預約 / 總開放名額</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="metric-card metric-sage h-100">
                <div class="small text-secondary fw-semibold">作業不佳解決率</div>
                <div class="fs-4 fw-bold mt-1">@Model.HomeworkResolvedCount / @Model.HomeworkTotalCount</div>
                <div class="small text-muted">已預約輔導 / 總標記數</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="metric-card h-100">
                <div class="small text-secondary fw-semibold">LINE 推播用量</div>
                <div class="fs-4 fw-bold mt-1">@Model.LineSentTotal 則</div>
                <div class="small text-muted">失敗待重試：@Model.LineFailedTotal 則</div>
            </div>
        </div>
    </div>
</section>

<!-- 夜間對帳檢核狀態橫幅 -->
<div class="alert @(Model.Discrepancies.Count == 0 ? "alert-success" : "alert-danger") border-0 shadow-sm mb-4 p-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <i class="bi @(Model.Discrepancies.Count == 0 ? "bi-shield-check" : "bi-exclamation-diamond") fs-4"></i>
            <div>
                <strong>系統堂數三方對帳結果：</strong>
                @if (Model.Discrepancies.Count == 0)
                {
                    <span>所有學生的「主檔餘額」、「不可篡改流水帳總和」與「儲值批次剩餘堂數」100% 吻合，無任何帳務異常。</span>
                }
                else
                {
                    <span>發現 @Model.Discrepancies.Count 筆帳務不一致異常，請立即檢視！</span>
                }
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (Model.Discrepancies.Count > 0)
            {
                <button type="button" class="btn btn-sm btn-danger fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalReconciliationDetails">
                    <i class="bi bi-eye-fill me-1"></i>立即檢視異常明細清單 (@Model.Discrepancies.Count)
                </button>
            }
            <span class="badge bg-dark">對帳時間：@DateTime.UtcNow.AddHours(8).ToString("yyyy-MM-dd HH:mm")</span>
        </div>
    </div>
</div>

<!-- 膠囊式分段工作區頁籤 (Segmented Workspace Tabs，移除數字) -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <ul class="nav nav-pills workspace-tabs-shell" id="adminWorkspaceTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="btn-admin-dropout" data-bs-toggle="pill"
                    data-bs-target="#tab-admin-dropout" type="button" role="tab">
                <i class="bi bi-calculator-fill"></i>
                <span>退班批次結算</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="btn-admin-audit" data-bs-toggle="pill"
                    data-bs-target="#tab-admin-audit" type="button" role="tab">
                <i class="bi bi-journal-code"></i>
                <span>流水帳與 LINE 稽核</span>
            </button>
        </li>
    </ul>

    <span class="small text-secondary">
        <i class="bi bi-compass me-1"></i>點選上方頁籤或左側子選單可快速切換管理分頁
    </span>
</div>

<div class="tab-content" id="adminWorkspaceTabContent">
    <!-- 分頁一：退班批次結算計算器 -->
    <div class="tab-pane fade show active" id="tab-admin-dropout" role="tabpanel">
        <div class="card-plato p-3 p-md-4">
            <div class="section-header-clean">
                <div class="section-header-title">
                    <span class="metric-icon-box"><i class="bi bi-calculator-fill"></i></span>
                    <div>
                        <h2 class="h5 fw-bold mb-0">退班結算計算器（依各批儲值單價計算應退金額）</h2>
                        <div class="small text-muted">退款採線下處理並留存紀錄；贈送堂數僅供折抵課程，退班時不計入退費金額</div>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle table-plato table-responsive-cards mb-0">
                    <thead>
                        <tr>
                            <th>學生</th>
                            <th>剩餘可退付費堂數</th>
                            <th>作廢贈送堂數</th>
                            <th>批次計價明細</th>
                            <th>試算應退總金額</th>
                            <th>執行退班結算</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pre in Model.SettlementPreviews)
                        {
                            <tr>
                                <td data-label="學生"><strong>@pre.StudentName</strong></td>
                                <td data-label="可退付費堂數"><span class="badge badge-paid fs-6">@pre.TotalRefundablePaidCredits 堂</span></td>
                                <td data-label="作廢贈送堂數"><span class="badge badge-bonus">@pre.RemainingBonusCreditsToForfeit 堂</span></td>
                                <td data-label="批次計價明細" class="small">
                                    @if (pre.BatchBreakdowns.Any())
                                    {
                                        @string.Join("；", pre.BatchBreakdowns)
                                    }
                                    else
                                    {
                                        <span class="text-muted">無剩餘付費批次</span>
                                    }
                                </td>
                                <td data-label="應退總金額" class="fw-bold text-danger fs-5">
                                    NT$@pre.TotalRefundAmountNtd.ToString("N0")
                                </td>
                                <td data-label="執行退班">
                                    <form method="post" asp-page-handler="ExecuteDropout" class="d-flex gap-1 justify-content-end"
                                          onsubmit="return confirm('確定要為 @pre.StudentName 執行退班結算（應退 NT$@pre.TotalRefundAmountNtd.ToString("N0")）並將堂數歸零嗎？');">
                                        <input type="hidden" name="studentId" value="@pre.StudentId" />
                                        <input type="text" name="note" class="form-control form-control-sm" placeholder="退費備註" style="max-width: 140px;" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger text-nowrap">退班結算</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.PastSettlements.Any())
            {
                <hr class="my-3" />
                <h3 class="h6 fw-bold mb-2">歷史退班結算紀錄</h3>
                <div class="d-grid gap-2">
                    @foreach (var s in Model.PastSettlements)
                    {
                        <div class="p-3 border rounded-3 bg-light small">
                            <strong>@s.Student?.FullName</strong> － 退還付費 @s.TotalRefundablePaidCredits 堂 /
                            應退金額 <strong>NT$@s.CalculatedRefundAmountNtd.ToString("N0")</strong>
                            （@s.BreakdownSummary）｜ 經辦：@s.ProcessedByAdminName (@BookingService.ToTaipeiTime(s.CreatedAtUtc).ToString("yyyy-MM-dd HH:mm"))
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- 分頁五：不可篡改流水帳與 LINE 通知稽核 -->
    <div class="tab-pane fade" id="tab-admin-audit" role="tabpanel">
        <div class="row g-4">
            <div class="col-12 col-xl-7">
                <div class="card-plato p-3 p-md-4 h-100">
                    <div class="section-header-clean">
                        <div class="section-header-title">
                            <span class="metric-icon-box ocean"><i class="bi bi-journal-code"></i></span>
                            <div>
                                <h2 class="h5 fw-bold mb-0">全系統最新堂數異動流水帳稽核</h2>
                                <div class="small text-muted">不可篡改之帳務軌跡，所有更正皆透過沖正調整紀錄</div>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle table-plato table-responsive-cards mb-0">
                            <thead>
                                <tr>
                                    <th>時間</th>
                                    <th>學生</th>
                                    <th>類型</th>
                                    <th>贈送/付費異動</th>
                                    <th>摘要與操作人</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in Model.RecentLedgerEntries)
                                {
                                    <tr>
                                        <td data-label="時間" class="small">@BookingService.ToTaipeiTime(e.CreatedAtUtc).ToString("MM/dd HH:mm")</td>
                                        <td data-label="學生"><strong>@e.Student?.FullName</strong></td>
                                        <td data-label="類型"><span class="badge @GetTransactionTypeBadgeClass(e.TransactionType)">@GetTransactionTypeName(e.TransactionType)</span></td>
                                        <td data-label="異動">
                                            贈送 @(e.BonusDelta >= 0 ? $"+{e.BonusDelta}" : e.BonusDelta.ToString()) /
                                            付費 @(e.PaidDelta >= 0 ? $"+{e.PaidDelta}" : e.PaidDelta.ToString())
                                        </td>
                                        <td data-label="摘要與操作人" class="small">@e.ReferenceNote (@e.OperatorName)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-5">
                <div class="card-plato p-3 p-md-4 h-100">
                    <div class="section-header-clean">
                        <div class="section-header-title">
                            <span class="metric-icon-box sage"><i class="bi bi-chat-dots-fill"></i></span>
                            <div>
                                <h2 class="h5 fw-bold mb-0">LINE 推播紀錄與失敗重試管理</h2>
                                <div class="small text-muted">支援冪等鍵防重複發送與失敗手動重試</div>
                            </div>
                        </div>
                    </div>
                    <div class="d-grid gap-2">
                        @foreach (var log in Model.RecentLineLogs)
                        {
                            <div class="p-3 border rounded-3 bg-light small">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span>
                                        <strong>@log.RecipientParentUser?.DisplayName</strong>
                                        <span class="badge @(log.Status.StartsWith("Failed") ? "bg-danger" : "bg-success") ms-1">@log.Status</span>
                                    </span>
                                    <span class="text-muted">@BookingService.ToTaipeiTime(log.SentAtUtc).ToString("MM/dd HH:mm")</span>
                                </div>
                                <div class="mb-1">@log.MessageText</div>
                                <div class="d-flex justify-content-between align-items-center text-muted">
                                    <span>冪等鍵：<code>@log.IdempotencyKey</code> (重試:@log.RetryCount)</span>
                                    @if (log.Status.StartsWith("Failed"))
                                    {
                                        <form method="post" asp-page-handler="RetryLine">
                                            <input type="hidden" name="logId" value="@log.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary py-0">重試推播</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 三方對帳異常明細檢視與自動修復彈跳視窗 -->
<div class="modal fade" id="modalReconciliationDetails" tabindex="-1" aria-labelledby="modalReconciliationDetailsLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content shadow border-0">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="modalReconciliationDetailsLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>系統堂數三方對帳異常明細檢視清單（發現 @Model.Discrepancies.Count 筆）
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="關閉"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-warning mb-3">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <strong><i class="bi bi-shield-exclamation me-1"></i>對帳規則說明：</strong>
                            系統夜間自動比對「學生主檔付費堂數」、「不可篡改流水帳累計 Delta」與「儲值批次 RemainingPaidCredits 總和」。若歷史遷移或測試資料未補建批次，將產生差額提示。
                        </div>
                        <form method="post" asp-page-handler="SyncReconciliationFix"
                              onsubmit="return confirm('確定要執行一鍵自動同步校準嗎？系統將為有差額的在籍學生自動建立同步期初批次與流水帳記錄。');">
                            <button type="submit" class="btn btn-danger fw-bold shadow-sm">
                                <i class="bi bi-wrench-adjustable-circle me-1"></i>一鍵自動同步校準
                            </button>
                        </form>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle small mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>學生編號</th>
                                <th>學生姓名</th>
                                <th>主檔付費堂數</th>
                                <th>流水帳付費合計</th>
                                <th>儲值批次剩餘合計</th>
                                <th>主檔贈送堂數</th>
                                <th>流水帳贈送合計</th>
                                <th>不一致異常診斷詳情</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Discrepancies.Count == 0)
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-success py-4">
                                        <i class="bi bi-check-circle-fill me-1"></i>太棒了！目前無任何對帳不一致異常。
                                    </td>
                                </tr>
                            }
                            @foreach (var d in Model.Discrepancies)
                            {
                                <tr>
                                    <td><code>#@d.StudentId</code></td>
                                    <td class="fw-bold">@d.StudentName</td>
                                    <td><span class="badge bg-primary">@d.ActualPaidCredits 堂</span></td>
                                    <td><span class="badge @(d.ActualPaidCredits == d.LedgerPaidSum ? "bg-success" : "bg-danger")">@d.LedgerPaidSum 堂</span></td>
                                    <td><span class="badge @(d.ActualPaidCredits == d.BatchRemainingPaidSum ? "bg-success" : "bg-danger")">@d.BatchRemainingPaidSum 堂</span></td>
                                    <td><span class="badge bg-secondary">@d.ActualBonusCredits 堂</span></td>
                                    <td><span class="badge @(d.ActualBonusCredits == d.LedgerBonusSum ? "bg-success" : "bg-danger")">@d.LedgerBonusSum 堂</span></td>
                                    <td class="text-danger small font-monospace">@d.IssueSummary</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">關閉視窗</button>
            </div>
        </div>
    </div>
</div>

