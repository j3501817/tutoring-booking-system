@page
@model PlatoTutoring.Web.Pages.Account.LoginModel
@{
    Layout = null;
    var successMsg = TempData["SuccessMessage"] as string;
    var errorMsg = TempData["ErrorMessage"] as string;
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>帳號登入 - 柏拉圖文理補習班 輔導預約系統</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body class="login-body">
    <main class="login-stage">
        <!-- 背景插畫：極光星河、世界星軌、夢想羅盤與通往未來的光之航道 -->
        <svg class="login-scene" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
            <defs>
                <linearGradient id="skyGrad" x1="0" y1="0" x2="0.2" y2="1">
                    <stop offset="0" stop-color="#030914" />
                    <stop offset="0.38" stop-color="#07192d" />
                    <stop offset="0.68" stop-color="#0d3149" />
                    <stop offset="0.86" stop-color="#194d5c" />
                    <stop offset="1" stop-color="#28646a" />
                </linearGradient>

                <linearGradient id="auroraRibbon1" x1="0" y1="0" x2="1" y2="0.4">
                    <stop offset="0" stop-color="#4de6b8" stop-opacity="0" />
                    <stop offset="0.28" stop-color="#62f2c5" stop-opacity="0.38" />
                    <stop offset="0.62" stop-color="#45c4e8" stop-opacity="0.28" />
                    <stop offset="1" stop-color="#a18cff" stop-opacity="0" />
                </linearGradient>

                <linearGradient id="auroraRibbon2" x1="1" y1="0" x2="0" y2="0.6">
                    <stop offset="0" stop-color="#7ef7d1" stop-opacity="0" />
                    <stop offset="0.4" stop-color="#8ff0c9" stop-opacity="0.32" />
                    <stop offset="0.75" stop-color="#ffd599" stop-opacity="0.22" />
                    <stop offset="1" stop-color="#ffd599" stop-opacity="0" />
                </linearGradient>

                <radialGradient id="horizonGlow" cx="0.42" cy="0.64" r="0.48">
                    <stop offset="0" stop-color="#ffebc2" stop-opacity="0.92" />
                    <stop offset="0.28" stop-color="#ffbe78" stop-opacity="0.52" />
                    <stop offset="0.62" stop-color="#5cd6b8" stop-opacity="0.22" />
                    <stop offset="1" stop-color="#07192d" stop-opacity="0" />
                </radialGradient>

                <radialGradient id="planetGlow" cx="0.35" cy="0.3" r="0.7">
                    <stop offset="0" stop-color="#d6fff0" stop-opacity="0.45" />
                    <stop offset="0.55" stop-color="#58d5c9" stop-opacity="0.2" />
                    <stop offset="1" stop-color="#103752" stop-opacity="0.06" />
                </radialGradient>

                <linearGradient id="mountainFar" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#174559" />
                    <stop offset="1" stop-color="#0c2636" />
                </linearGradient>

                <linearGradient id="mountainMid" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#0e2f41" />
                    <stop offset="1" stop-color="#071824" />
                </linearGradient>

                <linearGradient id="mountainNear" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#071a26" />
                    <stop offset="1" stop-color="#030b12" />
                </linearGradient>

                <linearGradient id="dreamPathGrad" x1="0" y1="1" x2="0" y2="0">
                    <stop offset="0" stop-color="#8ff0c9" stop-opacity="0.12" />
                    <stop offset="0.55" stop-color="#ffe1a8" stop-opacity="0.55" />
                    <stop offset="1" stop-color="#fff7df" stop-opacity="0.95" />
                </linearGradient>

                <linearGradient id="arcLineGrad" x1="0" y1="1" x2="1" y2="0">
                    <stop offset="0" stop-color="#ffd89c" stop-opacity="0" />
                    <stop offset="0.4" stop-color="#ffd89c" stop-opacity="0.65" />
                    <stop offset="0.8" stop-color="#8ff0c9" stop-opacity="0.85" />
                    <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
                </linearGradient>

                <filter id="auroraBlur" x="-20%" y="-20%" width="140%" height="140%">
                    <feGaussianBlur stdDeviation="24" />
                </filter>

                <filter id="softGlow" x="-30%" y="-30%" width="160%" height="160%">
                    <feGaussianBlur stdDeviation="4" result="blur" />
                    <feMerge>
                        <feMergeNode in="blur" />
                        <feMergeNode in="SourceGraphic" />
                    </feMerge>
                </filter>
            </defs>

            <!-- 深邃夜空與地平線暖光 -->
            <rect width="1600" height="900" fill="url(#skyGrad)" />
            <circle cx="670" cy="580" r="640" fill="url(#horizonGlow)" />

            <!-- 極光流帶 -->
            <g filter="url(#auroraBlur)">
                <path d="M-80 260 C 240 110, 560 320, 920 170 C 1180 65, 1410 190, 1680 110 L 1680 340 C 1380 410, 1140 270, 880 370 C 520 490, 230 300, -80 420 Z" fill="url(#auroraRibbon1)" />
                <path d="M-40 160 C 310 290, 660 80, 1040 230 C 1280 320, 1470 160, 1660 220 L 1660 390 C 1440 340, 1240 460, 990 360 C 640 210, 310 410, -40 280 Z" fill="url(#auroraRibbon2)" />
            </g>

            <!-- 漫天星斗 -->
            <g fill="#ffffff">
                <circle class="twinkle" cx="110" cy="78" r="1.5" opacity="0.8" />
                <circle class="twinkle d2" cx="235" cy="142" r="1.2" opacity="0.65" />
                <circle class="twinkle d3" cx="380" cy="64" r="1.8" opacity="0.85" />
                <circle class="twinkle" cx="540" cy="118" r="1.3" opacity="0.75" />
                <circle class="twinkle d2" cx="720" cy="58" r="1.6" opacity="0.8" />
                <circle class="twinkle d3" cx="890" cy="105" r="1.4" opacity="0.7" />
                <circle class="twinkle" cx="1080" cy="68" r="1.9" opacity="0.85" />
                <circle class="twinkle d2" cx="1290" cy="96" r="1.3" opacity="0.7" />
                <circle class="twinkle d3" cx="1475" cy="74" r="1.6" opacity="0.8" />
                <circle class="twinkle" cx="165" cy="248" r="1.2" opacity="0.6" />
                <circle class="twinkle d2" cx="630" cy="220" r="1.4" opacity="0.75" />
                <circle class="twinkle d3" cx="1165" cy="215" r="1.2" opacity="0.65" />
            </g>

            <!-- 流星（象徵願望與啟程） -->
            <g opacity="0.85">
                <line x1="820" y1="88" x2="710" y2="142" stroke="url(#arcLineGrad)" stroke-width="2.2" stroke-linecap="round" />
                <circle cx="710" cy="142" r="2.6" fill="#ffffff" filter="url(#softGlow)" />
                <line x1="360" y1="96" x2="275" y2="138" stroke="url(#arcLineGrad)" stroke-width="1.8" stroke-linecap="round" />
                <circle cx="275" cy="138" r="2" fill="#8ff0c9" filter="url(#softGlow)" />
            </g>

            <!-- 象徵「世界與眼界」：發光星體地球儀與環繞星軌（左上方空中） -->
            <g class="float-a" transform="translate(270, 235)">
                <!-- 外層星軌環 -->
                <ellipse cx="0" cy="0" rx="138" ry="42" transform="rotate(-22)" fill="none" stroke="#8ff0c9" stroke-opacity="0.38" stroke-width="1.4" stroke-dasharray="6 6" />
                <ellipse cx="0" cy="0" rx="112" ry="30" transform="rotate(16)" fill="none" stroke="#ffd89c" stroke-opacity="0.32" stroke-width="1.1" />
                <!-- 地球球體與經緯度線 -->
                <circle cx="0" cy="0" r="70" fill="url(#planetGlow)" stroke="#9ef7d6" stroke-opacity="0.65" stroke-width="1.6" />
                <ellipse cx="0" cy="0" rx="70" ry="26" fill="none" stroke="#9ef7d6" stroke-opacity="0.35" stroke-width="1.1" />
                <ellipse cx="0" cy="0" rx="70" ry="52" fill="none" stroke="#9ef7d6" stroke-opacity="0.22" stroke-width="1" />
                <ellipse cx="0" cy="0" rx="28" ry="70" fill="none" stroke="#9ef7d6" stroke-opacity="0.35" stroke-width="1.1" />
                <ellipse cx="0" cy="0" rx="54" ry="70" fill="none" stroke="#9ef7d6" stroke-opacity="0.22" stroke-width="1" />
                <line x1="-70" y1="0" x2="70" y2="0" stroke="#ffd89c" stroke-opacity="0.4" stroke-width="1.1" />
                <line x1="0" y1="-70" x2="0" y2="70" stroke="#ffd89c" stroke-opacity="0.4" stroke-width="1.1" />
                <!-- 軌道上的發光節點 -->
                <circle cx="-118" cy="48" r="4.5" fill="#ffd89c" filter="url(#softGlow)" />
                <circle cx="104" cy="-42" r="4" fill="#8ff0c9" filter="url(#softGlow)" />
                <circle cx="38" cy="-24" r="3" fill="#ffffff" opacity="0.9" />
            </g>

            <!-- 象徵「方向與夢想」：星象羅盤與北極星（中上方空中） -->
            <g class="float-b" transform="translate(880, 210)">
                <circle cx="0" cy="0" r="64" fill="none" stroke="#ffd89c" stroke-opacity="0.28" stroke-width="1.2" stroke-dasharray="3 5" />
                <circle cx="0" cy="0" r="46" fill="none" stroke="#8ff0c9" stroke-opacity="0.35" stroke-width="1.2" />
                <!-- 羅盤十字星芒 -->
                <path d="M0 -56 L7 -9 L56 0 L7 9 L0 56 L-7 9 L-56 0 L-7 -9 Z" fill="#fff3d1" fill-opacity="0.75" filter="url(#softGlow)" />
                <path d="M0 -30 L12 -12 L30 0 L12 12 L0 30 L-12 12 L-30 0 L-12 -12 Z" fill="#8ff0c9" fill-opacity="0.45" />
                <circle cx="0" cy="0" r="4.5" fill="#ffffff" />
            </g>

            <!-- 象徵「探索未知星座圖」：星群連線 -->
            <g class="float-c" stroke="#9ef7d6" stroke-opacity="0.38" stroke-width="1.2" fill="#ffffff">
                <polyline points="480,150 535,118 595,144 645,102 700,132" fill="none" stroke-dasharray="4 4" />
                <circle cx="480" cy="150" r="2.8" />
                <circle cx="535" cy="118" r="3.4" fill="#8ff0c9" />
                <circle cx="595" cy="144" r="2.6" />
                <circle cx="645" cy="102" r="3.8" fill="#ffd89c" />
                <circle cx="700" cy="132" r="2.6" />
            </g>

            <!-- 象徵「夢想啟航」：由地平線升起的金色光軌與展翅紙飛機 -->
            <path d="M 650 575 C 610 470, 680 370, 795 290 C 890 224, 995 190, 1085 150" fill="none" stroke="url(#arcLineGrad)" stroke-width="2.6" stroke-dasharray="8 6" />
            <path d="M 650 575 C 520 490, 455 395, 365 305" fill="none" stroke="url(#arcLineGrad)" stroke-width="1.8" opacity="0.65" />

            <!-- 主夢想紙飛機（右上翱翔） -->
            <g class="float-a" transform="translate(1065, 152) rotate(-24)" filter="url(#softGlow)">
                <polygon points="0,0 -48,18 -20,26" fill="#ffffff" fill-opacity="0.95" />
                <polygon points="0,0 -20,26 -14,38" fill="#8ff0c9" fill-opacity="0.85" />
                <polygon points="0,0 -14,38 -6,28" fill="#ffd89c" fill-opacity="0.9" />
            </g>

            <!-- 次夢想紙飛機（中左升空） -->
            <g class="float-b" transform="translate(765, 312) rotate(-32)" opacity="0.85">
                <polygon points="0,0 -34,13 -14,19" fill="#fff5db" />
                <polygon points="0,0 -14,19 -9,27" fill="#8ff0c9" />
            </g>

            <!-- 地平線遠方晨曦與星門光環 -->
            <circle cx="670" cy="575" r="54" fill="#fff2d4" opacity="0.92" filter="url(#softGlow)" />
            <circle cx="670" cy="575" r="96" fill="none" stroke="#ffe5b4" stroke-opacity="0.35" stroke-width="1.5" />
            <circle cx="670" cy="575" r="142" fill="none" stroke="#8ff0c9" stroke-opacity="0.22" stroke-width="1.2" stroke-dasharray="6 8" />

            <!-- 層疊壯麗山巒 -->
            <path d="M0 595 L95 535 L205 575 L345 485 L485 565 L595 515 L670 575 L765 505 L895 560 L1045 470 L1195 555 L1335 495 L1485 560 L1600 520 L1600 900 L0 900 Z" fill="url(#mountainFar)" opacity="0.92" />
            <path d="M0 645 Q190 575 390 630 T750 618 T1130 640 T1460 595 T1600 625 L1600 900 L0 900 Z" fill="url(#mountainMid)" />

            <!-- 通往世界與未來的光之道路（延伸向地平線光芒） -->
            <path d="M 520 900 C 540 805, 695 755, 650 685 C 620 640, 685 612, 666 575 L 676 575 C 702 612, 648 642, 688 688 C 748 758, 635 812, 710 900 Z" fill="url(#dreamPathGrad)" filter="url(#softGlow)" />

            <!-- 前景山脊與靜謐湖岸線條 -->
            <path d="M0 735 Q240 695 495 755 T920 765 T1340 735 T1600 760 L1600 900 L0 900 Z" fill="url(#mountainNear)" />
            <path d="M 520 900 C 540 805, 695 755, 650 685 C 620 640, 685 612, 666 575 L 676 575 C 702 612, 648 642, 688 688 C 748 758, 635 812, 710 900 Z" fill="url(#dreamPathGrad)" opacity="0.68" />

            <!-- 光點漂浮（象徵夢想微光） -->
            <g fill="#ffe9b8" opacity="0.8">
                <circle class="twinkle" cx="620" cy="690" r="2.5" />
                <circle class="twinkle d2" cx="695" cy="650" r="2" />
                <circle class="twinkle d3" cx="645" cy="610" r="2.2" />
                <circle class="twinkle" cx="585" cy="755" r="3" />
                <circle class="twinkle d2" cx="725" cy="730" r="2.4" />
            </g>
        </svg>
        <div class="login-scene-overlay"></div>

        <!-- 左下品牌宣言（不再放左上角重複校徽，並預留充足底部安全間距） -->
        <section class="login-hero">
            <div class="login-hero-body">
                <div class="login-eyebrow"><span class="dot"></span> WORLD &amp; DREAMS</div>
                <h1>陪你看見方向，<br />走出屬於自己的路。</h1>
                <p>每一次耐心的引導與陪伴，都是為了讓孩子累積探索世界的底氣，勇敢飛向心中的理想與未來。</p>
            </div>
        </section>

        <!-- 右側登入卡片 -->
        <section class="login-card" aria-label="登入表單">
            <div class="login-card-header">
                <div class="login-card-logo">
                    <img src="~/images/plato-logo.png" alt="柏拉圖文理補習班校徽" />
                </div>
                <div class="login-card-brand">
                    <span class="login-card-school">柏拉圖文理補習班</span>
                    <span class="login-card-school-en">PLATO ACADEMY</span>
                </div>
            </div>

            <div class="login-card-eyebrow">輔導預約系統</div>
            <h2>歡迎回來</h2>
            <p class="login-card-sub">登入後，管理輔導預約、堂數與學習進度。</p>

            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <div class="login-alert login-alert-error" role="alert"><i class="bi bi-exclamation-circle-fill"></i> @errorMsg</div>
            }
            @if (!string.IsNullOrEmpty(successMsg))
            {
                <div class="login-alert login-alert-success" role="status"><i class="bi bi-check-circle-fill"></i> @successMsg</div>
            }

            <form method="post" autocomplete="on" class="login-form">
                <label for="Username" class="login-label">帳號</label>
                <input type="text" id="Username" name="Username" class="login-input"
                       value="@Model.Username" placeholder="請輸入帳號" autocomplete="username" required />

                <label for="Password" class="login-label">密碼</label>
                <div class="login-input-wrap">
                    <input type="password" id="Password" name="Password" class="login-input"
                           value="demo123" placeholder="請輸入密碼" autocomplete="current-password" required />
                    <button type="button" class="login-eye" id="togglePassword" aria-label="顯示或隱藏密碼">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>

                <button type="submit" class="login-submit">登入系統 <i class="bi bi-arrow-right"></i></button>
            </form>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <form method="post" asp-page-handler="Logout" class="login-logout-form">
                    <button type="submit" class="login-secondary">登出目前帳號</button>
                </form>
            }

            <details class="login-demo">
                <summary><i class="bi bi-lightning-charge-fill"></i> PM 驗收角色一鍵切換</summary>
                <div class="login-demo-list">
                    @foreach (var u in Model.DemoUsers)
                    {
                        <form method="post" asp-page-handler="QuickSwitch">
                            <input type="hidden" name="username" value="@u.Username" />
                            <button type="submit" class="login-demo-item">
                                <span class="login-demo-name">@u.DisplayName</span>
                                <span class="login-demo-role">@u.Role</span>
                            </button>
                        </form>
                    }
                </div>
            </details>

            <p class="login-foot">專屬於你的輔導空間，從這裡開始。</p>
        </section>
    </main>

    <script>
        (function () {
            var btn = document.getElementById('togglePassword');
            var input = document.getElementById('Password');
            if (!btn || !input) return;
            btn.addEventListener('click', function () {
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                btn.querySelector('i').className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
            });
        })();
    </script>
</body>
</html>
