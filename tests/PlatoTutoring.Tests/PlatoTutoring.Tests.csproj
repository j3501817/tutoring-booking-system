<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <GenerateRuntimeConfigurationFiles Condition="'$(Configuration)' == 'Release'">false</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PlatoTutoring.Web\PlatoTutoring.Web.csproj" />
  </ItemGroup>

  <Target Name="RemoveTestRuntimeConfigOnRelease" AfterTargets="Build;Publish" Condition="'$(Configuration)' == 'Release'">
    <Delete Files="$(OutDir)PlatoTutoring.Tests.runtimeconfig.json;$(PublishDir)PlatoTutoring.Tests.runtimeconfig.json;$(OutDir)testhost.runtimeconfig.json;$(PublishDir)testhost.runtimeconfig.json" />
  </Target>

</Project>
