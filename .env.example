# ==============================================================================
# 柏拉圖補習班－網頁輔導預約與堂數管理系統 (Web App 正式環境變數範本)
# 請於 Azure Web App / Docker / 雲端主機的「環境變數 (Environment Variables)」設定
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 資料庫連線設定（二選一：設定完整連線字串 或 設定獨立主機/帳密）
# 支援資料庫引擎：SqlServer (Azure SQL / MSSQL)、PostgreSql、Sqlite
# ------------------------------------------------------------------------------
# [方式 A] 直接給完整連線字串：
DB_PROVIDER=SqlServer
DB_CONNECTION_STRING=Server=tcp:your-sql-server.database.windows.net,1433;Initial Catalog=plato_tutoring;User ID=your_db_user;Password=your_db_password;Encrypt=True;TrustServerCertificate=False;

# [方式 B] 或拆開設定資料庫主機與帳號密碼（系統會自動組裝連線字串）：
# DB_PROVIDER=SqlServer
# DB_HOST=your-sql-server.database.windows.net
# DB_PORT=1433
# DB_NAME=plato_tutoring
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password

# ------------------------------------------------------------------------------
# 2. Blob 雲端物件儲存設定（儲存老師上傳之匯款憑證，90 天自動清理）
# 支援兩種驗證方式：設定 BLOB_ACCOUNT_NAME + BLOB_ACCOUNT_KEY 或 BLOB_CONNECTION_STRING
# ------------------------------------------------------------------------------
BLOB_ACCOUNT_NAME=your_storage_account_name
BLOB_ACCOUNT_KEY=your_storage_account_key_or_password
BLOB_CONTAINER_NAME=plato-remittance-attachments
# 若使用自建相容端點 (如 Azurite 或自訂 Blob Endpoint) 可選填：
# BLOB_ENDPOINT_URL=https://your_storage_account_name.blob.core.windows.net

# 或直接提供 Azure Storage Connection String：
# BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# ------------------------------------------------------------------------------
# 3. 系統初始管理員與預設帳號密碼（首次建表初始化時自動套用並以 PBKDF2 加密）
# ------------------------------------------------------------------------------
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ChangeMeToStrongPassword123!
INITIAL_DEFAULT_PASSWORD=demo123