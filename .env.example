# .env.example
# 請將此檔案複製並重新命名為 .env，然後填入您的金鑰與設定

# ==========================================
# 🔔 Agentic 專案通知策略設定 (Notification Strategy)
# 支援的選項：LINE / MPA / BOTH / NONE
# 預設設為 NONE 以防誤觸發，完成金鑰設定後再改為 LINE / MPA / BOTH
# ==========================================
NOTIFICATION_STRATEGY="NONE"

# [選項 A] LINE Messaging API 設定 (若策略包含 LINE 則必填)
LINE_CHANNEL_ACCESS_TOKEN="您的_Channel_Access_Token"
LINE_USER_ID="您的_User_ID"

# [選項 B] Microsoft Power Automate Webhook 設定 (若策略包含 MPA 則必填)
# 訊息採用 Adaptive Card 格式發送，請確認 Flow 的 HTTP 觸發器可接收 JSON
MPA_WEBHOOK_URL="您的_Power_Automate_Webhook_URL"