# ==============================================================================
# 柏拉圖補習班－網頁輔導預約與堂數管理系統 (Web App 環境變數設定)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Azure SQL 資料庫環境變數
# ------------------------------------------------------------------------------
AZURE_SQL_CONNECTION_STRING=Server=tcp:your-sql-server.database.windows.net,1433;Initial Catalog=your_db_name;User ID=your_db_user;Password=your_db_password;Encrypt=True;TrustServerCertificate=False;
AZURE_SQL_CLIENT_ORIGIN=https://your-webapp.azurewebsites.net

# ------------------------------------------------------------------------------
# 2. Azure Blob Storage 雲端物件儲存環境變數
# ------------------------------------------------------------------------------
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_storage_account_name;AccountKey=your_storage_account_key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=plato-remittance-attachments

# ------------------------------------------------------------------------------
# 3. 系統初始管理員與預設帳號密碼（選填）
# ------------------------------------------------------------------------------
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ChangeMeToStrongPassword123!
INITIAL_DEFAULT_PASSWORD=demo123